{
	"luci-app-byway": {
		"description": "Управление туннелем byway",
		"read": {
			"file": {
				"/etc/byway/domains.lst": [
					"read"
				],
				"/etc/byway/subnets.lst": [
					"read"
				],
				"/etc/byway/routes/*": [
					"read"
				]
			},
			"uci": [
				"byway"
			],
			"ubus": {
				"file": [
					"read",
					"stat"
				]
			}
		},
		"write": {
			"file": {
				"/etc/byway/domains.lst": [
					"write"
				],
				"/etc/byway/subnets.lst": [
					"write"
				],
				"/etc/byway/routes/*": [
					"read",
					"write"
				],
				"/etc/byway/health.log": [
					"read"
				],
				"/var/run/byway-import.txt": [
					"write"
				],
				"/tmp/run/byway-import.txt": [
					"write"
				],
				"/usr/local/bin/byway version": [
					"exec"
				],
				"/usr/local/bin/byway status": [
					"exec"
				],
				"/usr/local/bin/byway status --short": [
					"exec"
				],
				"/usr/local/bin/byway health": [
					"exec"
				],
				"/usr/local/bin/byway doctor": [
					"exec"
				],
				"/usr/local/bin/byway report": [
					"exec"
				],
				"/usr/local/bin/byway top 25": [
					"exec"
				],
				"/usr/local/bin/byway lang ru": [
					"exec"
				],
				"/usr/local/bin/byway lang en": [
					"exec"
				],
				"/usr/local/bin/byway job update --check": [
					"exec"
				],
				"/usr/local/bin/byway job engine --check": [
					"exec"
				],
				"/usr/local/bin/byway job gen": [
					"exec"
				],
				"/usr/local/bin/byway job presets": [
					"exec"
				],
				"/usr/local/bin/byway job restart": [
					"exec"
				],
				"/usr/local/bin/byway job reload": [
					"exec"
				],
				"/usr/local/bin/byway job import --no-key": [
					"exec"
				],
				"/usr/local/bin/byway job update": [
					"exec"
				],
				"/usr/local/bin/byway job engine tested": [
					"exec"
				],
				"/usr/local/bin/byway job log": [
					"exec"
				],
				"/usr/local/bin/byway export": [
					"exec"
				],
				"/usr/local/bin/byway clear log": [
					"exec"
				],
				"/usr/local/bin/byway clear stat": [
					"exec"
				],
				"/usr/local/bin/byway job probe": [
					"exec"
				],
				"/usr/local/bin/byway job probe *": [
					"exec"
				],
				"/usr/local/bin/byway job engine [0-9]*": [
					"exec"
				]
			},
			"uci": [
				"byway"
			],
			"ubus": {
				"file": [
					"write",
					"remove",
					"exec"
				]
			}
		}
	},
	"luci-app-byway-key": {
		"description": "Ключ VPN и подписка byway",
		"read": {
			"uci": [
				"byway_key"
			]
		},
		"write": {
			"file": {
				"/usr/local/bin/byway export --with-key": [
					"exec"
				],
				"/usr/local/bin/byway sub": [
					"exec"
				],
				"/var/run/byway-sub.url": [
					"write"
				],
				"/tmp/run/byway-sub.url": [
					"write"
				],
				"/usr/local/bin/byway job import": [
					"exec"
				]
			},
			"ubus": {
				"file": [
					"exec"
				]
			},
			"uci": [
				"byway_key"
			]
		}
	}
}
