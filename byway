        # не ходит по делу.
        printf '      { "type": "field", "domain": [\n'
        [ -s "$_djf" ] && { cat "$_djf"; printf ',\n'; }
        printf '          "full:%s"\n' "$PROBE_DOMAIN"
        printf '        ], %s },\n' "$PROXY_TARGET"
