    # флеша здесь 43.7 МБ; и на неудачной сборке он ОСТАВАЛСЯ лежать -- сто
    # с лишним килобайт с uuid внутри и правами 0644, до следующей удачи.
    TMP=/tmp/byway-config.new.json
    # Сначала УДАЛИТЬ, потом создать под umask 077. Прежнее `: > "$TMP"` не
    # создавало файл заново, а усекало существующий -- со всеми его правами и
    # со всеми уже открытыми чужими дескрипторами. Имя предсказуемо, /tmp общий,
    # а внутри лежит uuid ключа: сосед по роутеру (dnsmasq -- самая вероятная
    # точка входа снаружи) мог заранее создать этот файл с правами 0666, держать
    # его открытым и читать конфиг при каждой сборке. chmod после записи от
    # этого не спасает -- дескриптор уже открыт.
    rm -f "$TMP" 2>/dev/null || true
    (umask 077; : > "$TMP") 2>/dev/null || true
