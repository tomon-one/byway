#!/bin/sh
#
# byway — раздельное туннелирование на OpenWrt, ядро Xray.
#
# Заменяет podkop. Отличия по сути, а не по вкусу:
#   - ядро Xray, а не sing-box: Reality, XHTTP, VLESS Encryption доступны,
#     и занимает вдвое меньше места: бинарник 26.7.28 -- 33.8 МБ файлом и
#     около 18 МБ на флеше (ubifs сжимает), тогда как sing-box со всей
#     обвязкой podkop просил 38.7 МБ и в свободные 14.9 МБ не влезал;
#   - списки лежат ФАЙЛАМИ, а не инлайном в UCI. У podkop правка списка не
#     действовала, пока её отдельной командой не затолкаешь в UCI, и на этом
#     спотыкались весь август 2026;
#   - ничего лишнего: community-листы, YACD и Clash API не нужны и не делаются.
#
# Устройство то же, что у podkop, потому что оно верное:
#   dnsmasq -> DNS-вход Xray -> FakeDNS отдаёт адрес из пула для доменов
#   из списка -> nft метит трафик на этот пул в tproxy -> вход Xray со
#   сниффингом достаёт из своей таблицы исходный домен -> правило маршрутизации
#   отправляет его в аутбаунд ноды. Всё прочее идёт напрямую.
#
# Команды:
#   byway gen        собрать конфиг Xray из UCI и списков, проверить синтаксис
#   byway show       показать, что получилось (без секретов)
#   byway status     что сейчас поднято
#   byway check URL  разобрать ссылку и проверить конфиг ядром, без соединений
#
# Виды ссылок: vless, trojan, socks, hysteria2 (hy2), wireguard (wg) --
# разбираются сразу; vmess и ss лежат внутри base64 (декодер -- пакет либо
# awk). tuic и hysteria первой версии в
# Xray-core нет (сверено по исходникам 26.9.30).
#   byway presets    скачать подключённые готовые списки и проверить их
#   byway sub URL    скачать подписку и напечатать ключи из неё построчно
#   byway health     короткая проверка для панели: служба, VPN, трафик, DNS
#   byway export     выгрузить настройки и списки одним текстом
#   byway import Ф   принять их обратно; --no-key у обеих команд бережёт ключ
#   byway watch      записать состояние, если оно изменилось (зовётся из cron)
#   byway stat       учесть новые соединения в журнале (зовётся из cron)
#   byway top [N]    чем реально пользуются, по убыванию частоты
#
# Транспорты, проверенные на Xray 26.7.28 прогоном run -test (2026-09-07):
#   работают: ws, tcp/raw (в т.ч. headerType=http), grpc, httpupgrade, xhttp,
#             kcp — но БЕЗ полей header и seed, они удалены отдельно от него
#   УДАЛЕНЫ:  h2/http, quic — Xray отвергает и называет замену (xhttp)
#   защита:   tls (alpn, fp, pcs, vcn), reality (spiderX, mldsa65Verify), none
#   с 26.3.27: hysteria (hysteria2://, obfs salamander -- с 26.7.11)
#   шифрование VLESS mlkem768x25519plus -- с 25.8.29
#   allowInsecure ядро отвергает с 26.3.27 (с 2026-06-01) -- нужен pcs
#   byway probe URL  проверить ноду в изоляции, боевую конфигурацию не трогая
#   byway nft        показать правила nft, ничего не применяя
#   byway plumb on   поднять обвязку: nft, маршрут, dnsmasq
#   byway plumb off  снять её и вернуть dnsmasq провайдеру
#
# Службой управляет /etc/init.d/byway -- он и зовёт plumb.

set -e

# Версия. Нужна не для красоты: без неё сообщение «у меня не работает»
# бесполезно -- непонятно, о какой сборке речь. Меняется вручную при выпуске.
#
# Имя ВСЕГДА английское и одно на все языки -- это опознавательный знак
# сборки, а не украшение. Переводить его нельзя: жалоба «на Волоке не
# работает» и жалоба «on Portage it doesn't work» пришли бы про одно и то
# же, и понять это можно было бы только зная таблицу переводов наизусть.
#
# Тема -- дороги в обход непроходимого, что byway и означает. Русские
# соответствия ниже приведены для понимания смысла, наружу не выходят.
#
#   0.0  Desire Path   стихийная тропа: протоптана раньше, чем проложена дорога
#   0.1  Portage       волок: лодки тащат посуху между реками
#   0.2  Causeway      гать: настил через болото
#   0.3  Ford          брод: река там, где нет моста
#   0.4  Ice Road      зимник: дорога по льду, пока держит
#   0.5  Trail         тропа
#   0.6  Bypass        околица: путь вокруг села
#   0.7  Country Lane  просёлок
#   0.8  Old Road      шлях
# 0.0.0 была обкаткой выкладки: тег, установка одной строкой, обновление.
# Обкатка прошла 2026-09-06 -- четыре пути GitHub, зеркало, установка на
# 25.12.5 и 22.03.7, отказ на 21.02.7, -- и номер стал 0.1.0.
#
# ⚠️ Переход 0.0.0 -> 0.1.0 ночной сторож НЕ делает: автообновление ходит
# только внутри минорной версии (см. cmd_watch). Первой настоящей проверкой
# этого пути будет 0.1.0 -> 0.1.1, а не переход с нуля -- прежняя редакция
# этой шапки утверждала обратное и была неверна.
#
# 0.1.1 -- находки первого дня на чужих архитектурах: MIPS без сопроцессора
# и 32 строки, шедшие мимо словаря.
# 0.1.2 -- ни один ключ на kcp не собирался: byway всегда писал в конфиг
# поле header, а свежие Xray его удалили. Причину при этом называл неверную.
# 0.1.3 -- «нода» убрана из того, что видит человек: в README всюду «ключ», а
# про машину на той стороне -- «сервер». Заодно вернулся перевод абзаца в
# панели, разошедшийся с кодом.
# 0.1.4 -- третий аудит: служба не вставала в автозапуск (после перезагрузки
# роутер оставался без туннеля, и doctor молчал), приём выгрузки из панели не
# работал вовсе, кнопка загрузки списков не применяла скачанное, route_down
# сносил чужой маршрут в общей таблице.
# ⚠️ Номер поднимается В МОМЕНТ ВЫПУСКА, а не по ходу работы. Ветка main идёт
# впереди тега намеренно, и номер на ней -- это номер ПОСЛЕДНЕГО выпуска, а не
# будущего: иначе README ссылается на тег, которого ещё нет, и установка одной
# строкой отвечает 404. Так и вышло 2026-09-07 с 0.1.5.
#
# Здесь и ниже лежит остаток третьего аудита -- стенды, панель, соседи по
# роутеру, документация. Разбор: docs/audit/2026-09-07.md. Выйдет со следующим
# выпуском, когда правок накопится на него.
BYWAY_NUM="0.2.4"
BYWAY_NAME="Causeway"
BYWAY_VERSION="$BYWAY_NUM ($BYWAY_NAME)"
# Откуда берутся обновления. Отдельной строкой, а не внутри адреса: тот,
# кто держит свою сборку, меняет одно место.
BYWAY_REPO="tomon-one/byway"
# Версия Xray-core, на которой byway прогнан целиком: её ставит `byway engine
# tested`. Та же в install.sh (XRAY_TESTED) -- править парой.
XRAY_TESTED=26.9.30

CONF=/etc/config/byway
LISTS=/etc/byway
OUT=$LISTS/config.json
# Журнал ОБРАЩЕНИЙ движка -- свой файл, а не системный журнал. Почему так,
# подробно в cmd_gen; коротко: строк там под сотню в минуту, и в кольце на
# 256 КБ они вытесняют всё остальное за двадцать минут. Живёт в памяти,
# усекается в cmd_stat после учёта и сторожем в cmd_watch по размеру.
ACCESS=/tmp/byway-access.log
# Путь к бинарнику берётся из UCI, а не жёстко. Смысл: держать рядом
# пакетную версию из фида и свежую вручную, переключаться одной командой
# и так же одной откатываться. Без этого установка версии вне фида
# означала бы замену без пути назад на самом устройстве.
# || true обязательно: uci -q get на несуществующей опции возвращает
# единицу, и под set -e присваивание из неуспешной подстановки убивает
# скрипт МОЛЧА. Та же ловушка, что в probe. Третий раз за день.
# Путь к движку приходит из UCI, а UCI правит панель -- значит это значение
# ПРИШЛО СНАРУЖИ, и исполнять по нему что попало от root нельзя. Ровно так
# устроены CVE в luci-app-travelmate и luci-app-samba4: бэкенд читает путь из
# конфигурации и запускает его. Валидатор в панели защитой не считается --
# в travelmate обошли именно его.
#
# Проверяем в таком порядке: сначала каталог (писать в системные может только
# root, так что это и есть граница доверия), потом исполняемость, и лишь потом
# спрашиваем версию -- запускать неизвестный файл ради проверки нельзя.
xray_ok() {
    case "$1" in
        /usr/bin/*|/usr/sbin/*|/usr/local/bin/*|/bin/*|/sbin/*) ;;
        *) return 1 ;;
    esac
    case "$1" in *..*) return 1 ;; esac
    [ -f "$1" ] && [ -x "$1" ] || return 1
    # Имя xray* и заголовок ELF -- до запуска: `xray_bin=/sbin/reboot` с
    # панели иначе перезагружал роутер на каждом вызове byway (cron -- раз в
    # пять минут, при загрузке -- по кругу).
    case "${1##*/}" in xray*) ;; *) return 1 ;; esac
    head -c 4 "$1" 2>/dev/null | grep -q ELF || return 1
    "$1" version 2>/dev/null | head -1 | grep -qi "^Xray " || return 1
}

XRAY=$(uci -q get byway.main.xray_bin || true)
# Жалоба ОТЛОЖЕНА намеренно. Путь проверяется раньше, чем заведён словарь
# (BW_LANG и _t ниже по файлу), и напечатанное здесь осталось бы русским на
# любой системе. Печатаем сразу после словаря -- это единственное место, где
# порядок загрузки мешает переводу.
XRAY_REJECTED=""
if [ -n "$XRAY" ] && ! xray_ok "$XRAY"; then
    XRAY_REJECTED=$XRAY
    XRAY=""
fi

# Версия движка числом: 26.7.28 -> 260728, 1.8.3 -> 10803. Схема нумерации у
# Xray сменилась (1.8.x, затем 24.9.30 по дате), и сравнение через эти числа
# переживает смену: 10824 меньше 240930, как и должно быть.
#
# ⚠️ Зачем это вообще понадобилось. Конфиг byway пишется под нынешний Xray, а
# на OpenWrt 22.03 -- нижней заявленной границе -- из фида приезжает 1.8.3.
# Незнакомое поле Go отбрасывает МОЛЧА при разборе JSON, и `run -test` такой
# конфиг ПРИНИМАЕТ: то есть проверка чужим разборщиком, на которую мы
# опираемся везде, здесь не срабатывает по построению. Наружу это выглядит
# так: конфиг верен, служба поднята, health говорит «vpn ok / tunnel fail», а
# причина -- потерянное поле. Найдено прогоном 6 четвёртого аудита.
#
# Ответ кэшируется: build_stream зовётся на каждое направление, а каждый вызов
# -- это запуск бинарника.
#
# ⚠️ Звать её ТОЛЬКО как команду (`xray_ver_num >/dev/null`), а число читать
# из XRAYVER. Через подстановку `$(xray_ver_num)` кэша нет вовсе: подстановка
# выполняется в подоболочке, присваивание XRAYVER до вызывающего не доходит, и
# бинарник запускался на каждый собранный аутбаунд. Найдено четвёртым аудитом,
# заход 3.
XRAYVER=""
xray_ver_num() {
    if [ -z "$XRAYVER" ]; then
        _xvs=$("$XRAY" version 2>/dev/null | head -1 | awk '{print $2}' | tr -cd '0-9.')
        if [ -n "$_xvs" ]; then
            XRAYVER=$(printf '%s' "$_xvs" | awk -F. '{ printf "%d", ($1 * 10000) + ($2 * 100) + $3 }')
        fi
        # Не определилась -- считаем современной. Отказ разбора версии не
        # повод писать старую форму тому, кто её уже не понимает.
        [ -n "$XRAYVER" ] || XRAYVER=999999
    fi
    printf '%s' "$XRAYVER"
}
[ -n "$XRAY" ] || XRAY=$(command -v xray || echo /usr/bin/xray)

# Отказы движка, которые сами по себе человеку ничего не скажут: текст ошибки
# Xray печатается как есть, а здесь -- что с ним делать. $1 -- вывод run -test.
#
# vless и trojan без TLS к публичному адресу Xray-core отвергает с 26.7.11
# (validateOutboundTransportSecurity в infra/conf/xray.go; исключение --
# частный адрес). byway поверх этого ничего не решает: ключ такой, какой
# выдал сервер, и чинится он только на сервере.
xray_hint() {
    case "$1" in
      *"without TLS"*)
        warn "  Xray-core с 26.7.11 не пускает vless и trojan без TLS или reality к публичному адресу"
        warn "  нужен ключ с security=tls или reality; без шифрования транспорта — только сервер в частной сети" ;;
      *'"allowInsecure"'*)
        warn "  Xray-core с 26.3.27 не даёт отключать проверку сертификата сервера (allowInsecure)"
        warn "  нужен отпечаток сертификата в ключе (pcs= или pinSHA256=) либо настоящий сертификат на сервере" ;;
    esac
}

# Каким менеджером доставлять недостающее. apk с OpenWrt 25.12, opkg на 24.10
# на прежних. Печатать «apk add» человеку с opkg -- значит дать команду, которая
# ответит «not found» и ничего не объяснит; а именно на старых прошивках чаще
# всего чего-то и не хватает.
PKG_FIX="apk update && apk add"
if ! command -v apk >/dev/null 2>&1 && command -v opkg >/dev/null 2>&1; then
    PKG_FIX="opkg update && opkg install"
fi

_say()  { printf '\033[1;32m[*]\033[0m %s\n' "$1"; }
_warn() { printf '\033[1;33m[!]\033[0m %s\n' "$1"; }
die_raw() { printf '\033[1;31m[x]\033[0m %s\n' "$1"; exit 1; }

# Пары «строка» и «строка с подстановками». Вторые нужны потому, что
# переводится ФОРМАТ, а не готовый текст: подставленный адрес или число в
# словаре не найдётся никогда, и сообщение молча осталось бы русским.
say()   { _say  "$(_t "$1")"; }
warn()  { _warn "$(_t "$1")"; }
die()   { die_raw "$(_t "$1")"; }
sayf()  { _fmt=$(_t "$1"); shift; _say    "$(printf "$_fmt" "$@")"; }
warnf() { _fmt=$(_t "$1"); shift; _warn   "$(printf "$_fmt" "$@")"; }
dief()  { _fmt=$(_t "$1"); shift; die_raw "$(printf "$_fmt" "$@")"; }

# Журнал системы читает тот же человек, что и экран, а на английской системе
# он оставался русским целиком: строки logger шли мимо словаря вовсе, и их не
# ловила даже сверка -- она смотрела только на печать. Обёртки заведены ровно
# затем же, зачем say/warn/die: чтобы перевод нельзя было забыть, а не чтобы
# его помнить.
logt()  { logger -t byway "$(_t "$1")"; }
logf()  { _lfm=$(_t "$1"); shift; logger -t byway "$(printf "$_lfm" "$@")"; }

# || true здесь СТРУКТУРНОЕ, а не перестраховка. uci -q get на незаданной
# опции возвращает единицу, и любое присваивание вида VAR=$(u что-то) под
# set -e убивает скрипт МОЛЧА -- без строки, без кода, без следа.
#
# За 2026-09-03 эта ловушка сработала четырежды: в probe, в чтении xray_bin,
# в mux_concurrency и в порте локального прокси. Каждый раз чинилась на
# месте, и каждый раз возвращалась со следующей новой опцией -- потому что
# ломается не вызов, а функция. Здесь она закрыта для всех сразу.
u() { uci -q get "byway.main.$1" || true; }

# Пул подставных адресов настраивается в панели, а проверки «выдался ли fakeip»
# искали зашитое 198.18/198.19 в четырёх местах. Смена пула превращала роутер в
# «Xray работает, обвязки нет», причём с сообщением, которое обвиняет Xray.
# Как отличить СВОЁ правило ip rule от чужого. Пара «fwmark + таблица 100 +
# local default dev lo» -- канонический рецепт tproxy: её занимают openclash,
# passwall, nikki и все руководства по xray. Прежняя проверка искала одну
# подстроку «lookup 100», поэтому на роутере с таким соседом byway решал
# «правило уже стоит», своего не добавлял -- и пакеты метились, но в локальную
# таблицу не уходили. Снаружи это выглядело здоровым туннелем: nft-счётчик
# растёт, `status` печатает «ip rule есть», наружу ноль.
#
# Конец строки закреплён отдельно: «lookup 100» совпадает и с «lookup 1000».
# Метка на СОБСТВЕННЫХ исходящих сокетах движка. Не то же, что метка обвязки.
#
# Зачем. Цепочка заворота стоит в `output` и ловит ПО АДРЕСУ НАЗНАЧЕНИЯ, а
# движок живёт на том же хосте -- его исходящие идут через ту же цепочку.
# Когда он не смог восстановить домен по подставному адресу и выпустил пакет
# наружу как есть, правило заворачивало пакет обратно в него же. Витки шли без
# ограничителя и за минуты съедали предел открытых файлов: движок переставал
# принимать ВООБЩЕ ВСЁ, включая перехват, и туннеля лишался весь дом.
#
# Исключать адресом или портом нельзя -- у петли они те же самые. Только
# меткой. Ровно это предписывает и официальный туториал XTLS по tproxy:
# `sockopt.mark` на аутбаундах плюс правило «помеченное -- пропустить».
#
# ⚠️ БИТ ДРУГОЙ, чем у метки обвязки, и это обязательное условие. `ip rule`
# ставится с маской (`fwmark 0x100000/0x100000`), то есть ловит ЛЮБУЮ метку, у
# которой этот бит поднят. Совпади биты -- и собственные пакеты движка ушли бы
# в таблицу 100 на петлю, то есть ровно туда, откуда их и уводят.
self_mark() {
    # Образец ЗАЯКОРЕН. Прежний `case` смотрел только на начало: «0x» плюс
    # один hex-знак и дальше что угодно, «цифра и дальше что угодно». Строка
    # уходила в текст правил как есть, nft падал на первой же строке, а в
    # конфиг движка тем временем шло другое число -- метка в ядре и метка на
    # сокетах расходились в любом случае. Найдено четвёртым аудитом, заход 3.
    _sm=$(nft_val self_mark "$(u self_mark)" \
          '^(0[xX][0-9a-fA-F]{1,8}|[0-9]{1,10})$' 0x400000)
    if [ "$(( _sm ))" -gt 4294967295 ] || [ "$(( _sm ))" -le 0 ]; then
        warnf "self_mark %s не влезает в 32 бита -- взято умолчание 0x400000" "$_sm"
        _sm=0x400000
    fi
    # ⚠️ Бит ДРУГОЙ, чем у mark. Условие названо обязательным в разборе выше,
    # и до сих пор его не проверял НИКТО. Совпади биты -- собственные пакеты
    # движка ловятся правилом `ip rule fwmark M/M` и уходят в таблицу 100 на
    # петлю: соединение к серверу не выходит с роутера вовсе, туннель мёртв
    # целиком. При этом все проверки зелёные -- таблица, правило, маршрут,
    # резолвер, проба plumb on, -- потому что проба отвечает от локального
    # fakedns и наружу не ходит. Найдено четвёртым аудитом, заход 3.
    _smk=$(nft_val mark "$(u mark)" '^0x[0-9a-fA-F]{1,8}$' 0x100000)
    if [ "$(( _sm & _smk ))" -ne 0 ]; then
        _sm=0x400000
        [ "$(( _sm & _smk ))" -ne 0 ] && _sm=0x800000
        warnf "self_mark пересекается битами с mark %s -- взято %s" "$_smk" "$_sm"
    fi
    printf '%s' "$_sm"
}

# То же число десятичным: в конфиг движка оно идёт как ЧИСЛО JSON, а не строка.
#
# Через арифметику оболочки, а не `printf '%d' 0x…`. У printf при негодном
# числе `||` не ЗАМЕНЯЕТ вывод, а дописывает к нему: частичный разбор уже
# напечатан, и запасной путь давал склейку «14194304». Разбирать тут нечего --
# строка выше уже проверена образцом.
self_mark_dec() {
    printf '%d' "$(( $(self_mark) ))"
}

# Имя хоста из строки резолвера -- или пусто, если там адрес.
#
# Нужно ровно для одного вопроса: надо ли этому резолверу bootstrap. Адрес
# разрешать не надо, имя -- надо, и без него движок уйдёт спрашивать имя
# сервера у самого этого сервера.
dns_host() {   # 1 -- строка вида https://ЧТО-ТО/путь
    _dh=${1#*://}; _dh=${_dh%%/*}
    # Литерал IPv6 пишется в скобках -- это адрес, а не имя.
    case "$_dh" in \[*) return 0 ;; esac
    _dh=${_dh%%:*}
    case "$_dh" in
      # Что угодно, кроме цифр и точек, -- имя.
      *[!0-9.]*) printf '%s' "$_dh" ;;
    esac
}

rule_re() {
    _rm=$(u mark); _rm=${_rm:-0x100000}
    printf 'fwmark %s(/%s)?[[:space:]]+lookup %s([[:space:]]|$)' "$_rm" "$_rm" "$RT_TABLE"
}

# Адрес своего DNS-входа. Отдельной функцией, потому что умолчание тут
# забывали: из десяти мест четыре читали `u dns_listen` голым, и на снятой
# опции (поле в панели можно просто очистить -- ни default, ни rmempty=false у
# него нет) выходило вот что. Сторож вечно видел «127.0.0.42» != «» и каждые
# пять минут заново поднимал обвязку: пересборка nft, перезапуск dnsmasq и
# строка «(healed)» во флеш, 288 записей в сутки. А в dns_down образец возврата
# превращался в два подряд идущих пробела, не совпадал ни с чем никогда, и
# резолвер провайдеру не возвращался вовсе.
dns_addr() {
    _da=$(u dns_listen)
    printf '%s' "${_da:-127.0.0.42}"
}

# Годится ли пул по СМЫСЛУ, а не только по форме. Форму проверяет образец, и
# он пропускает `10.96.0.0/12` -- а такой пул мёртв целиком и молча:
#   1) цепочка nft отсекает приватное ПЕРВЫМ правилом (`ip daddr @privnets
#      return`), то есть пул съедается раньше правила tproxy;
#   2) правило блокировки в самом конфиге Xray перечисляет 10.0.0.0/8;
#   3) dnsmasq со штатным rebind_protection вырезает приватные адреса из
#      ответов.
# При этом проба в plumb on спрашивает движок НАПРЯМУЮ, минуя dnsmasq и nft, и
# проходит с первого раза -- обвязка объявляется поднятой, а список не работает
# ни у кого в доме.
#
# Ширину тоже проверяем: пул уже списка означает, что выдача пойдёт по кругу и
# соединение, где нюхать нечего (SMTP, IMAP, ssh, игровой протокол), уйдёт на
# ЧУЖОЙ домен. Это не отказ, а неверный результат -- худший из возможных.
pool_sane() {   # 1 -- пул вида a.b.c.d/len
    _pn=${1%/*}; _pl=${1#*/}
    case "$_pl" in ''|*[!0-9]*) warn "пул $1 без длины маски -- взято умолчание" >&2; return 1 ;; esac
    if [ "$_pl" -lt 8 ] || [ "$_pl" -gt 30 ]; then
        warnf "пул %s: маска /%s не годится -- взято умолчание" "$1" "$_pl" >&2
        return 1
    fi
    # Пересечение с приватным и зарезервированным. Сравниваем по первому
    # октету, а для 172 и 169 -- по второму: этого хватает, потому что все
    # опасные диапазоны выровнены по октету.
    _o1=${_pn%%.*}; _r=${_pn#*.}; _o2=${_r%%.*}
    # 240.0.0.0/4 -- это ВЕСЬ диапазон 240-255, а не два его края. Прежняя
    # редакция перечисляла 224/4 всеми шестнадцатью значениями, а 240/4 -- двумя
    # (240 и 255), и пул вида 250.0.0.0/15 проходил проверку, хотя правило
    # `ip daddr @privnets return` съедает его раньше tproxy. Список тот же, что
    # в RESERVED и в правиле блокировки движка: держать его в трёх местах
    # руками -- значит однажды разойтись, что и вышло.
    case "$_o1" in
      0|10|127|22[4-9]|23[0-9]|24[0-9]|25[0-5])
        warnf "пул %s лежит в приватном или зарезервированном -- он мёртв: цепочка nft отсекает такие адреса первым же правилом" "$1" >&2
        return 1 ;;
      172) [ "$_o2" -ge 16 ] && [ "$_o2" -le 31 ] && {
             warnf "пул %s лежит в 172.16/12 -- он мёртв" "$1" >&2; return 1; } ;;
      192) [ "$_o2" = 168 ] && {
             warnf "пул %s лежит в 192.168/16 -- он мёртв" "$1" >&2; return 1; } ;;
      169) [ "$_o2" = 254 ] && {
             warnf "пул %s лежит в 169.254/16 -- он мёртв" "$1" >&2; return 1; } ;;
      100) [ "$_o2" -ge 64 ] && [ "$_o2" -le 127 ] && {
             warnf "пул %s лежит в 100.64/10 -- он мёртв" "$1" >&2; return 1; } ;;
    esac
    return 0
}

# Сколько адресов в пуле. Нужно и для poolSize движка, и чтобы сказать вслух,
# когда список длиннее пула.
pool_size() {   # 1 -- пул вида a.b.c.d/len
    _psl=${1#*/}
    case "$_psl" in ''|*[!0-9]*) _psl=15 ;; esac
    awk -v l="$_psl" 'BEGIN {
        if (l < 1 || l > 32) l = 15
        n = 2 ^ (32 - l) - 2
        # Нижнего ограничителя ЗДЕСЬ нет. Стоял `if (n < 16) n = 16`, и на
        # масках /29 и /30 объявленная ёмкость оказывалась вчетверо больше
        # настоящей: единственная защита от «пул уже списка» сравнивается
        # именно с этим числом и на таких масках не срабатывала никогда, а
        # пары «домен-адрес» вытеснялись из кэша на 16 мест над пулом из 4.
        # Соединение к домену A уходило на хост домена B, без единой ошибки
        # где бы то ни было. Найдено четвёртым аудитом, заход 3.
        if (n < 1) n = 1
        printf "%d", n
    }'
}

fakeip_re() {
    _fp=$(u fakeip_pool); _fp=${_fp:-198.18.0.0/15}
    case "$_fp" in
        198.18.0.0/15) printf '198\.1[89]\.' ;;
        *) printf '%s\.' "$(echo "$_fp" | cut -d. -f1-2 | sed 's/\./\\./g')" ;;
    esac
}

# ── язык вывода ────────────────────────────────────────────────────────────
#
# Строки в коде остаются русскими и служат ключом; перевод лежит отдельным
# файлом «ключ<TAB>перевод», по файлу на язык. Смысл именно в этом: язык
# добавляется без правки кода, а пропущенная строка выводится по-русски, а не
# пустой -- половина перевода лучше пустого экрана.
#
# gettext не годится дважды: его нет в busybox, а панели LuCI он потребовал бы
# отдельного пакета перевода. Ради одного скрипта и четырёх вкладок это
# дороже пользы.
BW_LANG=$(u lang); BW_LANG=${BW_LANG:-ru}
LANGDIR=$LISTS/lang
TAB=$(printf '\t')

_t() {
    [ "$BW_LANG" = "ru" ] && { printf '%s' "$1"; return 0; }
    _tf=$LANGDIR/$BW_LANG.tsv
    [ -f "$_tf" ] || { printf '%s' "$1"; return 0; }
    # index(...)==1, а не grep -F: тот ищет подстроку ГДЕ УГОДНО в строке, и
    # короткий ключ находил себя внутри длинного («пусто» внутри «пока пусто»).
    # Ключ обязан стоять в начале и упираться в табуляцию. Заодно один процесс
    # вместо трёх, а _t зовётся на каждую печатаемую строку.
    #
    # Ключ передаётся окружением, а не через -v: awk разворачивает в -v
    # управляющие последовательности, и ключи с переводом строки не нашлись бы.
    _tv=$(BW_K="$1$TAB" awk 'index($0, ENVIRON["BW_K"]) == 1 { print substr($0, length(ENVIRON["BW_K"]) + 1); exit }' "$_tf" 2>/dev/null || true)
    printf '%s' "${_tv:-$1}"
}

# Отложенная жалоба из начала файла: теперь словарь есть.
if [ -n "$XRAY_REJECTED" ]; then
    warnf "путь к движку отклонён: %s" "$XRAY_REJECTED" >&2
fi

# Порт: только число, только из диапазона. Зовётся и на порт ноды из ссылки,
# и на входы из настроек -- всё это идёт в JSON без кавычек.
port_ok() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Час, в который автообновление имеет право сработать. По МЕСТНОМУ времени
# роутера: сравнивается с `date +%H`.
#
# Одна функция на сторожа и на проверку окружения намеренно. Сторож решает
# по часу, а doctor этот час называет человеку -- разъехавшись, они сказали
# бы одно, а сделали другое, и поймать это можно было бы только ночью.
#
# Двузначная форма обязательна: `date +%H` печатает 04, а не 4, и сравнение
# строк с однозначным числом не совпало бы НИ РАЗУ -- автообновление молча
# не сработало бы никогда.
au_hour() {
    _auhv=$(u auto_update_hour)
    [ -n "$_auhv" ] || _auhv=04
    case "$_auhv" in
      [0-9]|[01][0-9]|2[0-3]) ;;
      *) warnf "час автообновления «%s» не годится, взято 04" "$_auhv" >&2
         _auhv=04 ;;
    esac
    [ "${#_auhv}" = 2 ] || _auhv="0$_auhv"
    printf '%s' "$_auhv"
}

# Порт входа, на который заворачивается СОБСТВЕННЫЙ трафик роутера.
#
# Считается одной функцией для конфига движка и для правил nft намеренно.
# Разъехавшиеся половины тут уже ломали туннель: описка в порте давала
# движку негодный конфиг, а nft молча брал умолчание, и правила вели в
# никуда. Пустой ответ означает «не заворачивать» -- выключено настройкой
# либо порт столкнулся с другим входом byway.
#
# Сравнение именно с «1», а не «не 0»: отсутствующий ключ должен
# значить «не заворачивать». На конфиге старше этой настройки ключа нет
# вовсе, и прежняя форма включала заворот сама собой -- то есть ровно
# тем, кто об этой возможности ничего не знает. Про саму петлю --
# в комментарии к ключу в поставочной конфигурации.
redir_port() {
    [ "$(u router_via_vpn)" = "1" ] || return 0
    _rdp=$(val_or redirect_port "$(u redirect_port)" '^[0-9]{1,5}$' 1604 "$1")
    port_ok "$_rdp" || _rdp=1604
    _rdt=$(u tproxy_port); _rdt=${_rdt:-1602}
    _rdl=$(u local_proxy_port); _rdl=${_rdl:-1603}
    if [ "$_rdp" = "$_rdt" ] || [ "$_rdp" = "$_rdl" ]; then
        # >&2 обязательно: warnf печатает в stdout, а ответ этой функции
        # забирают подстановкой -- жалоба уехала бы в конфиг движка ровно
        # туда, где ждут номер порта. Так и вышло на стенде 2026-09-07.
        warnf "порт %s занят другим входом byway — свой трафик роутер в туннель не пошлёт" "$_rdp" >&2
        return 0
    fi
    printf '%s' "$_rdp"
}

# ── разбор ссылки ──────────────────────────────────────────────────────────
#
# Поддержаны vless, trojan, socks, hysteria2, wireguard (разбираются из адреса
# напрямую) и vmess, ss (внутри base64, нужен декодер). Значения нигде не печатаются: только в конфиг.
#
# Имена полей JSON сверены прогоном `xray run -test` на самом бинарнике, а не
# взяты из памяти: Xray молча глотает неизвестные поля, поэтому проверялось
# от обратного -- заведомо неверное значение обязано давать ошибку именно про
# это поле. Имена параметров В ССЫЛКЕ бинарник не знает, это соглашение
# клиентов; ошибка в них не тихая, её поймает предупреждение ниже.
KNOWN_PARAMS="type security sni fp alpn path host headerType seed serviceName mode authority pbk sid spx pqv flow encryption quicSecurity key extra allowInsecure insecure pinSHA256 pcs vcn"
# Свои параметры у hysteria2 и wireguard -- отдельно: у чужой схемы они
# пропадали бы молча, а предупреждение про незнакомый параметр -- ровно
# для того, чтобы человек узнал, что из ссылки не перенесено.
KNOWN_HY="obfs obfs-password mport"
KNOWN_WG="publickey privatekey secretkey pk peer_pk presharedkey pre_shared_key psk address local_address mtu reserved keepalive"

# base64 в busybox этого роутера нет. Есть пакет coreutils-base64 -- берём
# его, нет -- раскодирует awk (b64d ниже): прежде без пакета vmess и ss
# отвергались, а установщик задавал о нём отдельный вопрос.
# ⚠️ Наличие файла ничего не значит: `/bin/base64` бывает ссылкой на busybox,
# в котором апплета base64 нет, и `command -v` про это не знает. Судим
# запуском. Поймано приёмкой владельца 2026-09-07.
have_base64() { printf x | base64 >/dev/null 2>&1; }
CANARY=/use-application-dns.net/

b64d() {
    if have_base64; then
        # SIP002 -- то, чем ss:// выдают почти все клиенты, -- кодируется
        # алфавитом base64url и БЕЗ добивки «=». Такой вход `base64 -d` не
        # принимает: отвечает отказом, а `2>/dev/null` его прячет. На выходе
        # пусто, код возврата ненулевой, и под set -e разбор обычного ключа
        # Shadowsocks убивал byway молча. Добиваем сами и переводим алфавит.
        _b6=$(printf '%s' "$1" | tr -d '\n\r' | tr '_-' '/+')
        case $(( ${#_b6} % 4 )) in
            2) _b6="$_b6==" ;;
            3) _b6="$_b6=" ;;
        esac
        printf '%s' "$_b6" | base64 -d 2>/dev/null || true
    else
        # Тот же результат байт в байт (сверено с base64 -d на busybox и gawk,
        # с UTF-8). LC_ALL=C: иначе gawk печатает %c > 127 многобайтно.
        # Алфавит url (-_) и отсутствие «=» awk переносит сам.
        printf '%s' "$1" | tr '_-' '/+' | LC_ALL=C awk '
          BEGIN { a = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
                  for (i = 0; i < 64; i++) v[substr(a, i + 1, 1)] = i }
          { s = s $0 }
          END { b = 0; n = 0
                for (i = 1; i <= length(s); i++) {
                  c = substr(s, i, 1)
                  if (c == "=") break
                  if (!(c in v)) continue
                  b = b * 64 + v[c]; n += 6
                  if (n >= 8) { n -= 8; o = int(b / 2 ^ n); b -= o * 2 ^ n; printf "%c", o }
                } }'
    fi
}

# Раскодировать проценты. Работает и с эмодзи: они те же байты UTF-8.
pctd() {
    printf '%b' "$(printf '%s' "$1" | sed 's/%/\\x/g')" 2>/dev/null || printf '%s' "$1"
}

# Значения из ссылки уходят в конфиг ВНУТРЬ строк JSON и не экранируются.
# Кавычка в любом из них закрывает строку и дописывает в объект свои поля.
# Проверено сборкой: ссылка с
#   sni=a.com%22%2C%22allowInsecure%22%3Atrue%2C%22x%22%3A%22
# давала валидный конфиг с ВЫКЛЮЧЕННОЙ проверкой сертификата ноды -- то есть
# TLS до узла переставал быть аутентифицированным, и посредник читал туннель.
# `xray run -test` такой конфиг принимал, а предупреждение про allowInsecure
# не печаталось: параметра-то в ссылке не было, поле пришло внутри значения.
# Тем же приёмом дописываются любые поля в vnext, servers и streamSettings.
#
# Ключи приходят из подписок и чужих каналов, панель предлагает загрузить их
# списком одной кнопкой -- то есть источник заведомо не доверенный.
#
# Проверяем ПОСЛЕ разбора, а не внутри qp: die в подстановке $(...) убивает
# только подоболочку, и разбор поехал бы дальше с пустым полем.
node_json_ok() {
    for _pv in "адрес=$N_HOST" "id=$N_UUID" "пароль=$N_PASS" "user=$N_USER" \
               "method=$N_METHOD" "type=$N_TYPE" "security=$N_SEC" \
               "sni=${N_SNI:-}" "fp=$N_FP" "path=$N_PATH" "host=${N_WSHOST:-}" \
               "pbk=$N_PBK" "sid=$N_SID" "flow=$N_FLOW" "mode=$N_MODE" \
               "alpn=$N_ALPN" "headerType=$N_HDR" "seed=$N_SEED" \
               "serviceName=$N_SVC" "authority=$N_AUTH" "spx=$N_SPX" \
               "pqv=$N_PQV" "quicSecurity=$N_QSEC" "key=$N_QKEY" \
               "encryption=$N_ENC" "obfs-password=$N_OBFSPW" "pcs=$N_PIN" \
               "vcn=$N_VCN" "obfs=$N_OBFS" "privatekey=$N_WGKEY" \
               "publickey=$N_WGPUB" "presharedkey=$N_WGPSK" "address=$N_WGADDR" \
               "mtu=$N_WGMTU" "reserved=$N_WGRES" "keepalive=$N_WGKA"; do
        case "$_pv" in
          # Управляющие знаки -- ПЕРВЫМИ. qpr раскодирует %0A в настоящий
          # перевод строки, а проверки формы идут построчным grep: «1,2,3»
          # в первой строке проходило образец, хвост со второй строки уходил
          # в конфиг. У reserved (он без кавычек) так дописывался второй
          # peers со своим сервером, и ядро брало последний (находка аудита
          # 2026-10-01). В значениях ключа управляющим знакам места нет.
          *[[:cntrl:]]*)
            dief "в поле «%s» ссылки управляющий знак (перевод строки, табуляция): такая ссылка подменяет поля конфига" "${_pv%%=*}" ;;
          *'"'*|*'\'*)
            dief "в поле «%s» ссылки кавычка или обратная косая: значения уходят в конфиг как есть, и такая ссылка подменяет его поля" "${_pv%%=*}" ;;
        esac
    done
}

# Ровно один объект JSON и ничего вокруг него.
#
# Нужна одному параметру -- extra. Он единственный подставляется в конфиг
# ОБЪЕКТОМ, а не строкой в кавычках, поэтому через node_json_ok не проходит:
# скобки и кавычки в нём законны. Прежде рядом стоял комментарий, уверявший,
# что дописать в чужой объект через extra нельзя -- значение вкладывается
# внутрь xhttpSettings, а битый JSON ловит `xray run -test`. Оба довода
# неверны, и это находка второго аудита.
#
# Как ломалось. qp_json раскодирует %7B %7D %22 %5B %5D, то есть весь алфавит
# JSON. Значение вида
#     {} } }, "settings": { "vnext": [ { "address": "evil…" } ] }, "IGN": { "x": {
# закрывает xhttpSettings и streamSettings, возвращается на уровень аутбаунда,
# дописывает свой settings с чужим адресом и свой streamSettings без tls, а
# настоящий хвост шаблона утягивает в игнорируемый ключ. Скобки при этом
# сбалансированы, `run -test` доволен, а Xray на повторяющихся ключах берёт
# ПОСЛЕДНИЙ. Весь заворачиваемый трафик уходил бы на чужой сервер без TLS, и
# ни check, ни gen, ни status этого не показали бы: они печатают адрес и
# защиту из ССЫЛКИ, а не из собранного конфига.
#
# Проверяем форму: первый непробельный знак -- «{», глубина не возвращается к
# нулю раньше конца, после закрывающей верхнего уровня пусто. Кавычки внутри
# строк учитываются, иначе честное значение с «}» внутри строки отвергалось бы
# зря. Несовпадение вида скобок не различаем: для защиты хватает того, что
# значение не выходит наружу своего объекта, а негодный JSON отвергнет ядро.
json_obj_ok() {
    printf '%s' "$1" | awk '
        { s = s $0 "\n" }
        END {
            d = 0; instr = 0; esc = 0; started = 0; closed = 0; ok = 1
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (instr) {
                    if (esc) esc = 0
                    else if (c == "\\") esc = 1
                    else if (c == "\"") instr = 0
                    continue
                }
                if (c == " " || c == "\t" || c == "\n" || c == "\r") continue
                if (!started) { if (c != "{") { ok = 0; break }
                                started = 1; d = 1; continue }
                if (closed) { ok = 0; break }
                if (c == "\"") { instr = 1; continue }
                if (c == "{" || c == "[") { d++; continue }
                if (c == "}" || c == "]") { d--
                                            if (d < 0) { ok = 0; break }
                                            if (d == 0) closed = 1
                                            continue }
            }
            if (instr || !started || !closed || d != 0) ok = 0
            print ok
        }'
}

parse_node() {
    # Режим «свой конфиг»: человек вставил готовый кусок JSON от Xray, и
    # разбирать нечего. Так подключаются к тому, чего byway не понимает по
    # ссылке, -- ровно для этого у podkop был Outbound Config.
    N_RAW=""
    if [ -z "${1:-}" ] && [ "$(u conn_mode)" = "outbound" ]; then
        N_RAW=$(u outbound_json)
        [ -n "$N_RAW" ] || die "выбран свой конфиг, но он пуст"
        N_PROTO=raw
        N_LABEL=$(u conn_label)
        [ -n "$N_LABEL" ] || N_LABEL=$(_t 'свой конфиг')
        N_TYPE="-"; N_SEC="-"; N_HOST="-"; N_PORT=0
        return 0
    fi

    URL=${1:-$(u node_url)}
    [ -n "$URL" ] || die "ключ не задан"

    N_SCHEME=${URL%%://*}
    case "$N_SCHEME" in
      vless|trojan|socks|vmess|ss|hysteria2|hy2|wireguard|wg) ;;
      # Сверено по исходникам 26.9.30: исходящего tuic в Xray-core нет, а
      # hysteria там только второй версии (Build отвергает version != 2).
      hysteria|tuic)
        dief "%s в Xray-core нет; из похожего есть hysteria2" "$N_SCHEME" ;;
      *) dief "неизвестный вид ссылки: %s" "$N_SCHEME" ;;
    esac

    _rest=${URL#*://}

    # Метка после решётки -- человеческое имя, обычно с флагом страны.
    # Секретом не является: идентификатор лежит до собаки, а не здесь.
    N_LABEL=""
    case "$URL" in *#*) N_LABEL=$(pctd "${URL#*#}") ;; esac
    _rest=${_rest%%#*}

    # Значения по умолчанию, общие для всех схем
    N_UUID=""; N_PASS=""; N_USER=""; N_METHOD=""; N_AID=0
    N_TYPE=tcp; N_SEC=none; N_PATH=/; N_FP=chrome
    N_PBK=""; N_SID=""; N_FLOW=""; N_MODE=""; N_ALPN=""
    N_HDR=""; N_SEED=""; N_SVC=""; N_AUTH=""; N_SPX=""; N_PQV=""
    N_ENC=""; N_QSEC=""; N_QKEY=""; N_EXTRA=""; N_INSEC=""
    N_OBFS=""; N_OBFSPW=""; N_PIN=""; N_VCN=""
    N_WGKEY=""; N_WGPUB=""; N_WGPSK=""; N_WGADDR=""; N_WGMTU=""; N_WGRES=""; N_WGKA=""
    _query=""

    if [ "$N_SCHEME" = "vmess" ]; then
        # vmess://<base64 от JSON>. Поля: add, port, id, aid, net, type,
        # host, path, tls, sni, scy.
        _j=$(b64d "$_rest")
        [ -n "$_j" ] || die "vmess-ссылка не раскодировалась"
        jf() { printf '%s' "$_j" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" | head -1; }
        N_HOST=$(jf add); N_PORT=$(jf port); N_UUID=$(jf id)
        case "$N_HOST" in *:*) dief "адрес IPv6 в ключе не поддержан: %s — нужен IPv4 или имя" "$N_HOST" ;; esac
        # aid уходит в конфиг без кавычек -- только число.
        N_AID=$(jf aid); [ -n "$N_AID" ] || N_AID=0
        case "$N_AID" in *[!0-9]*) dief "aid у vmess — не число: %s" "$N_AID" ;; esac
        N_TYPE=$(jf net); [ -n "$N_TYPE" ] || N_TYPE=tcp
        N_PATH=$(jf path); [ -n "$N_PATH" ] || N_PATH=/
        N_WSHOST=$(jf host)
        # type=none клиенты пишут почти всегда; как заголовок mkcp его
        # свежее ядро отвергает, значит «нет заголовка» -- пусто.
        N_HDR=$(jf type); [ "$N_HDR" = none ] && N_HDR=""
        [ "$(jf tls)" = "tls" ] && N_SEC=tls
        N_SNI=$(jf sni); [ -n "$N_SNI" ] || N_SNI=${N_WSHOST:-$N_HOST}
        [ -n "$N_WSHOST" ] || N_WSHOST=$N_HOST
        # scy -- шифрование самого vmess, alpn и fp -- для TLS. Прежде все
        # три пропадали: security писался auto всегда.
        N_METHOD=$(jf scy)
        case "$N_METHOD" in
          ""|auto|aes-128-gcm|chacha20-poly1305|none|zero) ;;
          *) dief "scy=%s у vmess Xray-core не знает: есть auto, aes-128-gcm, chacha20-poly1305, none, zero" "$N_METHOD" ;;
        esac
        # alpn -- через запятую внутри строки, а jf режет на запятой.
        N_ALPN=$(printf '%s' "$_j" | sed -n 's/.*"alpn"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
        _v=$(jf fp); [ -n "$_v" ] && N_FP=$_v
        # У vmess имя сервиса gRPC лежит в path (так пишут v2rayN и прочие),
        # а не в отдельном поле: без этого serviceName уходил пустым.
        # Сырой path, а не N_PATH: пустой там заменён на «/».
        if [ "$N_TYPE" = "grpc" ]; then N_SVC=$(jf path); fi
        N_PROTO=vmess
        node_json_ok
        # Проверка порта СВОЯ у каждой ветки, а не одна общая в конце. Общая
        # стояла после этого return и до неё доходили только vless, trojan и
        # socks: у vmess и ss порт не проверялся ничем, а он единственное
        # поле, которое уходит в конфиг БЕЗ кавычек ("port": $N_PORT).
        port_ok "$N_PORT" || dief "порт в ссылке недопустим: %s" "$N_PORT"
        return 0
    fi

    if [ "$N_SCHEME" = "ss" ]; then
        # Два вида: ss://<base64 от method:password>@host:port  и
        # ss://method:password@host:port. Второй встречается реже.
        # Старая форма: в base64 вся ссылка, ss://BASE64(метод:пароль@адрес:порт).
        case "$_rest" in *@*) ;; *)
            _rest=$(b64d "${_rest%%\?*}")
            case "$_rest" in *@*) ;; *) die "ss-ссылка не разобралась" ;; esac ;;
        esac
        # По ПОСЛЕДНЕЙ собаке: в открытом пароле она законна.
        _ui=${_rest%@*}
        _hp=${_rest##*@}
        # Плагин (obfs-local, v2ray-plugin) Xray-core не запускает -- без
        # него сервер с плагином не ответит. Говорим вслух, а не теряем.
        case "$_hp" in *plugin=*)
            warn "plugin у shadowsocks не переносится: Xray-core плагины не запускает, сервер с плагином не ответит" ;;
        esac
        _hp=${_hp%%\?*}
        _hp=${_hp%%/*}
        case "$_ui" in
          *:*) _plain=$(pctd "$_ui") ;;
          *)   _plain=$(b64d "$_ui") ;;
        esac
        case "$_hp" in \[*) dief "адрес IPv6 в ключе не поддержан: %s — нужен IPv4 или имя" "$_hp" ;; esac
        N_METHOD=${_plain%%:*}
        N_PASS=${_plain#*:}
        N_HOST=${_hp%%:*}
        N_PORT=${_hp##*:}
        N_PROTO=shadowsocks
        # Откат, как в общей ветке ниже: без порта в ссылке ${_hp##*:} отдаёт
        # сам адрес, и в конфиг уходило "port": example.com -- негодный JSON.
        if [ "$N_PORT" = "$N_HOST" ]; then N_PORT=443; fi
        node_json_ok
        port_ok "$N_PORT" || dief "порт в ссылке недопустим: %s" "$N_PORT"
        return 0
    fi

    # vless, trojan, socks, hysteria2, wireguard -- всё в адресе открытым текстом
    _ui=${_rest%%@*}
    _rest2=${_rest#*@}
    # Без собаки части до неё нет вовсе: wg-ссылки Hiddify и hysteria2 без
    # пароля несут всё в параметрах. Прежде весь хвост уходил в _ui.
    case "$_rest" in *@*) ;; *) _ui="" ;; esac
    _hostport=${_rest2%%\?*}
    # hysteria2 пишет «host:port/?sni=…» -- косая перед вопросом не порт.
    _hostport=${_hostport%%/*}
    # [2001:db8::1]:443 резался по первому двоеточию в «[2001».
    case "$_hostport" in \[*) dief "адрес IPv6 в ключе не поддержан: %s — нужен IPv4 или имя" "$_hostport" ;; esac
    N_HOST=${_hostport%%:*}
    N_PORT=${_hostport##*:}
    if [ "$N_PORT" = "$N_HOST" ]; then N_PORT=443; fi
    _query=${_rest2#*\?}
    if [ "$_query" = "$_rest2" ]; then _query=""; fi

    case "$N_SCHEME" in
      vless)  N_UUID=$_ui; N_PROTO=vless ;;
      trojan) N_PASS=$(pctd "$_ui"); N_PROTO=trojan ;;
      hysteria2|hy2) N_PASS=$(pctd "$_ui"); N_PROTO=hysteria ;;
      wireguard|wg)  N_WGKEY=$(pctd "$_ui"); N_PROTO=wireguard ;;
      socks)  _su=$(pctd "$_ui")
              # Часть клиентов кладёт «логин:пароль» в base64 (вида
              # socks://dXNlcjpwYXNz@…). Без расшифровки логин и пароль
              # пропадали молча, и сервер с паролем отвечал отказом.
              case "$_su" in
                *:*|"") ;;
                *) _sd=$(b64d "$_su")
                   case "$_sd" in *:*) _su=$_sd ;; esac ;;
              esac
              N_USER=${_su%%:*}; N_PASS=${_su#*:}
              [ "$N_USER" = "$_su" ] && { N_USER=""; N_PASS=""; }
              N_PROTO=socks ;;
    esac

    # Раскодируем ЦЕЛИКОМ: кавычку, косую и управляющие знаки после разбора
    # отсекает node_json_ok. Прежде раскодировалась лишь часть (%2F %3A …), и
    # путь v2rayN `%2F%3Fed%3D2048` уходил как `/%3Fed=2048`: Xray ищет ed в
    # строке запроса пути, не находил, и сервер отвечал 404.
    qp() { pctd "$(printf '%s' "$_query" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1)"; }
    # Скромное раскодирование -- только для extra (ниже): там скобки и кавычки
    # законны, и раскодированный объект проверяет json_obj_ok.
    qp_part() {
        printf '%s' "$_query" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1 |
          sed 's/%2F/\//g; s/%3A/:/g; s/%2C/,/g; s/%20/ /g;
               s/%3D/=/g; s/%26/\&/g'
    }
    # extra -- единственный параметр, который ПО ЗАМЫСЛУ приходит объектом
    # JSON и подставляется объектом, а не строкой. Скобки и кавычки в нём
    # законны, поэтому раскодируется он отдельно -- и поэтому же он ОБЯЗАН
    # пройти json_obj_ok ниже. Прежде здесь стояло, что дописать в чужой
    # объект через extra нельзя; это было неверно, разбор см. у json_obj_ok.
    qp_json() {
        qp_part "$1" | sed 's/%7B/{/g; s/%7D/}/g; s/%22/"/g; s/%5B/[/g; s/%5D/]/g'
    }
    _v=$(qp type);     [ -n "$_v" ] && N_TYPE=$_v
    # trojan без TLS не бывает: протокол и задуман поверх него, и клиенты
    # параметр security у trojan часто опускают. Прежде пустой security
    # давал none, и свежее ядро такой ключ к публичному адресу отвергало.
    [ "$N_PROTO" = "trojan" ] && N_SEC=tls
    _v=$(qp security); [ -n "$_v" ] && N_SEC=$_v
    N_SNI=$(qp sni);   [ -n "$N_SNI" ] || N_SNI=$N_HOST
    _v=$(qp fp);       [ -n "$_v" ] && N_FP=$_v
    _v=$(qp path);     [ -n "$_v" ] && N_PATH=$_v
    N_WSHOST=$(qp host); [ -n "$N_WSHOST" ] || N_WSHOST=$N_HOST
    N_PBK=$(qp pbk); N_SID=$(qp sid); N_FLOW=$(qp flow)
    # flow у trojan в конфиг не пишется, а mux при нём отключался.
    if [ "$N_PROTO" = trojan ] && [ -n "$N_FLOW" ]; then
        warnf "flow=%s у trojan Xray-core не поддерживает — пропущен" "$N_FLOW"; N_FLOW=""
    fi
    N_MODE=$(qp mode); N_ALPN=$(qp alpn); N_HDR=$(qp headerType)
    N_SEED=$(qp seed); N_SVC=$(qp serviceName); N_AUTH=$(qp authority)
    N_SPX=$(qp spx); N_PQV=$(qp pqv); N_ENC=$(qp encryption)
    N_QSEC=$(qp quicSecurity); N_QKEY=$(qp key); N_EXTRA=$(qp_json extra)
    N_INSEC=$(qp allowInsecure); [ -n "$N_INSEC" ] || N_INSEC=$(qp insecure)
    # pcs -- имя у v2rayN, pinSHA256 -- у hysteria2; значение одно и то же.
    N_PIN=$(qp pcs); [ -n "$N_PIN" ] || N_PIN=$(qp pinSHA256)
    N_VCN=$(qp vcn)
    # Параметр без раскодирования: пароли и ключи бывают с любыми знаками,
    # qp раскодирует лишь часть. Полный pctd здесь безопасен, потому что
    # результат проходит node_json_ok (кавычка, косая) и образцы ниже.
    qpr() { pctd "$(printf '%s' "$_query" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1)"; }
    # Первый непустой из нескольких имён одного параметра: клиенты зовут
    # одно и то же по-разному (v2rayN -- publickey, Hiddify -- peer_pk).
    qpa() { for _qn in "$@"; do _qv=$(qpr "$_qn"); [ -n "$_qv" ] && { printf '%s' "$_qv"; return 0; }; done; return 0; }

    if [ "$N_PROTO" = "hysteria" ]; then
        # Транспорт у hysteria свой, и он всегда под TLS -- без tlsSettings
        # ядро не соединяется вовсе («tls config is nil» в dialer.go).
        N_TYPE=hysteria; N_SEC=tls
        # Отпечаток браузера (uTLS) относится к TLS поверх TCP; у QUIC его нет.
        N_FP=""
        [ -n "$N_ALPN" ] || N_ALPN=h3
        # Смена портов у hysteria2 пишется и параметром mport, и прямо в
        # порту: «host:443,20000-30000» или «host:20000-30000». Ни то, ни
        # другое Xray-core через hysteriaSettings не берёт; соединение идёт
        # на первый порт, сервер слушает и его.
        case "$N_PORT" in
          *[,-]*) warnf "диапазон портов в ключе не переносится: соединение идёт на порт %s" "${N_PORT%%[,-]*}"
                  N_PORT=${N_PORT%%[,-]*} ;;
        esac
        _v=$(qp obfs)
        case "$_v" in
          ""|none) ;;
          salamander) N_OBFS=salamander; N_OBFSPW=$(qpr obfs-password)
                      [ -n "$N_OBFSPW" ] || die "obfs=salamander без obfs-password: пароль обфускации обязателен" ;;
          *) dief "obfs=%s у hysteria2 не поддержан: в Xray-core есть только salamander" "$_v" ;;
        esac
        if [ -n "$(qp mport)" ]; then
            warn "mport (смена портов) не переносится: соединение идёт на основной порт из ключа"
        fi
    fi

    if [ "$N_PROTO" = "wireguard" ]; then
        N_TYPE=wireguard; N_SEC=none
        [ -n "$N_WGKEY" ] || N_WGKEY=$(qpa privatekey secretkey pk)
        N_WGPUB=$(qpa publickey peer_pk)
        N_WGPSK=$(qpa presharedkey pre_shared_key psk)
        N_WGADDR=$(qpa address local_address | tr -d ' ')
        N_WGMTU=$(qp mtu); N_WGRES=$(qpr reserved | tr -d ' '); N_WGKA=$(qp keepalive)
        # Ключи -- base64 на 32 байта либо hex; так их и принимает
        # ParseWireGuardKey. Образец строгий: значение уходит в конфиг.
        wgkey_ok() { printf '%s' "$1" | grep -Eq '^([A-Za-z0-9+/]{43}=|[0-9a-fA-F]{64})$'; }
        wgkey_ok "$N_WGKEY" || die "в ключе wireguard нет закрытого ключа либо он не той формы (base64 на 44 знака либо 64 шестнадцатеричных)"
        wgkey_ok "$N_WGPUB" || die "в ключе wireguard нет публичного ключа сервера (publickey) либо он не той формы"
        [ -z "$N_WGPSK" ] || wgkey_ok "$N_WGPSK" || die "presharedkey в ключе wireguard не той формы"
        # Без своего адреса в туннеле ядро подставит 10.0.0.1 -- сервер такого
        # клиента не узнает, и соединение молча не пойдёт.
        [ -n "$N_WGADDR" ] || die "в ключе wireguard нет address -- адреса этого клиента в туннеле"
        printf '%s' "$N_WGADDR" | grep -Eq '^[0-9a-fA-F.:]+(/[0-9]{1,3})?(,[0-9a-fA-F.:]+(/[0-9]{1,3})?)*$' ||
            dief "address в ключе wireguard не похож на список адресов: %s" "$N_WGADDR"
        [ -z "$N_WGMTU" ] || printf '%s' "$N_WGMTU" | grep -Eq '^[0-9]{3,4}$' ||
            dief "mtu в ключе wireguard -- не число: %s" "$N_WGMTU"
        [ -z "$N_WGRES" ] || printf '%s' "$N_WGRES" | grep -Eq '^[0-9]{1,3},[0-9]{1,3},[0-9]{1,3}$' ||
            dief "reserved в ключе wireguard -- не три числа через запятую: %s" "$N_WGRES"
        [ -z "$N_WGKA" ] || printf '%s' "$N_WGKA" | grep -Eq '^[0-9]{1,5}$' ||
            dief "keepalive в ключе wireguard -- не число: %s" "$N_WGKA"
    fi
    if [ -n "$N_PIN" ]; then
        printf '%s' "$N_PIN" | grep -Eq '^[0-9a-fA-F:,]+$' ||
            dief "отпечаток сертификата (pcs, pinSHA256) -- не шестнадцатеричный: %s" "$N_PIN"
    fi
    if [ -n "$N_VCN" ]; then
        printf '%s' "$N_VCN" | grep -Eq '^[A-Za-z0-9.,*-]+$' ||
            dief "имя для проверки сертификата (vcn) -- не имя хоста: %s" "$N_VCN"
    fi
    node_json_ok
    # extra идёт в конфиг объектом, минуя проверку на кавычку выше, поэтому
    # проверяется своей: один объект и ничего вокруг.
    if [ -n "$N_EXTRA" ] && [ "$(json_obj_ok "$N_EXTRA")" != "1" ]; then
        die "параметр extra в ссылке -- не один объект JSON: он подставляется в конфиг как есть, и такая ссылка переписывает соседние поля, включая адрес сервера и защиту"
    fi

    case "$N_PROTO" in
      hysteria)  _known="$KNOWN_PARAMS $KNOWN_HY" ;;
      wireguard) _known="$KNOWN_PARAMS $KNOWN_WG" ;;
      *)         _known=$KNOWN_PARAMS ;;
    esac
    for _pn in $(printf '%s' "$_query" | tr '&' '\n' | sed 's/=.*//' | grep . ); do
        case " $_known " in
          *" $_pn "*) ;;
          *) warnf "параметр ссылки «%s» byway в конфиг не переносит — стоит проверить, важен ли он" "$_pn" ;;
        esac
    done

    # Шифрование VLESS (постквантовое, mlkem768x25519plus) -- с Xray-core
    # 25.8.29. Значение идёт в конфиг строкой как есть; форму проверяем
    # образцом, разбор частей оставляем ядру -- его run -test отвергнет
    # негодное до подмены рабочего конфига.
    if [ -n "$N_ENC" ] && [ "$N_ENC" != "none" ]; then
        [ "$N_PROTO" = "vless" ] ||
            dief "encryption=%s бывает только у vless" "$N_ENC"
        printf '%s' "$N_ENC" | grep -Eq '^mlkem768x25519plus\.[A-Za-z0-9._+/=-]+$' ||
            dief "encryption=%s не поддержан: Xray-core знает только mlkem768x25519plus" "$N_ENC"
        xray_ver_num >/dev/null
        if [ "$XRAYVER" -lt 250829 ]; then
            dief "шифрование VLESS (encryption=mlkem768x25519plus) появилось в Xray-core 25.8.29, а стоит %s — обновить: byway engine tested" \
                 "$("$XRAY" version 2>/dev/null | head -1 | cut -d' ' -f2)"
        fi
    fi

    # Общая проверка на выходе: порт приходит и из адреса, и из base64-обёртки
    # vmess, а в JSON уходит числом без кавычек. Одна проверка на все пути.
    port_ok "$N_PORT" || dief "порт в ссылке недопустим: %s" "$N_PORT"
}

# Блок аутбаунда под свой протокол. Имена полей проверены на бинарнике.
build_outbound() {
    case "$N_PROTO" in
      vless)
        OUTBOUND="\"protocol\": \"vless\", \"settings\": { \"vnext\": [ { \"address\": \"$N_HOST\", \"port\": $N_PORT, \"users\": [ { \"id\": \"$N_UUID\", \"encryption\": \"${N_ENC:-none}\"$FLOWJ } ] } ] }" ;;
      hysteria)
        OUTBOUND="\"protocol\": \"hysteria\", \"settings\": { \"version\": 2, \"address\": \"$N_HOST\", \"port\": $N_PORT }" ;;
      wireguard)
        # address -- список через запятую, уже сверенный образцом в parse_node.
        _wa=$(printf '%s' "$N_WGADDR" | sed 's/,/", "/g')
        _wp="\"publicKey\": \"$N_WGPUB\", \"endpoint\": \"$N_HOST:$N_PORT\""
        if [ -n "$N_WGPSK" ]; then _wp="$_wp, \"preSharedKey\": \"$N_WGPSK\""; fi
        if [ -n "$N_WGKA" ]; then _wp="$_wp, \"keepAlive\": $N_WGKA"; fi
        _wo=""
        if [ -n "$N_WGMTU" ]; then _wo=", \"mtu\": $N_WGMTU"; fi
        if [ -n "$N_WGRES" ]; then _wo="$_wo, \"reserved\": [ $N_WGRES ]"; fi
        # noKernelTun: wireguard внутри процесса движка, а не интерфейсом
        # ядра. С 24.11.30 Xray по умолчанию поднимает wg0 через /dev/net/tun:
        # без kmod-tun конфиг отвергается («CreateTUN failed», стенд
        # 25.12.5 2026-10-01), а с ним в системе появляется интерфейс, о
        # котором маршрутизация роутера ничего не знает. Старшие версии поле
        # не знают и пропускают -- у них wireguard и так внутри процесса.
        OUTBOUND="\"protocol\": \"wireguard\", \"settings\": { \"noKernelTun\": true, \"secretKey\": \"$N_WGKEY\", \"address\": [ \"$_wa\" ], \"peers\": [ { $_wp } ]$_wo }" ;;
      vmess)
        OUTBOUND="\"protocol\": \"vmess\", \"settings\": { \"vnext\": [ { \"address\": \"$N_HOST\", \"port\": $N_PORT, \"users\": [ { \"id\": \"$N_UUID\", \"alterId\": ${N_AID:-0}, \"security\": \"${N_METHOD:-auto}\" } ] } ] }" ;;
      trojan)
        OUTBOUND="\"protocol\": \"trojan\", \"settings\": { \"servers\": [ { \"address\": \"$N_HOST\", \"port\": $N_PORT, \"password\": \"$N_PASS\" } ] }" ;;
      shadowsocks)
        OUTBOUND="\"protocol\": \"shadowsocks\", \"settings\": { \"servers\": [ { \"address\": \"$N_HOST\", \"port\": $N_PORT, \"method\": \"$N_METHOD\", \"password\": \"$N_PASS\" } ] }" ;;
      socks)
        _su=""
        if [ -n "$N_USER" ]; then
          _su=", \"users\": [ { \"user\": \"$N_USER\", \"pass\": \"$N_PASS\" } ]"
        fi
        OUTBOUND="\"protocol\": \"socks\", \"settings\": { \"servers\": [ { \"address\": \"$N_HOST\", \"port\": $N_PORT$_su } ] }" ;;
      *) dief "протокол %s не собран" "$N_PROTO" ;;
    esac
}

# ── список -> JSON-массив строк ────────────────────────────────────────────
# Пропускаем пустое, // и #. Префикс задаётся вторым аргументом:
# "domain:" для доменов, пусто для подсетей.
# Строка списка попадает внутрь JSON-строки конфига. Списки приходят не только
# от хозяина роутера: пресеты качаются с чужих серверов, файл выгрузки может
# прислать кто угодно. Значит запись может быть подобрана так, чтобы закрыть
# кавычку и дописать своё правило маршрутизации -- и тогда трафик, который
# человек считает завёрнутым, пойдёт напрямую, а по спискам этого не видно.
#
# Защита одна, но строгая: пропускаем только буквы, цифры, точку, дефис,
# двоеточие, косую и подчёркивание, длиной до 253 знаков. Экранирования сверху
# нет намеренно -- этот набор не содержит ни кавычки, ни обратной косой, то
# есть выйти за пределы JSON-строки нечем. Экранирование тут было и оказалось
# хуже: busybox awk не принял регулярку с обратной косой, и сборка ломалась
# на ровном месте.
#
# Отброшенное складывается в файл и называется вслух: молча выкинуть половину
# чужого списка значит оставить человека гадать, почему домен не работает.
BADLIST=/tmp/byway-bad-entries

# Имя -> адрес IPv4. Второй аргумент -- резолвер, которого спросить вместо
# системного.
#
# sed отрезает шапку с адресом самого резолвера: там тоже стоит «Address», и
# она идёт первой -- без этого в конфиг попадало 127.0.0.1:53.
a_of() {   # $1 -- имя, $2 -- резолвер или пусто
    nslookup "$1" ${2:+"$2"} 2>/dev/null | sed -n '/^Name:/,$p' |
      awk '/^Address/ {print $NF}' |
      grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -1
}

list_to_json() {
    awk -v pfx="$2" -v bad="$BADLIST" '
      { sub(/\r$/, "") }
      /^[[:space:]]*$/          { next }
      /^[[:space:]]*(\/\/|#)/   { next }
      { gsub(/^[[:space:]]+|[[:space:]]+$/, "")
        if (!length($0)) next
        if (length($0) > 253)              { print $0 >> bad; next }
        # Форма проверяется по тому, ЧЕМ будет запись, а не одним общим
        # набором знаков. Прежний набор [A-Za-z0-9._:/-] пропускал и
        # «/d8d/s.com», и «full:example.com»: byway приписывает свой префикс
        # domain:, такая запись становилась «domain:full:example.com», ни с
        # чем не совпадала никогда и лежала в списке как живая. Молча
        # мёртвая запись хуже отвергнутой -- отвергнутые byway называет
        # вслух при сборке.
        #
        # Интервалы {2,} не используются намеренно: в awk старых сборок
        # busybox их может не быть, а [A-Za-z][A-Za-z]+ выражает то же.
        if (pfx ~ /^domain:/) {
            v = $0
            # geosite: и ext: не принимаются, и это не лень. Обе требуют
            # файла данных -- geosite.dat либо своего списка, -- которого
            # byway не поставляет, а Xray без указанного файла не стартует
            # вовсе. Человек получил бы «byway перестал собирать конфиг»
            # вместо строки про одну негодную запись.
            if (v ~ /^(geosite|ext):/)     { print $0 >> bad; next }
            pre = ""
            if (v ~ /^(domain|full|keyword|regexp):/) {
                pre = substr(v, 1, index(v, ":"))
                v = substr(v, index(v, ":") + 1)
                if (!length(v))            { print $0 >> bad; next }
            }
            if (pre == "regexp:") {
                # Единственная форма, где обратная косая и кавычка законны по
                # смыслу. Значит их не отвергают, а экранируют по правилам
                # JSON -- иначе кавычка закрыла бы строку и дописала свои
                # поля в конфиг, ровно как это делал extra.
                #
                # По знаку, а не gsub: в строке замены у gsub обратная косая
                # имеет своё значение, и «удвоить косую» пишется там четырьмя
                # уровнями экранирования, которые никто потом не прочтёт.
                esc = ""
                for (k = 1; k <= length(v); k++) {
                    ch = substr(v, k, 1)
                    if (ch == "\\" || ch == "\"") esc = esc "\\"
                    esc = esc ch
                }
                v = esc
            } else if (pre == "keyword:") {
                if (v !~ /^[A-Za-z0-9._-]+$/) { print $0 >> bad; next }
            } else {
                # domain:, full: и запись без префикса -- обычный домен.
                if (v !~ /^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$/ ||
                    v !~ /\.[A-Za-z][A-Za-z]+$/ ||
                    v ~ /\.\./)            { print $0 >> bad; next }
                if (pre == "") pre = pfx
            }
            if (n++) printf ",\n"
            printf "        \"%s%s\"", pre, v
            next
        } else {
            # Подсети. Та же форма, что у set_elements для nft, включая
            # проверку чисел: расходиться им нельзя, иначе запись уходит в
            # конфиг движка и не уходит в правила ядра. Одной регулярки мало
            # -- она пропускает и 999.1.2.3, и /33.
            ok = 1
            if ($0 ~ /:/) {
                # IPv6. Строгую форму проверяет set_elements6 -- она решает,
                # что уйдёт в ядро; здесь хватает грубой, потому что дальше
                # строку разбирает сам Xray. Без этой ветки годная подсеть
                # IPv6 уходила в список отброшенных И не попадала в правило
                # маршрутизации вовсе: перехваченный по ней трафик движок
                # отдавал наружу напрямую, то есть обещание «подсети в
                # туннель» для v6 не выполнялось молча.
                if ($0 !~ /^[0-9a-fA-F:]+(\/[0-9]{1,3})?$/) { print $0 >> bad; next }
            } else {
                if ($0 !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(\/[0-9]+)?$/) ok = 0
                else {
                    np = split($0, oc, /[.\/]/)
                    for (i = 1; i <= 4; i++) if (oc[i] + 0 > 255) ok = 0
                    if (np == 5 && oc[5] + 0 > 32) ok = 0
                }
                if (!ok)                   { print $0 >> bad; next }
            }
        }
        if (n++) printf ",\n"
        printf "        \"%s%s\"", pfx, $0 }
      END { if (!n) printf "" }
    ' "$1"
}

# grep -c на нулевом счёте печатает 0 И возвращает единицу. Прежняя редакция
# страховалась через `|| echo 0` и на пустом списке печатала ДВА нуля подряд;
# всё, что сравнивало результат с числом, об это спотыкалось.
count_list() {
    [ -f "$1" ] || { echo 0; return 0; }
    awk '{ gsub(/^[[:space:]]+|[[:space:]\r]+$/, "")
           if ($0 == "") next
           if (substr($0, 1, 1) == "#") next
           if (substr($0, 1, 2) == "//") next
           n++ } END { print n + 0 }' "$1"
}

# Собирает STREAM и SECURITY из разобранных полей. Зовётся и генератором,
# и проверкой ноды — чтобы проверялся ровно тот транспорт, что пойдёт в бой.
build_stream() {
    # При своём конфиге собирать нечего: он уже целиком написан человеком.
    if [ "$N_PROTO" = "raw" ]; then
        STREAM=""; SECURITY=""; FLOWJ=""; MUXJ=""
        OUTBOUND=""
        return 0
    fi
    case "$N_TYPE" in
      # host отдельным полем, а не внутри headers: Xray 26 на старую форму
      # ругается «deprecated, will be removed soon». Поведение то же.
      #
      # Но у 1.8.3 (это то, что лежит в фиде OpenWrt 22.03) поля host в
      # wsSettings НЕТ вовсе -- оно появилось к 1.8.24. Отброшенное молча, оно
      # оставляет в заголовке Host сам адрес соединения, и CDN отвечает
      # 404/1003: туннель не встаёт, а сказать об этом некому. Старую форму
      # нынешний движок принимает и сейчас, так что развилка честная.
      ws)  xray_ver_num >/dev/null
           if [ "$XRAYVER" -lt 10824 ]; then
             STREAM="\"network\": \"ws\", \"wsSettings\": { \"path\": \"$N_PATH\", \"headers\": { \"Host\": \"$N_WSHOST\" } }"
           else
             STREAM="\"network\": \"ws\", \"wsSettings\": { \"path\": \"$N_PATH\", \"host\": \"$N_WSHOST\" }"
           fi ;;

      # raw -- новое имя для tcp, бинарник принимает оба. headerType=http
      # включает обфускацию под обычный HTTP.
      tcp|raw)
           if [ "$N_HDR" = "http" ]; then
             STREAM="\"network\": \"tcp\", \"tcpSettings\": { \"header\": { \"type\": \"http\", \"request\": { \"path\": [ \"$N_PATH\" ], \"headers\": { \"Host\": [ \"$N_WSHOST\" ] } } } }"
           else
             STREAM="\"network\": \"tcp\""
           fi ;;

      kcp)
           # ⚠️ Удалён НЕ mKCP, а ДВА ЕГО ПОЛЯ. Проверено движком 26.7.28
           # запуском `run -test`, а не чтением: `"network": "kcp"` он
           # принимает молча, а `header` или `seed` внутри `kcpSettings`
           # отвергает -- «mkcp header & seed has been removed and migrated
           # to finalmask/udp header-* & mkcp-original & mkcp-aes128gcm».
           #
           # Прежняя редакция объявляла удалённым весь транспорт -- и при
           # этом всё равно писала `header` в конфиг, подставляя `none`,
           # когда в ссылке его нет. То есть НИ ОДНА нода на kcp не
           # собиралась вовсе, а причину byway называл неверную. Поймано
           # вопросом владельца «разве они их убирали?».
           warn "mkcp идёт поверх UDP, а в РФ UDP душат первым делом"
           # Поля пишем, ТОЛЬКО если они есть в ссылке. Выбрасывать их
           # нельзя: на 26.3.27 (последний стабильный) они работают, и нода,
           # у которой сервер ждёт seed, сломалась бы от нашей заботы. А вот
           # подставлять `none` вместо отсутствующего header -- как делала
           # прежняя редакция -- нельзя тем более: на свежем движке это
           # роняло ЛЮБУЮ ноду на kcp, даже ту, где в ссылке ничего нет.
           # Решает пусть движок: конфиг, который он отверг, byway не
           # подставляет, рабочий остаётся прежним.
           _k=""
           if [ -n "$N_HDR" ]; then _k="\"header\": { \"type\": \"$N_HDR\" }"; fi
           if [ -n "$N_SEED" ]; then
               [ -n "$_k" ] && _k="$_k, "
               _k="$_k\"seed\": \"$N_SEED\""
           fi
           if [ -n "$_k" ]; then
               warn "header и seed у mkcp свежие Xray-core удалили (замена: finalmask/udp header-*, mkcp-original, mkcp-aes128gcm) -- оставлены как в ссылке; если движок их отвергнет, конфиг не заменится"
               STREAM="\"network\": \"kcp\", \"kcpSettings\": { $_k }"
           else
               STREAM="\"network\": \"kcp\""
           fi ;;

      grpc)
           _g=""
           if [ "$N_MODE" = "multi" ]; then _g=", \"multiMode\": true"; fi
           if [ -n "$N_AUTH" ]; then _g="$_g, \"authority\": \"$N_AUTH\""; fi
           STREAM="\"network\": \"grpc\", \"grpcSettings\": { \"serviceName\": \"$N_SVC\"$_g }" ;;

      h2|http)
           # Удалён по-настоящему, весь транспорт: движок отвергает конфиг и
           # сам называет замену. Номер версии здесь НЕ пишем -- у выпусков
           # 26.4-26.7 заметок нет вовсе, и назвать его нечем.
           warn "HTTP/2 из Xray-core удалён, замена: xhttp в режиме stream-one"
           STREAM="\"network\": \"$N_TYPE\", \"httpSettings\": { \"path\": \"$N_PATH\", \"host\": [ \"$N_WSHOST\" ] }" ;;

      quic)
           # И этот удалён целиком; замена -- тот же xhttp, но поверх H3.
           warn "QUIC из Xray-core удалён, замена: xhttp stream-one поверх H3; в РФ QUIC блокируют первым делом"
           _qs=${N_QSEC:-none}
           _qh=${N_HDR:-none}
           STREAM="\"network\": \"quic\", \"quicSettings\": { \"security\": \"$_qs\", \"key\": \"$N_QKEY\", \"header\": { \"type\": \"$_qh\" } }" ;;

      httpupgrade)
           # Точной версии появления не проверяли, поэтому предупреждение, а
           # не отказ: у 1.8.3 транспорта нет, дальше по 1.8.x -- не знаем.
           xray_ver_num >/dev/null
           [ "$XRAYVER" -lt 10824 ] &&
               warn "движок старый: транспорт httpupgrade он может не знать, и тогда конфиг соберётся, а туннель не встанет"
           STREAM="\"network\": \"httpupgrade\", \"httpupgradeSettings\": { \"path\": \"$N_PATH\", \"host\": \"$N_WSHOST\" }" ;;

      xhttp)
           # Транспорт много новее 1.8.x, и на старом движке он не «работает
           # хуже», а не существует: поле xhttpSettings будет отброшено молча,
           # network останется неизвестным. Говорим прямо, а не даём собрать
           # конфиг, который потом нечем объяснить.
           xray_ver_num >/dev/null
           if [ "$XRAYVER" -lt 10824 ]; then
               dief "движку %s транспорт xhttp неизвестен (нужен Xray-core 1.8.24 или новее) — обновить: byway engine tested, либо взять ключ на ws" \
                    "$("$XRAY" version 2>/dev/null | head -1 | cut -d' ' -f1-2)"
           fi
           # extra -- вложенный объект JSON, в ссылке приходит закодированным
           # процентами. Подставляем как есть: если он битый, xray run -test
           # в cmd_gen это поймает до подмены рабочего конфига.
           _m=""
           if [ -n "$N_MODE" ]; then _m=", \"mode\": \"$N_MODE\""; fi
           if [ -n "$N_EXTRA" ]; then _m="$_m, \"extra\": $N_EXTRA"; fi
           STREAM="\"network\": \"xhttp\", \"xhttpSettings\": { \"path\": \"$N_PATH\", \"host\": \"$N_WSHOST\"$_m }" ;;

      hysteria)
           # Транспорт и протокол в Xray-core есть с 26.1.13, но схема
           # hysteriaSettings менялась от выпуска к выпуску (up/down и udphop
           # уехали в finalmask к 26.9.9). Пишем только поля, общие для всех:
           # version и auth. Нижняя граница -- проверенная прогоном 26.3.27.
           xray_ver_num >/dev/null
           if [ "$XRAYVER" -lt 260327 ]; then
               dief "hysteria2 нужен Xray-core 26.3.27 или новее, а стоит %s — обновить: byway engine tested" \
                    "$("$XRAY" version 2>/dev/null | head -1 | cut -d' ' -f2)"
           fi
           warn "hysteria2 идёт поверх QUIC (UDP), а в РФ его ограничивают первым делом"
           _fm=""
           if [ -n "$N_OBFS" ]; then
               # salamander в finalmask/udp появился к 26.7.11; до того
               # обфускации у hysteria в Xray-core не было вовсе.
               if [ "$XRAYVER" -lt 260711 ]; then
                   dief "obfs=salamander у hysteria2 нужен Xray-core 26.7.11 или новее, а стоит %s — обновить: byway engine tested" \
                        "$("$XRAY" version 2>/dev/null | head -1 | cut -d' ' -f2)"
               fi
               _fm=", \"finalmask\": { \"udp\": [ { \"type\": \"salamander\", \"settings\": { \"password\": \"$N_OBFSPW\" } } ] }"
           fi
           STREAM="\"network\": \"hysteria\", \"hysteriaSettings\": { \"version\": 2, \"auth\": \"$N_PASS\" }$_fm" ;;

      # У wireguard транспорта нет: протокол сам ходит по UDP. В
      # streamSettings остаётся только метка на сокете (self_sockopt).
      wireguard) STREAM="" ;;

      *)   dief "транспорт %s не поддержан — есть ws, tcp/raw, kcp, grpc, httpupgrade, xhttp, hysteria" "$N_TYPE" ;;
    esac
    case "$N_SEC" in
      tls)     _a=""
               # В два шага намеренно: вложенные кавычки внутри sed внутри
               # подстановки внутри двойных кавычек рвут разбор — так файл
               # и сломался 2026-09-03.
               if [ -n "$N_ALPN" ]; then
                 _alist=$(printf '%s' "$N_ALPN" | sed 's/,/", "/g')
                 _a=", \"alpn\": [ \"$_alist\" ]"
               fi
               # allowInsecure ядро с 26.3.27 отвергает (там -- с 2026-06-01,
               # с 26.6.27 -- без условий), замена -- отпечаток сертификата
               # (pinnedPeerCertSha256) или имя для проверки
               # (verifyPeerCertByName). Сверено по исходникам 26.3.27-26.9.30.
               # Прежде byway писал allowInsecure всегда, и на любом свежем
               # движке такой ключ не собирался, а причину называл сам Xray.
               xray_ver_num >/dev/null
               if [ "$N_INSEC" = "1" ] || [ "$N_INSEC" = "true" ]; then
                 if [ "$XRAYVER" -lt 260327 ]; then
                   # Политика нового ядра -- и на старом: отказ, если
                   # человек не разрешил явно (свой самоподписанный сервер).
                   # С отпечатком отказ дальше точнее: «нужно ядро 26.3.27+».
                   [ "$(u allow_insecure)" = "1" ] || [ -n "$N_PIN$N_VCN" ] ||
                     die "в ключе отключена проверка сертификата (allowInsecure): соединение может подменить любой на пути. Для своего сервера с самоподписанным сертификатом: uci set byway.main.allow_insecure=1 && uci commit byway && /etc/init.d/byway reload"
                   warn "allowInsecure=1: проверка сертификата сервера отключена, соединение можно подменить"
                   _a="$_a, \"allowInsecure\": true"
                 elif [ -z "$N_PIN" ] && [ -z "$N_VCN" ]; then
                   die "в ключе отключена проверка сертификата (allowInsecure или insecure), а Xray-core с 26.3.27 так не умеет: нужен отпечаток сертификата сервера (pcs= или pinSHA256=) либо настоящий сертификат на сервере"
                 fi
               fi
               if [ -n "$N_PIN" ] || [ -n "$N_VCN" ]; then
                 if [ "$XRAYVER" -lt 260327 ]; then
                   dief "проверка сертификата по отпечатку (pcs, vcn) нужна Xray-core 26.3.27 или новее, а стоит %s — обновить: byway engine tested" \
                        "$("$XRAY" version 2>/dev/null | head -1 | cut -d' ' -f2)"
                 fi
                 if [ -n "$N_PIN" ]; then _a="$_a, \"pinnedPeerCertSha256\": \"$N_PIN\""; fi
                 if [ -n "$N_VCN" ]; then _a="$_a, \"verifyPeerCertByName\": \"$N_VCN\""; fi
               fi
               # Отпечаток браузера пишется, только если он есть: у hysteria
               # (QUIC) его нет вовсе.
               _f=""
               if [ -n "$N_FP" ]; then _f=", \"fingerprint\": \"$N_FP\""; fi
               SECURITY="\"security\": \"tls\", \"tlsSettings\": { \"serverName\": \"$N_SNI\"$_f$_a }" ;;
      reality)
               # spiderX и mldsa65Verify -- поля проверены на бинарнике: мусор
               # в значении даёт ошибку именно про них, значит они реализованы,
               # а не проглатываются как неизвестные.
               _r=""
               if [ -n "$N_SPX" ]; then _r=", \"spiderX\": \"$N_SPX\""; fi
               if [ -n "$N_PQV" ]; then _r="$_r, \"mldsa65Verify\": \"$N_PQV\""; fi
               SECURITY="\"security\": \"reality\", \"realitySettings\": { \"serverName\": \"$N_SNI\", \"fingerprint\": \"$N_FP\", \"publicKey\": \"$N_PBK\", \"shortId\": \"$N_SID\"$_r }" ;;
      none)    # vless и trojan без шифрования к публичному адресу ядро с
               # 26.7.11 отвергает само; на старом -- то же решение здесь:
               # uuid или пароль и весь туннель видны любому на пути.
               case "$N_PROTO" in vless|trojan)
                 xray_ver_num >/dev/null
                 if [ "$XRAYVER" -lt 260711 ] && [ "$(u allow_insecure)" != "1" ]; then
                   case "$N_HOST" in
                     10.*|192.168.*|127.*|169.254.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) ;;
                     *) die "ключ vless или trojan без TLS к публичному адресу: ключ и трафик видны любому на пути. Нужен ключ с security=tls или reality; разрешить всё же: uci set byway.main.allow_insecure=1 && uci commit byway && /etc/init.d/byway reload" ;;
                   esac
                 fi ;;
               esac
               SECURITY="\"security\": \"none\"" ;;
      *)       dief "security=%s не поддержан" "$N_SEC" ;;
    esac
    FLOWJ=""
    # if, а не «[ ] && ...»: при пустом значении такая конструкция
    # возвращает единицу, функция отдаёт её наружу и set -e убивает скрипт
    # молча. Ровно так byway gen умирал 2026-09-03.
    if [ -n "$N_FLOW" ]; then
        # Vision работает только по голому TCP с TLS или Reality. На ws, grpc
        # и прочих Xray конфиг ПРИНИМАЕТ, а падает уже в бою -- то есть сам
        # не предупредит. Предупреждаем мы.
        case "$N_TYPE" in
          tcp|raw) ;;
          *) warnf "flow=%s с транспортом %s не работает: Xray-core примет конфиг и сломается в бою" "$N_FLOW" "$N_TYPE" ;;
        esac
        FLOWJ=", \"flow\": \"$N_FLOW\""
    fi

    # Аутбаунд собираем ЗДЕСЬ, после FLOWJ: он входит в блок пользователя
    # у vless, и собранный раньше потерял бы flow.
    build_outbound

    # Мультиплексирование. Схлопывает много соединений клиентов в несколько
    # соединений к ноде. Зачем: на роутере узкое место -- процессор, и
    # полсотни живых TLS-сессий это полсотни наборов криптографии. Замер
    # 2026-09-03 на боевом трафике дал 53-58 одновременных соединений к ноде.
    #
    # В ПОСТАВКЕ ВКЛЮЧЁН значением 8 -- замер, которым это обосновано, лежит в
    # etc-config-byway. Выключение -- это 0. Прежний комментарий здесь утверждал
    # обратное («выключено по умолчанию»), то есть отрицал собственное измерение
    # проекта: два места одной программы давали противоположный ответ на вопрос
    # «участвует ли mux из коробки», и разбирательство «соединения стали вставать
    # медленнее» начиналось не с того конца.
    #
    # НЕ СОЧЕТАЕТСЯ С xtls-rprx-vision: Vision сам управляет разделением
    # потока, и mux поверх него лишает его смысла. Поэтому при заданном flow
    # молча выключаем и говорим об этом вслух.
    MUXJ=""
    # Через val_or, а не голым чтением. Значение уходит в JSON БЕЗ кавычек
    # (`"concurrency": $_mux`), входит в EXPORT_KEYS и правится панелью, то
    # есть приходит снаружи. Прошлым заходом я закрыл этим же способом пул,
    # адрес резолвера и оба порта -- а mux, уровень журнала и интервал пробы
    # пропустил: они собираются в другом месте файла и на глаза не попались.
    _mux=$(val_or mux_concurrency "$(u mux_concurrency)" \
           '^[0-9]{1,3}$' 0 "$(_t 'конфига движка')")
    if [ -n "$_mux" ] && [ "$_mux" != "0" ]; then
        if [ -n "$N_FLOW" ]; then
            warnf "mux отключён: он не сочетается с flow=%s (Vision делит поток сам)" "$N_FLOW"
        elif [ "$N_TYPE" = "xhttp" ] || [ "$N_TYPE" = "grpc" ] || [ "$N_TYPE" = "hysteria" ]; then
            # Замер 2026-09-03: xhttp с mux дал 896 мс медианы против 861 без
            # него, и всё уходило в ОДНО соединение. У xhttp своё
            # мультиплексирование (xmux), у grpc свой multiMode -- второй слой
            # поверх только добавляет блокировку начала очереди.
            warnf "mux отключён: у транспорта %s своё мультиплексирование, второй слой поверх только вредит" "$N_TYPE"
        elif [ "$N_PROTO" = "wireguard" ]; then
            # Мультиплексирование Xray -- поверх потока; у wireguard потока
            # нет, ему делить нечего. Говорим вслух, как о прочих отказах.
            warn "mux к wireguard не применяется: у него нет потока, который можно делить"
        else
            MUXJ=" \"mux\": { \"enabled\": true, \"concurrency\": $_mux },"
        fi
    fi
}

# Готовый объект аутбаунда целиком. При своём конфиге отдаём написанное
# человеком, дописав только тег: без него правила маршрутизации не найдут,
# куда слать. При обычном -- собираем из разобранной ссылки.
proxy_block() {
    _tag=${1:-proxy}
    if [ "$N_PROTO" = "raw" ]; then
        # "tag" -- ПОСЛЕДНИМ полем объекта. Xray на повторяющемся ключе берёт
        # последний (проверено run -dump на 26.9.30), а правила ищут свой
        # тег. Прежде тег вставлялся первым, и свой тег человека его
        # перебивал: правила вели в несуществующий исходящий, а run -test
        # этого не замечает.
        printf '%s' "$N_RAW" | awk -v t="$_tag" '
            { s = s $0 "\n" }
            END {
                n = 0
                for (i = length(s); i > 0; i--) if (substr(s, i, 1) == "}") { n = i; break }
                if (n == 0) { printf "%s", s; exit }
                head = substr(s, 1, n - 1); tail = substr(s, n)
                b = head; sub(/[[:space:]]+$/, "", b)
                sep = (substr(b, length(b), 1) == "{") ? " " : ", "
                printf "%s%s\"tag\": \"%s\" %s", b, sep, t, tail
            }' 
    else
        # Части streamSettings склеиваются через запятую только непустые:
        # у wireguard транспорта нет, и шаблон «{ %s, %s }» дал бы «{ , …}».
        _ss=$STREAM
        if [ -n "$SECURITY" ]; then _ss="${_ss:+$_ss, }$SECURITY"; fi
        _so=$(self_sockopt)
        if [ -z "$_ss" ]; then _so=${_so#, }; fi
        printf '{ "tag": "%s", %s,%s "streamSettings": { %s%s } }' \
            "$_tag" "$OUTBOUND" "$MUXJ" "$_ss" "$_so"
    fi
}

# Метка на исходящих. Пустая строка, когда заворот выключен: тогда метка не
# нужна, и конфиг у всех, кто заворотом не пользуется, остаётся прежним.
#
# Для ключа, заданного готовым куском JSON (N_PROTO=raw), метку не подставляем:
# там своя структура, и лезть в неё вслепую опаснее, чем не поставить. Человек,
# пишущий аутбаунд руками, допишет `sockopt` сам -- об этом сказано в подсказке
# к настройке заворота.
self_sockopt() {
    # По НАСТРОЙКЕ, а не по redir_port: та ещё и проверяет порт и жалуется на
    # него, а метке до порта дела нет -- её условие «заворот включён».
    # Зовём мы её из трёх мест, и тройная жалоба на один негодный порт хуже
    # молчания.
    [ "$(u router_via_vpn)" = "1" ] || return 0
    printf ', "sockopt": { "mark": %s }' "$(self_mark_dec)"
}

# Аутбаунды прокси, наблюдатель и балансировщик.
#
# Обычные режимы дают ОДИН аутбаунд с тегом proxy, и правила шлют в него.
# Режим urltest даёт по аутбаунду на каждый ключ (proxy-0, proxy-1, …), а
# правила шлют в БАЛАНСИРОВЩИК: Xray сам замеряет задержку до каждого и
# выбирает живой. Это и есть резерв на случай, когда одна нода отвалилась.
#
# Схема проверена прогоном на бинарнике 26.7.11: observatory с subjectSelector,
# balancers со strategy leastPing и правило с balancerTag вместо outboundTag.
build_proxies() {
    _mode=$(u conn_mode)
    OBSERVATORY=""
    BALANCERS=""
    PROXY_TARGET='"outboundTag": "proxy"'
    # Куда уходит всё, не совпавшее с правилами. В режиме списков -- напрямую,
    # в режиме «всё через VPN» -- в туннель.
    if [ "$(u list_mode)" = "all" ]; then
        LAST_TARGET=$PROXY_TARGET
    else
        LAST_TARGET='"outboundTag": "direct"'
    fi

    VPN_HOSTS=""
    if [ "$_mode" != "urltest" ]; then
        if [ -n "${1:-}" ]; then parse_node "$1"; else parse_node; fi
        build_stream
        PROXIES=$(proxy_block)
        # Свой конфиг: адрес ноды внутри чужого JSON, и parse_node оставляет
        # в N_HOST прочерк. Он уходил в правило как ip "-/32", и движок
        # отвергал конфиг целиком -- то есть «свой конфиг» вместе с «всё
        # через VPN» не собирался никогда.
        if [ "$N_PROTO" = "raw" ]; then
            VPN_HOSTS=""
            warn "свой конфиг: адрес сервера лежит внутри чужого JSON, byway его не знает и из перехвата не исключит — проверить, что адрес сервера не попал в списки, иначе туннель замкнётся сам на себя"
        else
            VPN_HOSTS=$N_HOST
        fi
        return 0
    fi

    _keys=$(u node_urls)
    [ -n "$_keys" ] || die "выбран автовыбор, но ни одного ключа не добавлено"

    PROXIES=""
    _n=0
    xray_ver_num >/dev/null     # версия -- один раз, подоболочки её наследуют
    for _k in $_keys; do
        # Подоболочка обязательна: parse_node на плохом ключе зовёт die, а die
        # делает exit -- то есть || не срабатывает и весь gen умирает от ОДНОГО
        # негодного ключа среди десяти. Сперва проверка в подоболочке, потом
        # настоящий разбор, чтобы переменные попали в текущую оболочку.
        # И build_stream там же: отказ по версии ядра (hysteria2 на старом,
        # allowInsecure без отпечатка) зовёт die уже при сборке, и один такой
        # ключ из подписки валил весь автовыбор.
        if ! _kerr=$( ( parse_node "$_k" && build_stream ) 2>&1 >/dev/null ); then
            warnf "ключ пропущен: %s" "$(printf '%s' "$_kerr" | tail -1 | tr -d '\033' | sed 's/\[[0-9;]*m//g; s/^ *\[x\] *//')"
            continue
        fi
        parse_node "$_k"
        build_stream
        _b=$(proxy_block "proxy-$_n")
        VPN_HOSTS="$VPN_HOSTS $N_HOST"
        if [ -n "$PROXIES" ]; then PROXIES="$PROXIES,
    $_b"; else PROXIES="    $_b"; fi
        _n=$((_n + 1))
    done
    [ "$_n" -gt 0 ] || die "ни один ключ не разобрался"

    # Уходит в `"probeInterval": "'$_iv'"`. Кавычки в значении закрывают
    # строку, дальше пишется что угодно -- и конфиг остаётся валидным JSON,
    # который движок примет.
    _iv=$(val_or probe_interval "$(u probe_interval)" '^[0-9]{1,4}[smh]$' 3m "$(_t 'конфига движка')")
    OBSERVATORY='"observatory": { "subjectSelector": [ "proxy-" ], "probeUrl": "https://www.google.com/generate_204", "probeInterval": "'$_iv'" },'
    BALANCERS='"balancers": [ { "tag": "auto", "selector": [ "proxy-" ], "strategy": { "type": "leastPing" } } ],'
    PROXY_TARGET='"balancerTag": "auto"'
    [ "$(u list_mode)" = "all" ] && LAST_TARGET=$PROXY_TARGET
    N_LABEL=$(_f 'автовыбор из %s' "$_n")
}

# Промежуток словами: 90m, 3h, 2h37m, 1d, 1d6h. Отдаёт минуты, при мусоре -1.
#
# Почему не просто число минут: «каждые 157 минут» человек не думает и не
# пишет, он думает «каждые два часа с небольшим». Разбор дешевле, чем два
# поля в панели и объяснение, что складывать их надо самому.
mins_of() {
    _s=$(printf '%s' "$1" | tr 'DHM' 'dhm' | tr -d ' ')
    case "$_s" in ''|0) echo 0; return 0 ;; esac
    case "$_s" in *[!0-9]*) ;; *) echo "$_s"; return 0 ;; esac   # голое число -- минуты
    echo "$_s" | awk '{
        n = 0; v = 0; ok = 1
        for (i = 1; i <= length($0); i++) {
            c = substr($0, i, 1)
            if (c >= "0" && c <= "9") { v = v * 10 + (c + 0); continue }
            if      (c == "d") n += v * 1440
            else if (c == "h") n += v * 60
            else if (c == "m") n += v
            else { ok = 0; break }
            v = 0
        }
        if (!ok) { print -1 } else { print n + v }
    }'
}

# ── пресеты ────────────────────────────────────────────────────────────────
#
# Готовые списки доменов, которые можно подключить вместо своего или вместе
# с ним. Смысл в том, чтобы человеку, поставившему byway впервые, не пришлось
# собирать полторы тысячи записей руками.
#
# Каталог держим ЗДЕСЬ, а не в панели: панель может и не стоять, а команда
# работает всегда. Каждый пресет -- имя, адрес и одна строка про то, что
# внутри и чему в нём нельзя доверять.
#
# ⚠️ Пресеты НЕ проверяются никем, кроме их авторов. Проверено 2026-09-04 на
# списках itdoginfo: из 37 записей, которых не было в курируемом списке,
# четыре уже лежали в хостлисте zapret (то есть подключение пресета молча
# сломало бы правило «домен ровно в одном месте»), две относились к сервису,
# убранному намеренно, а две были мусором -- целая доменная зона «.ua» и имя
# с несуществующим доменом верхнего уровня. Поэтому byway после загрузки
# ГОВОРИТ о пересечениях, а не молчит.
PRESETS_DIR=$LISTS/presets

# Живость движка. Через pid-файл procd, а не через разбор вывода `ps`: форма
# `ps w` и номер колонки с pid -- это соглашение busybox, а на прошивке с
# полноценным procps-ng вывод другой. Там сторож считал исправный движок
# мёртвым и снимал обвязку с работающего туннеля. /proc подтверждает, что
# процесс жив И что это наш Xray, а не переиспользованный номер.
xray_pid() {
    _xp=$(cat /var/run/byway.pid 2>/dev/null || true)
    if [ -n "$_xp" ] && [ -r "/proc/$_xp/cmdline" ] &&
       tr '\0' ' ' < "/proc/$_xp/cmdline" 2>/dev/null | grep -q "run -c $OUT"; then
        printf '%s' "$_xp"
        return 0
    fi
    # Запасной путь: движок могли запустить руками, мимо службы.
    ps w 2>/dev/null | grep "run -c $OUT" | grep -v grep | awk '{print $1}' | head -1
}

# Подсети против пинов в /etc/hosts. Домены сверяются с хостлистом zapret по
# именам, а у подсетей имён нет -- пересечение видно только по адресам. Пин
# вида finlandNNNNN.discord.media ставят ровно затем, чтобы адрес шёл МИМО
# туннеля; накрыв его чужим диапазоном из готового набора, мы делаем обратное
# тому, ради чего он поставлен, и заметить это нечем.
# То же для ДОМЕНОВ. Пин в /etc/hosts перебивает резолвер: byway отдал бы на
# этот домен подставной адрес и увёл в туннель, но dnsmasq отвечает по пину, и
# клиент идёт напрямую -- при том что домен в списке, а панель и status
# показывают его как заведённый. Ни один указатель об этом не говорил.
# Найдено третьим аудитом 2026-09-07.
#
# Сверяем по суффиксу: пин на cdn.example.com перебивает и запись example.com,
# потому что имя у dnsmasq точное, а у byway -- с поддоменами.
hosts_vs_domains() {   # $1 -- файл доменов
    [ -f /etc/hosts ] && [ -s "$1" ] || { echo 0; return 0; }
    _hp=/tmp/byway-hosts.$$
    awk '$1 !~ /^#/ && NF >= 2 { for (i = 2; i <= NF; i++) if ($i !~ /^#/) print $i }' \
        /etc/hosts 2>/dev/null | tr -d '\r' | sort -u > "$_hp"
    if [ -s "$_hp" ]; then
        # ⚠️ Сверка шла В ОБРАТНУЮ СТОРОНУ и потому молчала всегда.
        # Стояло `grep -Ff` по образцам «.пин»: это находит записи СПИСКА,
        # являющиеся поддоменами пина. А перекрытие устроено наоборот -- byway
        # приписывает своим записям `domain:`, то есть каждая накрывает все
        # свои поддомены, и запись списка discord.media перебивается пином
        # finland12345.discord.media. Ровно такие пины и лежат на роутере
        # сотнями: их пишет Zapret-Manager. Проверка честно отвечала «0».
        #
        # Теперь для каждого пина откусываем метки слева и спрашиваем каждый
        # хвост у списка: точное совпадение либо любой суффикс.
        awk -v LF="$1" '
          BEGIN {
            while ((getline l < LF) > 0) {
              gsub(/[[:space:]\r]/, "", l)
              if (l == "" || substr(l, 1, 1) == "#" || substr(l, 1, 2) == "//") continue
              d[tolower(l)] = 1
            }
          }
          {
            h = tolower($0)
            if (h in d) { c++; next }
            s = h
            while ((p = index(s, ".")) > 0) {
              s = substr(s, p + 1)
              if (s in d) { c++; next }
            }
          }
          END { print c + 0 }
        ' "$_hp"
    else
        echo 0
    fi
    rm -f "$_hp" 2>/dev/null || true
}

hosts_in_subnets() {   # $1 -- файл подсетей
    [ -f /etc/hosts ] || { echo 0; return 0; }
    [ -s "$1" ] || { echo 0; return 0; }
    awk -v SF="$1" '
      function a2n(a,  p) { split(a, p, "."); return ((p[1]*256+p[2])*256+p[3])*256+p[4] }
      BEGIN {
        while ((getline l < SF) > 0) {
          gsub(/[[:space:]\r]/, "", l)
          if (l == "" || substr(l,1,1) == "#" || substr(l,1,2) == "//") continue
          pfx = 32; ip = l
          if (index(l, "/")) { ip = substr(l, 1, index(l,"/")-1); pfx = substr(l, index(l,"/")+1) + 0 }
          if (ip !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) continue
          n++; base[n] = a2n(ip); size[n] = 2 ^ (32 - pfx)
        }
      }
      /^[[:space:]]*#/ { next }
      $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {
        v = a2n($1)
        for (i = 1; i <= n; i++)
          if (int(v / size[i]) == int(base[i] / size[i])) { c++; break }
      }
      END { print c + 0 }' /etc/hosts
}

