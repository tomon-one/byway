    {
      "tag": "dns-in",
      "listen": "$DNS_LISTEN",
      "port": 53,
      "protocol": "dokodemo-door",
      "settings": { "address": "$DNS_LISTEN", "port": 53, "network": "tcp,udp" }
    },
    {
      "tag": "tproxy-in",
      // 0.0.0.0, а не петля: tproxy НЕ переписывает адрес назначения, пакет
      // доходит до сокета с исходным 198.18.x.x. Сокет, привязанный к
