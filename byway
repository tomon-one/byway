    # был зашит литералом 65535 при настраиваемом пуле. Две арифметики
    # расходились молча: поставочный /15 -- это 131 070 адресов, то есть
    # половина пула не использовалась никогда; а список длиннее 65 535 доменов
    # в fakedns не помещался по построению, при том что пресет разрешает
    # 200 000. Вытесненная из LRU пара отдаёт свой адрес другому домену, и
    # устройство с прежним ответом в кэше уходит к чужому хосту через ноду --
    # без единой ошибки где бы то ни было.
    POOL_SIZE=$(pool_size "$POOL")
    _dcount=$(count_list "$MERGED"); _dcount=${_dcount:-0}
    if [ "$_dcount" -gt "$POOL_SIZE" ]; then
        warnf "доменов %s, а адресов в пуле %s — часть будет вытесняться и уводить соединения к чужому хосту. Расширить пул (byway.main.fakeip_pool) либо укоротить список" \
              "$_dcount" "$POOL_SIZE"
    fi

