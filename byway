#!/bin/sh
# Собран из src/ (порядок -- src/ORDER) командой src/build.sh -- правка здесь пропадёт при сборке.
#
# byway -- раздельное туннелирование на OpenWrt, ядро Xray (замена podkop).
# Путь трафика: dnsmasq -> DNS-вход Xray -> FakeDNS отдаёт адрес из пула для
# доменов списка -> nft метит трафик на этот пул в tproxy -> вход Xray со
# сниффингом достаёт исходный домен -> правило маршрутизации шлёт его в
# аутбаунд ключа. Всё прочее идёт напрямую.
# Списки -- файлы в /etc/byway, а не инлайн в UCI: правка файла действует
# после `byway gen`. Службой управляет /etc/init.d/byway, он и зовёт plumb
# (nft, маршрут, dnsmasq). Список команд печатает `byway` без аргументов
# (ui/main.sh).

set -e

# Версия -- вручную, В МОМЕНТ ВЫПУСКА: main идёт впереди тега, номер на нём --
# последнего выпуска. Иначе README ссылается на тег, которого нет, и
# установка одной строкой отвечает 404.
# Имя -- опознавательный знак сборки, одно английское на все языки, не
# переводить. Ряд по минорам: 0.0 Desire Path, 0.1 Portage, 0.2 Causeway,
# 0.3 Ford, 0.4 Ice Road, 0.5 Trail, 0.6 Bypass, 0.7 Country Lane, 0.8 Old
# Road.
# Автообновление ходит только внутри минорной версии (cmd_watch).
BYWAY_NUM="0.3.0"
BYWAY_NAME="Ford"
BYWAY_VERSION="$BYWAY_NUM ($BYWAY_NAME)"
# Откуда берутся обновления; чужая сборка меняет одно место.
BYWAY_REPO="tomon-one/byway"
# Открытый ключ подписи выпусков (usign/signify, byway-release.pub): им
# byway update и установщик проверяют SHA256SUMS выпуска. Тот же -- в
# install.sh (BYWAY_PUBKEY), править парой.
BYWAY_PUBKEY="RWQ9r7vQihS1LvQHytsWrPqBkUalRDrj6JBUInbi7KXlUUPHBMzFmvJl"
# Версия Xray-core, на которой byway прогнан целиком: её ставит `byway engine
# tested`. Та же в install.sh (XRAY_TESTED) -- править парой.
XRAY_TESTED=26.10.17
# Суммы SHA2-256 архивов этой версии по сборкам: .dgst лежит рядом с архивом
# на GitHub, а эти -- в подписанном выпуске byway. Вписывает
# scripts/pc/xray-sums.py; тот же блок -- в install.sh.
XRAY_TESTED_SUMS="linux-32=b19b563d43f151f017e4a3227d2320c6ffb1c1a61f11b3c08b9e25bf940100af
linux-64=ecdd54eccd24c4c21a8f00968e7dbf7f5996da92383d2321170b560dc4a95158
linux-arm32-v6=6726ffaab314010c48d421d8bc5122d79e72d27d3a82b3aaa2d1c5e5b94a2e99
linux-arm32-v7a=3c5339ba4a14ebad74df26e6ad935c215f5be615684f139a78d3dff8cbf6e7e4
linux-arm64-v8a=4ebdad86048fa499e65334f88a120b1ed17e662f1c222afd3514afdf8820cdb1
linux-mips32=fd806063824f5abdf5fc72ff4a6e94537b0d5900923886a018ec21100c39893b
linux-mips32le=9ad6e49a48b55a71ec2976f3893f506cd96f11ae4ac672b28f179adff5a25a11
linux-mips64=9e4a8d22283480fe8c8edb56d2b105dd3da23929c8503c1fb40ae4112468a2ca
linux-mips64le=a3dc732d441d80698ca3fce8b52b64cf0384ee6ed61ebfba41ae75b98b4fad18
linux-riscv64=e63ce4ba33f9401fe25fc9244228702388e079bba00ec44aca6011aa81b910de"

CONF=/etc/config/byway
LISTS=/etc/byway
OUT=$LISTS/config.json
# Журнал обращений движка -- свой файл в памяти, не syslog: сотня строк в
# минуту вытесняет из кольца в 256 КБ всё остальное за 20 минут. Усекают
# cmd_stat и сторож cmd_watch. Каталог -- root 755 (init): файл пишет движок
# от byway, но заменить его ссылкой не может -- в общем /tmp подменённый на
# ссылку журнал root обрезал бы и отдавал chown'ом по ссылке.
ACCESS=/var/run/byway/access.log
# Путь к движку -- из UCI, чтобы держать рядом пакетный Xray и свежий ручной
# и переключаться одной командой.
# Значение пришло снаружи (UCI правит панель): запускать от root по нему
# нельзя без проверки (так устроены CVE luci-app-travelmate и samba4;
# валидатор панели не защита). Порядок: каталог (в системные пишет только
# root), исполняемость, и лишь затем версия.
xray_ok() {
    case "$1" in
        /usr/bin/*|/usr/sbin/*|/usr/local/bin/*|/bin/*|/sbin/*) ;;
        *) return 1 ;;
    esac
    case "$1" in *..*) return 1 ;; esac
    [ -f "$1" ] && [ -x "$1" ] || return 1
    # Имя xray* и ELF -- до запуска: xray_bin=/sbin/reboot с панели
    # перезагружал роутер на каждом вызове byway.
    case "${1##*/}" in xray*) ;; *) return 1 ;; esac
    head -c 4 "$1" 2>/dev/null | grep -q ELF || return 1
    "$1" version 2>/dev/null | head -1 | grep -qi "^Xray " || return 1
}

# || true обязателен: uci -q get на незаданной опции даёт 1, и под set -e
# присваивание молча убивает скрипт.
XRAY=$(uci -q get byway.main.xray_bin || true)
# Жалоба отложена: путь проверяется раньше, чем заведён словарь (_t), и
# напечатанное здесь осталось бы русским. Печатается в core/lang.sh.
XRAY_REJECTED=""
if [ -n "$XRAY" ] && ! xray_ok "$XRAY"; then
    XRAY_REJECTED=$XRAY
    XRAY=""
fi

# Версия движка числом: 26.7.28 -> 260728, 1.8.3 -> 10803. Нумерация Xray
# менялась, сравнение по числам её переживает.
# Нужна, потому что Go молча отбрасывает незнакомые поля JSON, и `run -test`
# старого Xray (1.8.3 на OpenWrt 22.03) принимает конфиг с потерянным полем.
# Звать только как команду, число читать из XRAYVER: в $(...) присваивание
# кэша теряется в подоболочке, и бинарник запускается на каждый аутбаунд.
XRAYVER=""
xray_ver_num() {
    if [ -z "$XRAYVER" ]; then
        _xvs=$("$XRAY" version 2>/dev/null | head -1 | awk '{print $2}' | tr -cd '0-9.')
        if [ -n "$_xvs" ]; then
            XRAYVER=$(printf '%s' "$_xvs" | awk -F. '{ printf "%d", ($1 * 10000) + ($2 * 100) + $3 }')
        fi
        # Не определилась -- считаем современной, старую форму не пишем.
        [ -n "$XRAYVER" ] || XRAYVER=999999
    fi
    printf '%s' "$XRAYVER"
}
[ -n "$XRAY" ] || XRAY=$(command -v xray || echo /usr/bin/xray)

# apk с OpenWrt 25.12, opkg на прежних: подсказка не должна давать
# команду чужого менеджера.
PKG_FIX="apk update && apk add"
if ! command -v apk >/dev/null 2>&1 && command -v opkg >/dev/null 2>&1; then
    PKG_FIX="opkg update && opkg install"
fi

# Вывод и журнал: say/warn/die и их формы с подстановками (f), logt/logf
# в syslog. Строка печатается через перевод (_t).

_say()  { printf '\033[1;32m[*]\033[0m %s\n' "$1"; }

_warn() { printf '\033[1;33m[!]\033[0m %s\n' "$1"; }

die_raw() { printf '\033[1;31m[x]\033[0m %s\n' "$1"; exit 1; }

# Вторые (sayf, warnf, dief) переводят ФОРМАТ, а не готовый текст:
# подставленное значение в словаре не найдётся, и строка осталась бы русской.
say()   { _say  "$(_t "$1")"; }

warn()  { _warn "$(_t "$1")"; }

die()   { die_raw "$(_t "$1")"; }

sayf()  { _fmt=$(_t "$1"); shift; _say    "$(printf "$_fmt" "$@")"; }

warnf() { _fmt=$(_t "$1"); shift; _warn   "$(printf "$_fmt" "$@")"; }

dief()  { _fmt=$(_t "$1"); shift; die_raw "$(printf "$_fmt" "$@")"; }

# Журнал системы читает тот же человек, что и экран; обёртки не дают забыть
# перевод строк logger.
logt()  { logger -t byway "$(_t "$1")"; }

logf()  { _lfm=$(_t "$1"); shift; logger -t byway "$(printf "$_lfm" "$@")"; }

# Чтение настроек byway из UCI.

# || true структурный: uci -q get на незаданной опции даёт 1, и VAR=$(u x) под
# set -e молча убивает скрипт. Закрыто здесь для всех опций сразу.
u() { uci -q get "byway.main.$1" || true; }

# Перевод: язык из UCI, словарь lang/<язык>.tsv, _t и _f. Здесь же
# отложенная жалоба на путь к ядру -- после словаря, чтобы её перевести.

# ── язык вывода ────────────────────────────────────────────────────────────
# Русские строки в коде -- ключ; перевод -- файл «ключ<TAB>перевод» на язык.
# Язык добавляется без правки кода, пропущенная строка остаётся русской, а не
# пустой. gettext не годится: его нет в busybox, панели нужен был бы пакет.
BW_LANG=$(u lang)
# Только две строчные буквы: из значения строится путь к словарю, а строки
# словаря становятся форматами printf. Опцию пишут и панель, и импорт.
case "$BW_LANG" in [a-z][a-z]) ;; *) BW_LANG=ru ;; esac

LANGDIR=$LISTS/lang

TAB=$(printf '\t')

_t() {
    [ "$BW_LANG" = "ru" ] && { printf '%s' "$1"; return 0; }
    _tf=$LANGDIR/$BW_LANG.tsv
    [ -f "$_tf" ] || { printf '%s' "$1"; return 0; }
    # index()==1, а не grep -F: тот ищет подстроку где угодно, и короткий ключ
    # совпадал внутри длинного. Ключ -- в начале строки, до табуляции.
    # Ключ через ENVIRON, не -v: -v разворачивает escape-последовательности, и
    # ключи с переводом строки не находились.
    _tv=$(BW_K="$1$TAB" awk 'index($0, ENVIRON["BW_K"]) == 1 { print substr($0, length(ENVIRON["BW_K"]) + 1); exit }' "$_tf" 2>/dev/null || true)
    printf '%s' "${_tv:-$1}"
}

# Отложенная жалоба из core/head.sh: теперь словарь есть.
if [ -n "$XRAY_REJECTED" ]; then
    # Файла нет или у него нет права запуска -- не «отклонён» (Ф-13).
    if [ -f "$XRAY_REJECTED" ] && [ -x "$XRAY_REJECTED" ]; then
        warnf "путь к движку отклонён: %s" "$XRAY_REJECTED" >&2
    else
        warnf "движок не найден или не исполняемый: %s" "$XRAY_REJECTED" >&2
    fi
fi

# ── проверка окружения ─────────────────────────────────────────────────────
# _f -- формат с подстановками там, где перевод нужен, а обёртки say нет.
# Двойной перевод безвреден: готовая строка в словаре не найдётся.
_f() { _fm=$(_t "$1"); shift; printf "$_fm" "$@"; }

# Часть byway на ucode (переход с shell по группам команд, план
# docs/plans/2026-10-16-improvements.md): программа -- в конце этого же файла,
# между метками #@uc-begin и #@uc-end.

# ucode читает программу только из файла, который можно перематывать:
# конвейер падает на 25.12 («Invalid seek»), /dev/fd нет на 22.03 (стенды
# 2026-10-16). Поэтому она вырезается в файл -- заново, когда сменился сам
# byway (inode, размер, время). /var/run, а не /var/run/byway: файл исполняет
# root, и каталог, куда пишет кто-то ещё, дал бы подменить программу.
# BW_SELF -- путь к byway: стенды подгружают его кусок под другим именем.
BW_SELF=${BW_SELF:-}
BW_UCF=/var/run/byway.uc
# Скомпилированная (ucode -c): разбор 260 КБ исходника стоит ~0,15 с на
# роутере при каждом вызове, байткод грузится впятеро быстрее (стенд
# 2026-10-18). Строгий режим (-S) задаётся при компиляции. Не скомпилировалась
# -- идёт исходник.
BW_UCC=/var/run/byway.ucc

bw_uc_prep() {
    [ -n "$BW_SELF" ] || BW_SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
    _ust=$(ls -lni "$BW_SELF" 2>/dev/null || true)
    if [ -z "$_ust" ] || [ "$(head -n 1 "$BW_UCF" 2>/dev/null)" != "// $_ust" ]; then
        # Без своей части файл -- не byway (стенд подгрузил кусок под чужим
        # именем): пустая программа молча отдала бы пустой вывод.
        grep -q '^#@uc-begin$' "$BW_SELF" 2>/dev/null ||
            die "часть byway на ucode не извлечена в /var/run"
        # Байткод прежней версии -- прочь ДО подмены исходника: параллельный
        # вызов увидел бы новый исходник и запустил старый байткод.
        rm -f "$BW_UCC" 2>/dev/null || true
        { printf '// %s\n' "$_ust"
          sed -n '/^#@uc-begin$/,/^#@uc-end$/{/^#@uc-/d;p}' "$BW_SELF"; } > "$BW_UCF.$$" &&
            mv "$BW_UCF.$$" "$BW_UCF" || {
                rm -f "$BW_UCF.$$" 2>/dev/null || true
                die "часть byway на ucode не извлечена в /var/run"
            }
        ucode -c -S -o "$BW_UCC.$$" "$BW_UCF" >/dev/null 2>&1 &&
            mv "$BW_UCC.$$" "$BW_UCC" 2>/dev/null || rm -f "$BW_UCC.$$" 2>/dev/null || true
    fi
    if [ -f "$BW_UCC" ]; then BW_UCRUN=$BW_UCC; else BW_UCRUN="-S $BW_UCF"; fi
}

bw_uc() {
    bw_uc_prep
    # shellcheck disable=SC2086
    BW_VERSION=$BYWAY_VERSION BW_LANG=$BW_LANG ucode $BW_UCRUN "$@"
}

# Общие помощники: проверка значений, замки, сравнение версий, pid движка.

# Порт: число 1..65535; идёт в JSON без кавычек (порт ключа и входы).
port_ok() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# grep -c на нуле печатает 0 и возвращает 1: `|| echo 0` давал два нуля.
count_list() {
    [ -f "$1" ] || { echo 0; return 0; }
    awk '{ gsub(/^[[:space:]]+|[[:space:]\r]+$/, "")
           if ($0 == "") next
           if (substr($0, 1, 1) == "#") next
           if (substr($0, 1, 2) == "//") next
           n++ } END { print n + 0 }' "$1"
}

# Живость движка -- по pid-файлу procd, не по разбору `ps`: на procps-ng формат
# другой, и сторож считал живой движок мёртвым и снимал обвязку. /proc
# подтверждает, что это наш Xray, а не повторно выданный номер.
xray_pid() {
    _xp=$(cat /var/run/byway.pid 2>/dev/null || true)
    # Не от root движок идёт через ujail: в pid-файле обёртка, Xray -- потомок.
    [ "$(readlink "/proc/$_xp/exe" 2>/dev/null)" = /sbin/ujail ] &&
        _xp=$(pgrep -P "$_xp" 2>/dev/null | head -1)
    if [ -n "$_xp" ] && [ -r "/proc/$_xp/cmdline" ] &&
       tr '\0' ' ' < "/proc/$_xp/cmdline" 2>/dev/null | grep -q "run -c $OUT"; then
        printf '%s' "$_xp"
        return 0
    fi
    # Запасной путь: движок запущен руками, мимо службы.
    ps w 2>/dev/null | grep "run -c $OUT" | grep -v grep | awk '{print $1}' | head -1
}

# ── обновления ─────────────────────────────────────────────────────────────
# Проверка только по запросу: регулярный стук в GitHub с домашнего адреса --
# заметный провайдеру след «здесь byway». Ходим через свой прокси-вход:
# github.com часто в списке, а правила в prerouting трафик самого роутера не
# ловят -- резолвер отдаёт адрес пула без маршрута, ответ -- пустота.

# Сравнение версий вида 1.2.3; sort -V в busybox нет.
ver_gt() {
    _va=$(printf '%s' "$1" | tr -c '0-9' ' ')
    _vb=$(printf '%s' "$2" | tr -c '0-9' ' ')
    # shellcheck disable=SC2086
    set -- $_va; _a1=${1:-0}; _a2=${2:-0}; _a3=${3:-0}
    # shellcheck disable=SC2086
    set -- $_vb; _b1=${1:-0}; _b2=${2:-0}; _b3=${3:-0}
    [ "$_a1" -ne "$_b1" ] && { [ "$_a1" -gt "$_b1" ]; return $?; }
    [ "$_a2" -ne "$_b2" ] && { [ "$_a2" -gt "$_b2" ]; return $?; }
    [ "$_a3" -gt "$_b3" ]
}

# Домен для проверки «трафик проходит»: заворачивается всегда, мимо списков.
PROBE_DOMAIN=example.com

# Замок на каталоге: mkdir атомарен. Живость решает pid внутри, не сам каталог:
# он остаётся от прерванного прогона, и каждый вызов ждал бы 30 с и отказал.
# Общий для сборки и обвязки (хозяев пятеро: старт, цикл попыток, reload, cron,
# человек). Замки в /var/run (root 755), не в /tmp (1777): чужой процесс
# (dnsmasq) занял бы замок с живым pid, и обвязка не поднялась бы никогда.
# Чужой замок (нет метки byway внутри) снимаем силой; владельца судим по
# файлу, а не по правам каталога: busybox stat есть не везде.
take_lock() {   # путь замка, о чём говорить человеку
    if ! mkdir "$1" 2>/dev/null; then
        _lp=$(cat "$1/pid" 2>/dev/null || true)
        # Хозяин только что сделал mkdir и ещё не записал метку и pid: в эту
        # долю секунды замок неотличим от чужого и от брошенного, и второй
        # претендент снимал его силой. Секунда на перечитывание.
        if [ ! -f "$1/byway" ] || [ -z "$_lp" ]; then
            sleep 1
            _lp=$(cat "$1/pid" 2>/dev/null || true)
        fi
        # Замок без нашей метки -- чужой. Не ждём: он может не уйти никогда, а
        # цена ожидания -- дом без резолвера.
        if [ ! -f "$1/byway" ]; then
            warnf "замок «%s» поставлен не byway -- снят принудительно" "$2"
            rm -rf "$1" 2>/dev/null || true
            mkdir "$1" 2>/dev/null || return 1
            : > "$1/byway" 2>/dev/null || true
            echo $$ > "$1/pid" 2>/dev/null || true
            return 0
        fi
        if [ -z "$_lp" ] || [ ! -d "/proc/$_lp" ]; then
            warnf "замок «%s» остался от прерванного прогона -- снят" "$2"
            rm -rf "$1" 2>/dev/null || true
            mkdir "$1" 2>/dev/null || return 1
        else
            warnf "%s уже идёт -- ожидание" "$2"
            _w=0
            while [ -d "$1" ] && [ "$_w" -lt 30 ]; do sleep 1; _w=$((_w + 1)); done
            mkdir "$1" 2>/dev/null || return 1
        fi
    fi
    : > "$1/byway" 2>/dev/null || true
    echo $$ > "$1/pid" 2>/dev/null || true
    return 0
}

# Значение, уходящее в текст правил nft: не подошло образцу -- умолчание и
# слово вслух. Настройки приходят чужой выгрузкой (EXPORT_KEYS), и значение
# вида `0x1 ; chain … accept` поставило бы свои правила firewall от root при
# каждом plumb on; `nft -c` не защита, он проверяет только синтаксис.
# Предупреждение в stderr: stdout уходит прямо в `nft -f -`.
val_or() {   # имя, значение, образец, умолчание, куда идёт
    [ -n "$2" ] || { printf '%s' "$4"; return 0; }
    # grep судит построчно: значение с годной первой строкой и переводом
    # строки проходило, и вторая строка попадала в правила nft и конфиги.
    case "$2" in
      *[[:cntrl:]]*)
        warnf "настройка %s содержит управляющие знаки и не годится для %s, взято %s" "$1" "$5" "$4" >&2
        printf '%s' "$4"; return 0 ;;
    esac
    if printf '%s' "$2" | grep -qE "$3"; then
        printf '%s' "$2"
    else
        warnf "настройка %s = «%s» не годится для %s, взято %s" "$1" "$2" "$5" "$4" >&2
        printf '%s' "$4"
    fi
}

nft_val() { val_or "$1" "$2" "$3" "$4" "$(_t 'правил nft')"; }

_len() {
    _lb=$(printf '%s' "$1" | wc -c)
    _lc=$(printf '%s' "$1" | tr -dc '\200-\277' | wc -c)
    echo $((_lb - _lc))
}

# Загрузки, которые обязаны пройти и при сломанном туннеле: net_get пробует
# прокси-вход, потом напрямую, потом адреса GitHub из DoH. a_of -- адрес имени.

# Имя -> адрес IPv4; $2 -- резолвер вместо системного. sed отрезает шапку с
# адресом самого резолвера (там тоже «Address», и он первый).
a_of() {   # $1 -- имя, $2 -- резолвер или пусто
    nslookup "$1" ${2:+"$2"} 2>/dev/null | sed -n '/^Name:/,$p' |
      awk '/^Address/ {print $NF}' |
      grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -1
}

# Все адреса имени: у имени с несколькими A-записями (round-robin) порядок
# ответов меняется от запроса к запросу.
a_all() {   # $1 -- имя, $2 -- резолвер или пусто
    nslookup "$1" ${2:+"$2"} 2>/dev/null | sed -n '/^Name:/,$p' |
      awk '/^Address/ {print $NF}' |
      grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || true
}

# Адрес имени по DoH, запросом К АДРЕСУ, не к имени: при сломанном туннеле
# локальный DNS отдаёт подставной адрес на всё из списка, и GitHub не достать.
# Тот же приём в install.sh (doh_a).
doh_a() {   # 1 -- имя
    for _dq in "https://8.8.8.8/resolve?name=$1&type=A" \
               "https://1.1.1.1/dns-query?name=$1&type=A"; do
        _da=$(curl -fsSL --max-time 8 -H "accept: application/dns-json" "$_dq" 2>/dev/null |
              tr ',' '\n' | sed -n 's/.*"data":"\([0-9][0-9.]*\)".*/\1/p' | head -1)
        case "$_da" in
          [0-9]*.[0-9]*.[0-9]*.[0-9]*) printf '%s' "$_da"; return 0 ;;
        esac
    done
    return 1
}

# --resolve для имён GitHub (и переадресаций выпусков), один раз за запуск.
gh_resolve() {
    [ "${GH_RES_DONE:-0}" = 1 ] && return 0
    GH_RES_DONE=1; GH_RES=""
    for _gh in github.com api.github.com raw.githubusercontent.com codeload.github.com \
               objects.githubusercontent.com release-assets.githubusercontent.com; do
        _gi=$(doh_a "$_gh") || continue
        GH_RES="$GH_RES --resolve $_gh:443:$_gi"
    done
}

# Порядок: прокси-вход, напрямую, напрямую с адресами GitHub из DoH.
net_get() {   # аргументы curl как есть
    _npx=$(u local_proxy_port); _npx=${_npx:-1603}
    curl -fsSL -A "Mozilla/5.0" --proxy "http://127.0.0.1:$_npx" "$@" 2>/dev/null && return 0
    curl -fsSL -A "Mozilla/5.0" "$@" 2>/dev/null && return 0
    gh_resolve
    [ -n "$GH_RES" ] || return 1
    # shellcheck disable=SC2086
    curl -fsSL -A "Mozilla/5.0" $GH_RES "$@" 2>/dev/null
}

# Разбор ключа (vless, vmess, trojan, ss, socks, hysteria2, wireguard) в
# переменные N_*. Сам разборщик -- uc/keys.uc (parse_key), вызов -- bw_uc parse.

parse_node() {
    # Режим «свой конфиг»: вставлен готовый кусок JSON Xray, разбирать нечего
    # (аналог Outbound Config у podkop).
    N_RAW=""
    if [ -z "${1:-}" ] && [ "$(u conn_mode)" = "outbound" ]; then
        N_RAW=$(u outbound_json)
        [ -n "$N_RAW" ] || die "выбран свой конфиг, но он пуст"
        # Только один JSON-объект: в конфиг движка он идёт разобранным и
        # собранным заново (proxy_block), склейка текста дописывала туда
        # чужие ключи верхнего уровня.
        bw_uc rawok ||
            die "свой конфиг — не один JSON-объект аутбаунда: проверить скобки и кавычки"
        N_PROTO=raw
        N_LABEL=$(u conn_label)
        [ -n "$N_LABEL" ] || N_LABEL=$(_t 'свой конфиг')
        N_TYPE="-"; N_SEC="-"; N_HOST="-"; N_PORT=0
        return 0
    fi

    URL=${1:-$(u node_url)}
    [ -n "$URL" ] || die "ключ не задан"

    # Разбор -- в ucode, на выходе команды sh: присваивания и те же
    # warn/dief, что печатал разбор на sh. eval -- только вывода parse_uc,
    # значения в нём в одинарных кавычках.
    _pn=$(BW_URL=$URL BW_SNI=${N_SNI:-} BW_WSHOST=${N_WSHOST:-}; export BW_URL BW_SNI BW_WSHOST
          parse_uc) || die "ключ не разобрался: сбой разборщика (ucode)"
    eval "$_pn"

    # Шифрование VLESS (mlkem768x25519plus) -- с Xray-core 25.8.29; форму уже
    # проверил parse_uc, разбор частей -- за ядром (run -test).
    if [ -n "$N_ENC" ] && [ "$N_ENC" != "none" ]; then
        xray_ver_num >/dev/null
        if [ "$XRAYVER" -lt 250829 ]; then
            dief "шифрование VLESS (encryption=mlkem768x25519plus) появилось в Xray-core 25.8.29, а стоит %s — обновить: byway engine tested" \
                 "$("$XRAY" version 2>/dev/null | head -1 | cut -d' ' -f2)"
        fi
    fi

    # Порт идёт в JSON числом без кавычек.
    port_ok "$N_PORT" || dief "порт в ссылке недопустим: %s" "$N_PORT"
}

# Разборщик ссылки на ucode: ссылка -- в BW_URL, на выход -- команды sh.
# Значения из ссылки уходят в конфиг внутрь строк JSON, поэтому кавычка,
# обратная косая и управляющие знаки в них -- отказ (node_json_ok): иначе
# ссылка дописывает в конфиг свои поля (sni=a.com%22%2C%22allowInsecure%22…).
# Ключи приходят из подписок и чужих каналов -- источник не доверенный.
# Подстановка $(...) в прежнем разборе срезала хвостовые переводы строки --
# nl() повторяет это, чтобы поведение не разошлось.
parse_uc() {
    bw_uc parse
}

# Адреса и метка для сторожа и проверок: DNS-вход, пул fakeip, метка обвязки.

# Адрес DNS-входа с умолчанием: поле в панели можно очистить, а голое `u
# dns_listen` тогда пусто -- сторож каждые 5 минут пересобирает обвязку, а
# dns_down не возвращает резолвер провайдеру.
dns_addr() {
    _da=$(u dns_listen)
    printf '%s' "${_da:-127.0.0.42}"
}

# Годится ли пул по смыслу, а не только по форме. Пул в приватном диапазоне
# мёртв молча: цепочка nft отсекает приватное первым правилом, блокировка Xray
# его перечисляет, rebind_protection dnsmasq вырезает его из ответов, а проба
# plumb on спрашивает движок напрямую и проходит. Пул уже списка -- выдача идёт
# по кругу, и соединение уходит на чужой домен.
pool_sane() {   # 1 -- пул вида a.b.c.d/len
    _pn=${1%/*}; _pl=${1#*/}
    case "$_pl" in ''|*[!0-9]*) warn "пул $1 без длины маски -- взято умолчание" >&2; return 1 ;; esac
    if [ "$_pl" -lt 8 ] || [ "$_pl" -gt 30 ]; then
        warnf "пул %s: маска /%s не годится -- взято умолчание" "$1" "$_pl" >&2
        return 1
    fi
    # Сравнение по первому октету (172, 169, 192, 100 -- по второму): опасные
    # диапазоны выровнены по октету.
    _o1=${_pn%%.*}; _r=${_pn#*.}; _o2=${_r%%.*}
    # 240.0.0.0/4 -- весь диапазон 240-255, а не края. Список тот же, что в
    # RESERVED и в правиле блокировки движка: править все три вместе.
    case "$_o1" in
      0|10|127|22[4-9]|23[0-9]|24[0-9]|25[0-5])
        warnf "пул %s лежит в приватном или зарезервированном -- он мёртв: цепочка nft отсекает такие адреса первым же правилом" "$1" >&2
        return 1 ;;
      172) [ "$_o2" -ge 16 ] && [ "$_o2" -le 31 ] && {
             warnf "пул %s лежит в 172.16/12 -- он мёртв" "$1" >&2; return 1; } ;;
      192) [ "$_o2" = 168 ] && {
             warnf "пул %s лежит в 192.168/16 -- он мёртв" "$1" >&2; return 1; } ;;
      169) [ "$_o2" = 254 ] && {
             warnf "пул %s лежит в 169.254/16 -- он мёртв" "$1" >&2; return 1; } ;;
      100) [ "$_o2" -ge 64 ] && [ "$_o2" -le 127 ] && {
             warnf "пул %s лежит в 100.64/10 -- он мёртв" "$1" >&2; return 1; } ;;
    esac
    return 0
}

# Действующие пул, метка и мосты -- одно значение для конфига движка, правил
# nft, ip rule, запрета и проверок. Каждый читал своё: при негодной настройке
# движок раздавал один пул, nft ловил другой, проверки искали третий, а ip
# rule искал метку не в том виде, в каком её печатает ядро. Аргумент
# «loud» -- предупреждать о негодной настройке (сборка конфига и правил).
eff_pool() {
    if [ "${1:-}" = loud ]; then
        _ep=$(val_or fakeip_pool "$(u fakeip_pool)" '^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$' 198.18.0.0/15 "$(_t 'конфига движка')")
        pool_sane "$_ep" || _ep=198.18.0.0/15
    else
        _ep=$(val_or fakeip_pool "$(u fakeip_pool)" '^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$' 198.18.0.0/15 "" 2>/dev/null)
        pool_sane "$_ep" 2>/dev/null || _ep=198.18.0.0/15
    fi
    printf '%s' "$_ep"
}
eff_mark() {
    if [ "${1:-}" = loud ]; then
        _em=$(nft_val mark "$(u mark)" '^0x[0-9a-fA-F]{1,8}$' 0x100000)
    else
        _em=$(nft_val mark "$(u mark)" '^0x[0-9a-fA-F]{1,8}$' 0x100000 2>/dev/null)
    fi
    # Как печатает ip rule show: строчными, без ведущих нулей.
    printf '0x%x' "$((_em))"
}

# Образец адреса из пула -- по всему пулу, а не по двум первым октетам: пул
# шире /16 давал ложное «движок не отвечает» на трёх адресах из четырёх.
# Без якоря слева: потребитель сам ставит ^ перед адресом.
fakeip_re() {
    eff_pool | awk -F'[./]' '{
        l = $5 + 0; o[1] = $1; o[2] = $2; o[3] = $3; o[4] = $4
        full = int(l / 8); rem = l % 8; re = ""
        for (i = 1; i <= full; i++) re = re o[i] "\\."
        if (rem > 0) {
            sz = 2 ^ (8 - rem); b = int(o[full + 1] / sz) * sz; alt = ""
            for (v = b; v < b + sz; v++) alt = alt (alt == "" ? "" : "|") v
            re = re "(" alt ")" (full == 3 ? "([^0-9]|$)" : "\\.")
        }
        printf "%s", re
    }'
}

# Аутбаунды собирает ucode (uc/outbound.uc) для gen, check и probe; здесь --
# метка сокетов.

# Метка исходящих для «VPN для программ на роутере» -- числом (uc/plumb.uc,
# та же, что в правилах nft).
ob_env_mark() {
    if [ "$(u router_via_vpn)" = "1" ]; then bw_uc selfmark; fi
}

# Сборка конфига Xray: cmd_gen готовит окружение, конфиг собирает ucode
# (uc/gen.uc). $OUT меняется, только если ядро приняло конфиг (run -test).

cmd_gen() {
    # Замок: панель и cron могут позвать gen одновременно, а черновик один.
    _lock=/var/run/byway-gen.lock
    take_lock "$_lock" "$(_t 'сборка конфига')" || die "другая сборка конфига не закончилась за 30 секунд"
    # Ловушка снимает замок на любом выходе, в том числе на отказе ucode.
    # INT/TERM -- выйти (EXIT снимет).
    trap 'rm -rf "$_lock" 2>/dev/null; true' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    [ -f "$CONF" ] || dief "нет %s" "$CONF"
    [ -x "$XRAY" ] || die "xray не найден"
    mkdir -p "$LISTS"
    # Каталог root для журнала обращений и рабочих файлов stat: в общем /tmp
    # движок не от root (ujail) мог бы занять имя заранее (Д-7).
    [ -d /var/run/byway ] || { mkdir -p /var/run/byway && chmod 755 /var/run/byway; } 2>/dev/null || true
    # Список негодных строк -- до сборки списков и направлений.
    : > "$BADLIST" 2>/dev/null || true

    # Слияние списков с пресетами и метка сокетов -- пока на shell (списки,
    # перехват): ucode получает готовое.
    D=$LISTS/domains.lst
    S=$(merged_subnets)
    MERGED=$(merged_domains)
    xray_ver_num >/dev/null
    _gm=$(ob_env_mark)
    _grc=0
    BW_OUT=$OUT BW_LISTS=$LISTS BW_ROUTES=$ROUTES_DIR BW_MERGED=$MERGED BW_SUBNETS=$S \
    BW_BADLIST=$BADLIST BW_ACCESS=$ACCESS BW_PROBE=$PROBE_DOMAIN BW_POOL6_DEF=$POOL6_DEF \
    BW_XRAY=$XRAY BW_XRAYVER=$XRAYVER BW_SELFMARK=$_gm \
        bw_uc gen || _grc=$?
    rm -rf "$_lock" 2>/dev/null || true
    [ "$_grc" = 0 ] || exit "$_grc"
}

# Настоящий адрес сервера для DNS через туннель. Местный резолвер в этом
# режиме отдаёт адрес из прежнего конфига (hosts), смена адреса не увиделась
# бы: сперва пин /etc/hosts, потом внешние резолверы, потом местный.
server_addr() {   # $1 -- имя
    _sa=$(awk -v n="$1" '$1 !~ /^#/ { for (i = 2; i <= NF; i++) if ($i == n) { print $1; exit } }' \
          /etc/hosts 2>/dev/null | grep -E '^[0-9]+(\.[0-9]+){3}$' | head -1)
    [ -n "$_sa" ] || _sa=$(a_of "$1" 8.8.8.8)
    [ -n "$_sa" ] || _sa=$(a_of "$1" 1.1.1.1)
    [ -n "$_sa" ] || _sa=$(a_of "$1")
    printf '%s' "$_sa"
}

# Проверки ключа без боевого конфига: check (разбор и run -test) и probe
# (соединение через ноду) -- в ucode (uc/probe.uc). Здесь окружение и уборка:
# ucode сигналы не ловит, и прерванная проба оставила бы движок и черновик с uuid.

pr_env() {
    xray_ver_num >/dev/null
    PR_MARK=$(ob_env_mark)
}

cmd_check() {
    pr_env
    BW_XRAY=$XRAY BW_XRAYVER=$XRAYVER BW_SELFMARK=$PR_MARK bw_uc check "$@"
}

# PROBE_URL -- проверить через ноду конкретный сайт, а не только выход;
# PROBE_PORT -- порт временного socks-входа. --all -- каждый ключ автовыбора.
cmd_probe() {
    trap '_pp=$(cat /var/run/byway/probe.pid 2>/dev/null || true)
          [ -z "$_pp" ] || kill "$_pp" 2>/dev/null || true
          rm -f /var/run/byway/probe.pid 2>/dev/null || true
          for _pf in /tmp/byway-probe.json /tmp/byway-probe.log /tmp/byway-probe.out; do
              [ ! -f "$_pf" ] || : > "$_pf"
          done' EXIT INT TERM
    pr_env
    BW_XRAY=$XRAY BW_XRAYVER=$XRAYVER BW_SELFMARK=$PR_MARK bw_uc probe "$@"
}

# Показ собранного конфига без секретов -- в ucode (uc/probe.uc, cmd_show);
# счётчики -- по объединённым спискам, их склейка пока на shell.

cmd_show() {
    BW_OUT=$OUT BW_MERGED=$(merged_domains) BW_SUBNETS=$(merged_subnets) bw_uc show
}

# Общие списки доменов и подсетей: свои + готовые наборы, склейка и чистка.

# Записи, не прошедшие проверку формы при сборке, откладываются сюда и
# называются вслух: молча выкинуть часть чужого списка -- оставить гадать,
# почему домен не работает.
BADLIST=/tmp/byway-bad-entries

# Записи списка, которые можно спросить у резолвера: без regexp:/keyword:
# (по ним nslookup не отвечает, и проба на одной такой строке объявила бы отказ
# исправному туннелю) и без префиксов domain:/full:. return 0 нужен: grep без
# совпадений даёт 1, а `_d=$(plain_domains …)` под set -e на нём молча умирает.
plain_domains() {
    grep -vE '^[[:space:]]*(//|#|$)' "$1" 2>/dev/null | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' |
      sed -e 's/^domain://' -e 's/^full://' |
      grep -E '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' |
      grep -E '\.([A-Za-z][A-Za-z]+|xn--[A-Za-z0-9-]+)$' || true
    return 0
}

# Склейка свой + направления + пресеты, одним файлом без повторов (отдаётся
# путь) -- в ucode (uc/merge.uc, кэш с подписью). Читают сборка конфига, nft,
# запрет и проверки -- все видят одно и то же.
merged_env() {
    BW_LISTS=$LISTS BW_ROUTES=$ROUTES_DIR BW_PRESETS=$PRESETS_DIR BW_BADLIST=$BADLIST bw_uc merged "$1"
}
merged_subnets() { merged_env subnets; }
merged_domains() { merged_env domains; }

# Готовые наборы (presets): загрузка, проверка, пересечения -- в ucode
# (uc/presets.uc). Каталог -- здесь: его читают склейка, doctor, экспорт.
PRESETS_DIR=$LISTS/presets

cmd_presets() {
    BW_LISTS=$LISTS BW_ROUTES=$ROUTES_DIR BW_PRESETS=$PRESETS_DIR BW_BADLIST=$BADLIST bw_uc presets
}

# Направления: свои списки со своим ключом выхода. Домены и подсети из
# /etc/byway/routes/<имя>.lst уходят в ноду с этой меткой ключа (метка -- в
# секции UCI, ссылка -- из node_urls). Читают их ucode-части (gen, merge,
# doctor, transfer); здесь -- только каталог.
ROUTES_DIR=$LISTS/routes

# Подписка: загрузка и вывод ключей построчно -- в ucode (uc/presets.uc,
# cmd_sub). Адрес -- окружением: аргументы видны всем в /proc/*/cmdline.

cmd_sub() {
    BW_SUB_URL=${1:-} bw_uc sub
}

# Перехват (nft, маршрут, dnsmasq, запрет «не пускать мимо VPN») -- в ucode
# (uc/plumb.uc). Здесь замок и снятие по сигналу, имена, которые читают
# сторож и проверки (service/*), и обёртки команд.

TABLE=byway
RT_TABLE=100
BLOCK_MARK=/tmp/byway-blocked
# Умолчание пула IPv6 для конфига движка -- константа Xray (fakedns.go).
POOL6_DEF="fc00::/18"

# Образец ip rule по fwmark и таблице (сторож считает правила). Конец
# закреплён: «lookup 100» совпадает и с «lookup 1000».
rule_re() {
    _rm=$(eff_mark)
    printf 'fwmark %s(/%s)?[[:space:]]+lookup %s([[:space:]]|$)' "$_rm" "$_rm" "$RT_TABLE"
}

plumb_env() {
    BW_OUT=$OUT BW_LISTS=$LISTS BW_ROUTES=$ROUTES_DIR BW_PRESETS=$PRESETS_DIR \
    BW_BADLIST=$BADLIST BW_PKGFIX=$PKG_FIX BW_VERSION=$BYWAY_VERSION BW_LANG=$BW_LANG "$@"
}

# cmd_plumb on|off|close -- единственный вход для службы и сторожа, под
# замком: у перехвата пять хозяев (старт службы, её фоновый цикл до 65 с,
# reload, сторож из cron, консоль). return, а не die: cmd_watch зовёт через
# `if`, exit оборвал бы весь прогон сторожа.
cmd_plumb() {
    _plock=/var/run/byway-plumb.lock
    take_lock "$_plock" "$(_t 'настройка перехвата')" || {
        warn "перехват уже настраивается другим запуском -- пропущено"
        return 1
    }
    # ucode -- фоном, и shell ждёт его через wait: по INT/TERM (stop_service
    # убивает идущий подъём, чтобы тот не ставил перехват поверх снятого)
    # ловушка гасит его. Ждал бы shell ucode напрямую -- ловушка сработала бы
    # только после конца подъёма.
    _ppid=""
    trap 'rm -rf "$_plock" 2>/dev/null; true' EXIT
    trap '[ -n "$_ppid" ] && kill "$_ppid" 2>/dev/null; rm -rf "$_plock" 2>/dev/null; exit 143' INT TERM
    # Простой командой, не через plumb_env: фоном функция идёт подоболочкой,
    # $! -- её номер, и kill оставлял ucode доделывать подъём.
    bw_uc_prep
    BW_OUT=$OUT BW_LISTS=$LISTS BW_ROUTES=$ROUTES_DIR BW_PRESETS=$PRESETS_DIR \
    BW_BADLIST=$BADLIST BW_PKGFIX=$PKG_FIX BW_VERSION=$BYWAY_VERSION BW_LANG=$BW_LANG \
        ucode $BW_UCRUN plumb "$@" &
    _ppid=$!
    _prc=0
    wait "$_ppid" || _prc=$?
    _ppid=""
    rm -rf "$_plock" 2>/dev/null || true
    return "$_prc"
}

