        # конфиг отвергает, и человек, который поставил byway и ещё не наполнил
        # список, получает отказ вместо работающей программы.
        # Через ФАЙЛ, а не через переменную, и это про память.
        #
        # Список доменов печатается в конфиг дважды, и ОБА раза через файл:
        # первый в fakedns выше, второй -- здесь. Вторая копия целиком материализовалась в
        # переменной оболочки только ради проверки на пустоту. На курируемом
        # списке это 49 КБ и не беда; на потолке пресета в 200 000 доменов --
        # 9,5 МБ в переменной ash при пике подстановки вдвое больше, на роутере
        # с 240 МБ памяти, где рядом уже работает Xray и собирается конфиг в
        # tmpfs. Убийца OOM выбрал бы самый крупный процесс -- то есть живой
        # движок, на чей DNS-вход уведён весь резолв дома.
        _djf=/tmp/byway-dom.json
        list_to_json "$MAINDOM" "domain:" > "$_djf" 2>/dev/null || : > "$_djf"
