              '^[0-9a-fA-F:]+/[0-9]{1,3}$' "$POOL6_DEF" "$(_t 'конфига движка')")
        FAKEDNS6=", { \"ipPool\": \"$_p6\", \"poolSize\": $POOL_SIZE }"
        QSTRAT=UseIP
