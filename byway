// Перевод сообщения init-скрипта: формат и доводы, как shell printf --
// формат приходит из командной строки с \n двумя знаками.
function cmd_xlat(fmt, ...args) {
	let s = _t(fmt ?? '');
	s = replace(replace(replace(s, '\\n', '\n'), '\\t', '\t'), '\\\\', '\\');
	print(_pf(s, args));
}

