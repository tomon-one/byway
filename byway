      cat <<HEAD
{
  "log": { "loglevel": "$LOGLVL"$ACCESSLOG },

  "fakedns": [ { "ipPool": "$POOL", "poolSize": $POOL_SIZE }$FAKEDNS6 ],

  "dns": {
    $DNSHOSTS
    "servers": [$DNSBOOT
