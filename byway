        # соединение к ноде, Xray должен узнать её адрес; запрос на это ушёл
        # бы в тот же туннель, которого ещё нет. Соединение не встаёт никогда,
        # и выглядит это как «просто не работает», без единой ошибки.
        #
        # Поэтому адрес ноды разрешается ЗДЕСЬ, при сборке, и кладётся в
        # конфиг статически. Плата названа в панели: сменился адрес ноды --
        # нужна пересборка. Ключ, заданный адресом, а не именем, этого не
        # требует вовсе.
        _hh=""
        for _h in $VPN_HOSTS; do
            case "$_h" in *[a-zA-Z]*) ;; *) continue ;; esac
            # ⚠️ Три попытки, и первая обязана иметь запасные. Системный
            # резолвер на пути перезапуска указывает НА НАШ ВХОД: restart
            # оставляет его на месте намеренно (BYWAY_KEEP_DNS), а движок в
            # этот момент уже остановлен -- спрашивать там некого. Прежде тут
            # стоял один nslookup и сразу dief: gen падал, start_service
            # поднимался на ПРЕЖНЕМ конфиге, а plumb on клал правила по НОВЫМ
            # настройкам. Половины расходились молча -- движок на старом
            # порту, tproxy заворачивает на новый, сайты не открываются, а
            # проба plumb on успешна и status с health зелёные.
            _ip=$(a_of "$_h")
            # Мимо dnsmasq вовсе: наружу роутер ходит, сломан только вход.
            [ -n "$_ip" ] || _ip=$(a_of "$_h" 8.8.8.8)
            # Последняя опора -- адрес из прежнего конфига. Он мог устареть,
            # но устаревший адрес лучше несобравшегося конфига: пересборка при
            # переезде сервера и так названа платой в панели.
            [ -n "$_ip" ] || _ip=$(sed -n 's/.*"'"$_h"'"[[:space:]]*:[[:space:]]*"\([0-9.]*\)".*/\1/p' \
                                   "$OUT" 2>/dev/null | head -1)
            [ -n "$_ip" ] || dief "адрес сервера %s не разрешился — без него DNS через туннель не собрать (запросы к серверу ушли бы в сам туннель); проверить интернет и DNS роутера" "$_h"
            _hh="$_hh${_hh:+, }\"$_h\": \"$_ip\""
        done
        [ -n "$_hh" ] && DNSHOSTS="\"hosts\": { $_hh },"
        DNSTAG=', "tag": "dns-query"'
        # Перевод строки внутри значения, а не в шаблоне: пустая настройка
        # оставляла бы в конфиге пустую строку посреди массива правил.
        DNSRULE='
      { "type": "field", "inboundTag": [ "dns-query" ], '"$PROXY_TARGET"' },'
    fi

