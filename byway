#!/bin/sh
# Собран из src/ (порядок -- src/ORDER) командой src/build.sh -- правка здесь пропадёт при сборке.
#
# byway -- раздельное туннелирование на OpenWrt, ядро Xray (замена podkop).
# Путь трафика: dnsmasq -> DNS-вход Xray -> FakeDNS отдаёт адрес из пула для
# доменов списка -> nft метит трафик на этот пул в tproxy -> вход Xray со
# сниффингом достаёт исходный домен -> правило маршрутизации шлёт его в
# аутбаунд ключа. Всё прочее идёт напрямую.
# Списки -- файлы в /etc/byway, а не инлайн в UCI: правка файла действует
# после `byway gen`. Службой управляет /etc/init.d/byway, он и зовёт plumb
# (nft, маршрут, dnsmasq). Список команд печатает `byway` без аргументов
# (ui/main.sh).

set -e

# Версия -- вручную, В МОМЕНТ ВЫПУСКА: main идёт впереди тега, номер на нём --
# последнего выпуска. Иначе README ссылается на тег, которого нет, и
# установка одной строкой отвечает 404.
# Имя -- опознавательный знак сборки, одно английское на все языки, не
# переводить. Ряд по минорам: 0.0 Desire Path, 0.1 Portage, 0.2 Causeway,
# 0.3 Ford, 0.4 Ice Road, 0.5 Trail, 0.6 Bypass, 0.7 Country Lane, 0.8 Old
# Road.
# Автообновление ходит только внутри минорной версии (cmd_watch).
BYWAY_NUM="0.3.0"
BYWAY_NAME="Ford"
BYWAY_VERSION="$BYWAY_NUM ($BYWAY_NAME)"
# Откуда берутся обновления; чужая сборка меняет одно место.
BYWAY_REPO="tomon-one/byway"
# Открытый ключ подписи выпусков (usign/signify, byway-release.pub): им
# byway update и установщик проверяют SHA256SUMS выпуска. Тот же -- в
# install.sh (BYWAY_PUBKEY), править парой.
BYWAY_PUBKEY="RWQ9r7vQihS1LvQHytsWrPqBkUalRDrj6JBUInbi7KXlUUPHBMzFmvJl"
# Версия Xray-core, на которой byway прогнан целиком: её ставит `byway engine
# tested`. Та же в install.sh (XRAY_TESTED) -- править парой.
XRAY_TESTED=26.10.17
# Суммы SHA2-256 архивов этой версии по сборкам: .dgst лежит рядом с архивом
# на GitHub, а эти -- в подписанном выпуске byway. Вписывает
# scripts/pc/xray-sums.py; тот же блок -- в install.sh.
XRAY_TESTED_SUMS="linux-32=b19b563d43f151f017e4a3227d2320c6ffb1c1a61f11b3c08b9e25bf940100af
linux-64=ecdd54eccd24c4c21a8f00968e7dbf7f5996da92383d2321170b560dc4a95158
linux-arm32-v6=6726ffaab314010c48d421d8bc5122d79e72d27d3a82b3aaa2d1c5e5b94a2e99
linux-arm32-v7a=3c5339ba4a14ebad74df26e6ad935c215f5be615684f139a78d3dff8cbf6e7e4
linux-arm64-v8a=4ebdad86048fa499e65334f88a120b1ed17e662f1c222afd3514afdf8820cdb1
linux-mips32=fd806063824f5abdf5fc72ff4a6e94537b0d5900923886a018ec21100c39893b
linux-mips32le=9ad6e49a48b55a71ec2976f3893f506cd96f11ae4ac672b28f179adff5a25a11
linux-mips64=9e4a8d22283480fe8c8edb56d2b105dd3da23929c8503c1fb40ae4112468a2ca
linux-mips64le=a3dc732d441d80698ca3fce8b52b64cf0384ee6ed61ebfba41ae75b98b4fad18
linux-riscv64=e63ce4ba33f9401fe25fc9244228702388e079bba00ec44aca6011aa81b910de"

CONF=/etc/config/byway
LISTS=/etc/byway
OUT=$LISTS/config.json
# Журнал обращений движка -- свой файл в памяти, не syslog: сотня строк в
# минуту вытесняет из кольца в 256 КБ всё остальное за 20 минут. Усекают
# cmd_stat и сторож cmd_watch. Каталог -- root 755 (init): файл пишет движок
# от byway, но заменить его ссылкой не может -- в общем /tmp подменённый на
# ссылку журнал root обрезал бы и отдавал chown'ом по ссылке.
ACCESS=/var/run/byway/access.log
# apk с OpenWrt 25.12, opkg на прежних: подсказка не должна давать
# команду чужого менеджера.
PKG_FIX="apk update && apk add"
if ! command -v apk >/dev/null 2>&1 && command -v opkg >/dev/null 2>&1; then
    PKG_FIX="opkg update && opkg install"
fi

# Вывод и журнал: say/warn/die и их формы с подстановками (f), logt/logf
# в syslog. Строка печатается через перевод (_t).

_say()  { printf '\033[1;32m[*]\033[0m %s\n' "$1"; }

_warn() { printf '\033[1;33m[!]\033[0m %s\n' "$1"; }

die_raw() { printf '\033[1;31m[x]\033[0m %s\n' "$1"; exit 1; }

# Вторые (sayf, warnf, dief) переводят ФОРМАТ, а не готовый текст:
# подставленное значение в словаре не найдётся, и строка осталась бы русской.
say()   { _say  "$(_t "$1")"; }

warn()  { _warn "$(_t "$1")"; }

die()   { die_raw "$(_t "$1")"; }

sayf()  { _fmt=$(_t "$1"); shift; _say    "$(printf "$_fmt" "$@")"; }

warnf() { _fmt=$(_t "$1"); shift; _warn   "$(printf "$_fmt" "$@")"; }

dief()  { _fmt=$(_t "$1"); shift; die_raw "$(printf "$_fmt" "$@")"; }

# Журнал системы читает тот же человек, что и экран; обёртки не дают забыть
# перевод строк logger.
logt()  { logger -t byway "$(_t "$1")"; }

logf()  { _lfm=$(_t "$1"); shift; logger -t byway "$(printf "$_lfm" "$@")"; }

# Чтение настроек byway из UCI.

# || true структурный: uci -q get на незаданной опции даёт 1, и VAR=$(u x) под
# set -e молча убивает скрипт. Закрыто здесь для всех опций сразу.
u() { uci -q get "byway.main.$1" || true; }

# Перевод: язык из UCI, словарь lang/<язык>.tsv, _t и _f.

# ── язык вывода ────────────────────────────────────────────────────────────
# Русские строки в коде -- ключ; перевод -- файл «ключ<TAB>перевод» на язык.
# Язык добавляется без правки кода, пропущенная строка остаётся русской, а не
# пустой. gettext не годится: его нет в busybox, панели нужен был бы пакет.
BW_LANG=$(u lang)
# Только две строчные буквы: из значения строится путь к словарю, а строки
# словаря становятся форматами printf. Опцию пишут и панель, и импорт.
case "$BW_LANG" in [a-z][a-z]) ;; *) BW_LANG=ru ;; esac

LANGDIR=$LISTS/lang

TAB=$(printf '\t')

_t() {
    [ "$BW_LANG" = "ru" ] && { printf '%s' "$1"; return 0; }
    _tf=$LANGDIR/$BW_LANG.tsv
    [ -f "$_tf" ] || { printf '%s' "$1"; return 0; }
    # index()==1, а не grep -F: тот ищет подстроку где угодно, и короткий ключ
    # совпадал внутри длинного. Ключ -- в начале строки, до табуляции.
    # Ключ через ENVIRON, не -v: -v разворачивает escape-последовательности, и
    # ключи с переводом строки не находились.
    _tv=$(BW_K="$1$TAB" awk 'index($0, ENVIRON["BW_K"]) == 1 { print substr($0, length(ENVIRON["BW_K"]) + 1); exit }' "$_tf" 2>/dev/null || true)
    printf '%s' "${_tv:-$1}"
}

# ── проверка окружения ─────────────────────────────────────────────────────
# _f -- формат с подстановками там, где перевод нужен, а обёртки say нет.
# Двойной перевод безвреден: готовая строка в словаре не найдётся.
_f() { _fm=$(_t "$1"); shift; printf "$_fm" "$@"; }

# Часть byway на ucode (переход с shell по группам команд, план
# docs/plans/2026-10-16-improvements.md): программа -- в конце этого же файла,
# между метками #@uc-begin и #@uc-end.

# ucode читает программу только из файла, который можно перематывать:
# конвейер падает на 25.12 («Invalid seek»), /dev/fd нет на 22.03 (стенды
# 2026-10-16). Поэтому она вырезается в файл -- заново, когда сменился сам
# byway (inode, размер, время). /var/run, а не /var/run/byway: файл исполняет
# root, и каталог, куда пишет кто-то ещё, дал бы подменить программу.
# BW_SELF -- путь к byway: стенды подгружают его кусок под другим именем.
BW_SELF=${BW_SELF:-}
BW_UCF=/var/run/byway.uc
# Скомпилированная (ucode -c): разбор 260 КБ исходника стоит ~0,15 с на
# роутере при каждом вызове, байткод грузится впятеро быстрее (стенд
# 2026-10-18). Строгий режим (-S) задаётся при компиляции. Не скомпилировалась
# -- идёт исходник.
BW_UCC=/var/run/byway.ucc

bw_uc_prep() {
    [ -n "$BW_SELF" ] || BW_SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
    _ust=$(ls -lni "$BW_SELF" 2>/dev/null || true)
    if [ -z "$_ust" ] || [ "$(head -n 1 "$BW_UCF" 2>/dev/null)" != "// $_ust" ]; then
        # Без своей части файл -- не byway (стенд подгрузил кусок под чужим
        # именем): пустая программа молча отдала бы пустой вывод.
        grep -q '^#@uc-begin$' "$BW_SELF" 2>/dev/null ||
            die "часть byway на ucode не извлечена в /var/run"
        # Байткод прежней версии -- прочь ДО подмены исходника: параллельный
        # вызов увидел бы новый исходник и запустил старый байткод.
        rm -f "$BW_UCC" 2>/dev/null || true
        { printf '// %s\n' "$_ust"
          sed -n '/^#@uc-begin$/,/^#@uc-end$/{/^#@uc-/d;p}' "$BW_SELF"; } > "$BW_UCF.$$" &&
            mv "$BW_UCF.$$" "$BW_UCF" || {
                rm -f "$BW_UCF.$$" 2>/dev/null || true
                die "часть byway на ucode не извлечена в /var/run"
            }
        ucode -c -S -o "$BW_UCC.$$" "$BW_UCF" >/dev/null 2>&1 &&
            mv "$BW_UCC.$$" "$BW_UCC" 2>/dev/null || rm -f "$BW_UCC.$$" 2>/dev/null || true
    fi
    if [ -f "$BW_UCC" ]; then BW_UCRUN=$BW_UCC; else BW_UCRUN="-S $BW_UCF"; fi
}

bw_uc() {
    bw_uc_prep
    # shellcheck disable=SC2086
    BW_VERSION=$BYWAY_VERSION BW_LANG=$BW_LANG ucode $BW_UCRUN "$@"
}

# Общие помощники: проверка значений, замки, сравнение версий, pid движка.

# Живость движка -- по pid-файлу procd, не по разбору `ps`: на procps-ng формат
# другой, и сторож считал живой движок мёртвым и снимал обвязку. /proc
# подтверждает, что это наш Xray, а не повторно выданный номер.
xray_pid() {
    _xp=$(cat /var/run/byway.pid 2>/dev/null || true)
    # Не от root движок идёт через ujail: в pid-файле обёртка, Xray -- потомок.
    [ "$(readlink "/proc/$_xp/exe" 2>/dev/null)" = /sbin/ujail ] &&
        _xp=$(pgrep -P "$_xp" 2>/dev/null | head -1)
    if [ -n "$_xp" ] && [ -r "/proc/$_xp/cmdline" ] &&
       tr '\0' ' ' < "/proc/$_xp/cmdline" 2>/dev/null | grep -q "run -c $OUT"; then
        printf '%s' "$_xp"
        return 0
    fi
    # Запасной путь: движок запущен руками, мимо службы.
    ps w 2>/dev/null | grep "run -c $OUT" | grep -v grep | awk '{print $1}' | head -1
}

# ── обновления ─────────────────────────────────────────────────────────────
# Проверка только по запросу: регулярный стук в GitHub с домашнего адреса --
# заметный провайдеру след «здесь byway». Ходим через свой прокси-вход:
# github.com часто в списке, а правила в prerouting трафик самого роутера не
# ловят -- резолвер отдаёт адрес пула без маршрута, ответ -- пустота.

# Домен для проверки «трафик проходит»: заворачивается всегда, мимо списков.
PROBE_DOMAIN=example.com

# Замок на каталоге: mkdir атомарен. Живость решает pid внутри, не сам каталог:
# он остаётся от прерванного прогона, и каждый вызов ждал бы 30 с и отказал.
# Общий для сборки и обвязки (хозяев пятеро: старт, цикл попыток, reload, cron,
# человек). Замки в /var/run (root 755), не в /tmp (1777): чужой процесс
# (dnsmasq) занял бы замок с живым pid, и обвязка не поднялась бы никогда.
# Чужой замок (нет метки byway внутри) снимаем силой; владельца судим по
# файлу, а не по правам каталога: busybox stat есть не везде.
take_lock() {   # путь замка, о чём говорить человеку
    if ! mkdir "$1" 2>/dev/null; then
        _lp=$(cat "$1/pid" 2>/dev/null || true)
        # Хозяин только что сделал mkdir и ещё не записал метку и pid: в эту
        # долю секунды замок неотличим от чужого и от брошенного, и второй
        # претендент снимал его силой. Секунда на перечитывание.
        if [ ! -f "$1/byway" ] || [ -z "$_lp" ]; then
            sleep 1
            _lp=$(cat "$1/pid" 2>/dev/null || true)
        fi
        # Замок без нашей метки -- чужой. Не ждём: он может не уйти никогда, а
        # цена ожидания -- дом без резолвера.
        if [ ! -f "$1/byway" ]; then
            warnf "замок «%s» поставлен не byway -- снят принудительно" "$2"
            rm -rf "$1" 2>/dev/null || true
            mkdir "$1" 2>/dev/null || return 1
            : > "$1/byway" 2>/dev/null || true
            echo $$ > "$1/pid" 2>/dev/null || true
            return 0
        fi
        if [ -z "$_lp" ] || [ ! -d "/proc/$_lp" ]; then
            warnf "замок «%s» остался от прерванного прогона -- снят" "$2"
            rm -rf "$1" 2>/dev/null || true
            mkdir "$1" 2>/dev/null || return 1
        else
            warnf "%s уже идёт -- ожидание" "$2"
            _w=0
            while [ -d "$1" ] && [ "$_w" -lt 30 ]; do sleep 1; _w=$((_w + 1)); done
            mkdir "$1" 2>/dev/null || return 1
        fi
    fi
    : > "$1/byway" 2>/dev/null || true
    echo $$ > "$1/pid" 2>/dev/null || true
    return 0
}


# Аутбаунды собирает ucode (uc/outbound.uc) для gen, check и probe; здесь --
# метка сокетов.

# Метка исходящих для «VPN для программ на роутере» -- числом (uc/plumb.uc,
# та же, что в правилах nft).
ob_env_mark() {
    if [ "$(u router_via_vpn)" = "1" ]; then bw_uc selfmark; fi
}

# Сборка конфига Xray: cmd_gen готовит окружение, конфиг собирает ucode
# (uc/gen.uc). $OUT меняется, только если ядро приняло конфиг (run -test).

cmd_gen() {
    # Замок: панель и cron могут позвать gen одновременно, а черновик один.
    _lock=/var/run/byway-gen.lock
    take_lock "$_lock" "$(_t 'сборка конфига')" || die "другая сборка конфига не закончилась за 30 секунд"
    # Ловушка снимает замок на любом выходе, в том числе на отказе ucode.
    # INT/TERM -- выйти (EXIT снимет).
    trap 'rm -rf "$_lock" 2>/dev/null; true' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    # Путь к движку и его версию берёт ucode (xray_bin, xray_ver в uc/core.uc);
    # замена ядра подставляет новый окружением BW_GEN_XRAY.
    [ -f "$CONF" ] || dief "нет %s" "$CONF"
    mkdir -p "$LISTS"
    # Каталог root для журнала обращений и рабочих файлов stat: в общем /tmp
    # движок не от root (ujail) мог бы занять имя заранее (Д-7).
    [ -d /var/run/byway ] || { mkdir -p /var/run/byway && chmod 755 /var/run/byway; } 2>/dev/null || true
    # Список негодных строк -- до сборки списков и направлений.
    : > "$BADLIST" 2>/dev/null || true

    # Слияние списков с пресетами и метка сокетов -- пока на shell (списки,
    # перехват): ucode получает готовое.
    D=$LISTS/domains.lst
    S=$(merged_subnets)
    MERGED=$(merged_domains)
    _gm=$(ob_env_mark)
    _grc=0
    BW_OUT=$OUT BW_LISTS=$LISTS BW_ROUTES=$ROUTES_DIR BW_MERGED=$MERGED BW_SUBNETS=$S \
    BW_BADLIST=$BADLIST BW_ACCESS=$ACCESS BW_PROBE=$PROBE_DOMAIN BW_POOL6_DEF=$POOL6_DEF \
    BW_SELFMARK=$_gm \
        bw_uc gen || _grc=$?
    rm -rf "$_lock" 2>/dev/null || true
    [ "$_grc" = 0 ] || exit "$_grc"
}


# Проверки ключа без боевого конфига: check (разбор и run -test) и probe
# (соединение через ноду) -- в ucode (uc/probe.uc). Здесь окружение и уборка:
# ucode сигналы не ловит, и прерванная проба оставила бы движок и черновик с uuid.

pr_env() {
    PR_MARK=$(ob_env_mark)
}

cmd_check() {
    pr_env
    BW_SELFMARK=$PR_MARK bw_uc check "$@"
}

# PROBE_URL -- проверить через ноду конкретный сайт, а не только выход;
# PROBE_PORT -- порт временного socks-входа. --all -- каждый ключ автовыбора.
cmd_probe() {
    trap '_pp=$(cat /var/run/byway/probe.pid 2>/dev/null || true)
          [ -z "$_pp" ] || kill "$_pp" 2>/dev/null || true
          rm -f /var/run/byway/probe.pid 2>/dev/null || true
          for _pf in /tmp/byway-probe.json /tmp/byway-probe.log /tmp/byway-probe.out; do
              [ ! -f "$_pf" ] || : > "$_pf"
          done' EXIT INT TERM
    pr_env
    # BW_TTY -- в терминале таблица короче и цветом; панель читает прежний вид.
    _ptty=""; [ -t 1 ] && _ptty=1
    BW_TTY=$_ptty BW_SELFMARK=$PR_MARK bw_uc probe "$@"
}

# Показ собранного конфига без секретов -- в ucode (uc/probe.uc, cmd_show);
# счётчики -- по объединённым спискам, их склейка пока на shell.

cmd_show() {
    BW_OUT=$OUT BW_MERGED=$(merged_domains) BW_SUBNETS=$(merged_subnets) bw_uc show
}

# Общие списки доменов и подсетей: свои + готовые наборы, склейка и чистка.

# Записи, не прошедшие проверку формы при сборке, откладываются сюда и
# называются вслух: молча выкинуть часть чужого списка -- оставить гадать,
# почему домен не работает.
BADLIST=/tmp/byway-bad-entries

# Склейка свой + направления + пресеты, одним файлом без повторов (отдаётся
# путь) -- в ucode (uc/merge.uc, кэш с подписью). Читают сборка конфига, nft,
# запрет и проверки -- все видят одно и то же.
merged_env() {
    BW_LISTS=$LISTS BW_ROUTES=$ROUTES_DIR BW_PRESETS=$PRESETS_DIR BW_BADLIST=$BADLIST bw_uc merged "$1"
}
merged_subnets() { merged_env subnets; }
merged_domains() { merged_env domains; }

# Готовые наборы (presets): загрузка, проверка, пересечения -- в ucode
# (uc/presets.uc). Каталог -- здесь: его читают склейка, doctor, экспорт.
PRESETS_DIR=$LISTS/presets

cmd_presets() {
    BW_LISTS=$LISTS BW_ROUTES=$ROUTES_DIR BW_PRESETS=$PRESETS_DIR BW_BADLIST=$BADLIST bw_uc presets
}

# Направления: свои списки со своим ключом выхода. Домены и подсети из
# /etc/byway/routes/<имя>.lst уходят в ноду с этой меткой ключа (метка -- в
# секции UCI, ссылка -- из node_urls). Читают их ucode-части (gen, merge,
# doctor, transfer); здесь -- только каталог.
ROUTES_DIR=$LISTS/routes

# Подписка: загрузка и вывод ключей построчно -- в ucode (uc/presets.uc,
# cmd_sub). Адрес -- окружением: аргументы видны всем в /proc/*/cmdline.

