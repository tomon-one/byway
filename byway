      // напрямую.
      "tag": "local-in",
      "listen": "127.0.0.1",
      "port": $LOCAL_PORT,
      "protocol": "http",
      "sniffing": { "enabled": true, "destOverride": [ "http", "tls" ], "metadataOnly": false, "routeOnly": false }
    }$REDIR_IN
  ],

