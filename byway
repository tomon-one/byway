        # задаёт последнее правило, а здесь стоит единственное исключение --
        # сам сервер VPN.
        #
        # Без него получается петля: чтобы открыть соединение к серверу,
        # Xray сперва узнаёт его адрес, запрос на это идёт по общему правилу
        # в тот же VPN, которого ещё нет. Соединение не встаёт никогда, и
        # выглядит это как «просто не работает», без единой ошибки в журнале.
        # Русские зоны мимо туннеля. Это те же списки, только одной строкой:
        # банки, госуслуги и маркетплейсы закрываются от зарубежных адресов,
        # и через VPN как раз ломаются.
        #
        # .рф пишется в пуникоде: в DNS и в SNI идёт именно xn--p1ai, а не
        # кириллица. Без этой строки треть российских сайтов ушла бы в туннель
        # незаметно -- и сломалась бы ровно так же.
        if [ "$(u ru_direct)" = "1" ]; then
          printf '      { "type": "field", "domain": [ "domain:ru", "domain:su", "domain:xn--p1ai" ], "outboundTag": "direct" },\n'
        fi

        for _h in $VPN_HOSTS; do
          # Пропускаем всё, что не похоже ни на имя, ни на адрес: одна такая
          # строка отвергается движком вместе со всем конфигом.
          case "$_h" in
            ''|-|*[!A-Za-z0-9.:_-]*) continue ;;
          esac
          case "$_h" in
            *[a-zA-Z]*) printf '      { "type": "field", "domain": [ "full:%s" ], "outboundTag": "direct" },\n' "$_h" ;;
            *)          printf '      { "type": "field", "ip": [ "%s/32" ], "outboundTag": "direct" },\n' "$_h" ;;
          esac
        done
