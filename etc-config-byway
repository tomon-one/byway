# /etc/config/byway — настройки менеджера туннеля.
#
# Списков здесь НЕТ намеренно: они лежат файлами в /etc/byway/. У podkop они
# хранились инлайном в UCI, и правка файла не действовала, пока её отдельной
# командой не затолкаешь обратно — на этом спотыкались весь август 2026.
#
#   /etc/byway/domains.lst   домены в туннель, по одному на строку
#   /etc/byway/subnets.lst   подсети в туннель, CIDR
#   /etc/byway/config.json   собранный конфиг Xray-core, byway gen его перезаписывает
#
# node_url — секрет: uuid ноды внутри. Здесь он пуст, вписывается своим:
# в панели «Сервисы → Byway → Основное» либо командой
#     uci set byway.main.node_url='vless://…' && uci commit byway
#
# Всё остальное здесь -- умолчания для ЧИСТОГО роутера, а не снимок чьей-то
# настройки. Служба выключена (enabled 0): без ключа запускать нечего, а
# запуск вхолостую пишет в журнал отказ, который выглядит поломкой. Сетей
# перечислена одна, br-lan: гостевого моста на свежей прошивке нет, и
# перечисление несуществующего интерфейса обвязку не поднимет.

config byway 'main'
	option enabled '0'

	# Что пускать через VPN: lists -- только перечисленное в domains.lst и
	# subnets.lst, all -- весь трафик мостов.
	#
	# В режиме all правила nft ловят всё, а маршрутизация шлёт всё в туннель,
	# КРОМЕ адреса самого сервера VPN. Без этого исключения выходит петля:
	# чтобы соединиться с сервером, Xray-core сперва узнаёт его адрес, а запрос на
	# это уходит в тот же ещё не поднятый туннель. Выглядит как «просто не
	# работает», без единой ошибки в журнале.
	option list_mode 'lists'

	# Только для режима all: пускать зоны .ru, .su и .рф мимо туннеля.
	# Пуникод xn--p1ai обязателен -- в DNS и SNI идёт именно он.
	option ru_direct '1'

	# Готовые списки, подключаемые вместе со своим. Каталог адресов -- в самом
	# byway, командой `byway presets`. По умолчанию обновляются только по
	# команде: у чужого списка содержимое меняется без предупреждения, и
	# автообновление однажды тихо притащило бы домен, уже лежащий в хостлисте
	# zapret. Расписание задаётся отдельно -- `lists_update` ниже; пусто
	# значит «не обновлять само».
	#list preset 'byway'
	option node_url ''

	# Откуда брать ключ: key -- вписан руками выше, sub -- выбран из подписки.
	# Разделено явно, чтобы в панели было ВИДНО, что вариантов два: прежняя
	# редакция прятала выбор за кнопкой, и о нём нельзя было догадаться.
	option conn_mode 'key'

	# Адрес подписки. Это НЕ ключ: обычный https://, по которому лежит список
	# ключей, обычно в base64.
	option sub_url ''

	# Свой конфиг аутбаунда для режима conn_mode=outbound. Объект Xray-core
	# целиком; тег byway подставляет сам. Так подключаются к тому, чего
	# byway не разбирает по ссылке -- у podkop это звалось Outbound Config.
	option outbound_json ''
	option conn_label ''

	# Пул fakeip. Тот же, что был у podkop: 131 тысяча адресов при полутора
	# тысячах доменов — запас восьмидесятикратный.
	option fakeip_pool '198.18.0.0/15'

	# Резолвер, которым Xray-core отвечает на всё, чего нет в списке. DoH, потому
	# что провайдер травит запросы к чужим резолверам по UDP — проверено
	# фингерпринтом 8.47.69.0 / 8.6.112.0 в августе 2026.
	option dns_upstream 'https://8.8.8.8/dns-query'

	# Запасной, на случай когда первый молчит. Xray перебирает серверы по
	# порядку: не ответил первый -- спрашивает второй. Провайдер РАЗНЫЙ
	# намеренно: 8.8.4.4 лежит за тем же AS, что и 8.8.8.8, и запасным по
	# отношению к нему не является. Отключить -- вписать none.
	option dns_upstream2 'https://1.1.1.1/dns-query'

	# Кем разрешать ИМЯ резолвера, если он задан именем, а не адресом. Пусто --
	# значит резолверы обязаны быть адресами (так и в поставке). Нужен ровно
	# тогда, когда у провайдера адрес не фиксирован: dns.nextdns.io крутит
	# anycast и вписывается только именем.
	#
	# Спрашивают у него ТОЛЬКО имена DoH-серверов -- остальное идёт по DoH.
	# ⚠️ Строкой, а не пустым значением: uci выбрасывает опции с пустым
	# значением при разборе -- 'option dns_bootstrap ''' в файле есть, а
	# uci get отвечает «Entry not found». Проверено 2026-09-09.
	# option dns_bootstrap '77.88.8.8'

	# Как ходить к этому серверу: direct -- с домашнего адреса, tunnel -- через
	# ноду. Домены из списка настройки не касаются: на них отвечает встроенный
	# fakedns, локально, наружу за ними никто не ходит.
	option dns_route 'direct'

	# Адрес, на котором Xray-core слушает DNS. Сюда dnsmasq пересылает запросы.
	# Отдельный адрес, а не 127.0.0.1, чтобы не столкнуться с самим dnsmasq.
	option dns_listen '127.0.0.42'

	# Порт tproxy-входа. Туда nft заворачивает трафик на пул fakeip.
	option tproxy_port '1602'
	option local_proxy_port '1603'

	# Ходит ли САМ РОУТЕР к сайтам из списка через туннель. Перехват ловит
	# только трафик домашних устройств; собственный трафик роутера идёт
	# мимо него, и до сайта из списка роутер не достаёт вовсе.
	#
	# ⚠️ Здесь была ПЕТЛЯ, и она ПОЧИНЕНА 2026-09-08. Что было: цепочка в
	# `output` ловит по адресу назначения, а движок живёт на том же хосте --
	# его собственные исходящие шли через ту же цепочку. Не сумев
	# восстановить домен по подставному адресу, он выпускал пакет наружу как
	# есть, на тот же адрес, и правило заворачивало его обратно. За минуты
	# это съедало предел открытых файлов: движок переставал принимать ЛЮБЫЕ
	# соединения, включая перехват, и туннеля лишался весь дом. Поймано на
	# боевом роутере 2026-09-07: 1444 витка и «accept4: too many open files».
	#
	# Чем закрыто: движок ставит метку на свои исходящие сокеты
	# (streamSettings.sockopt.mark, ключ self_mark ниже), а первое правило
	# цепочки помеченное пропускает. Так предписывает и туториал XTLS по
	# tproxy. Адресом или портом исключить было нельзя -- у петли они те же.
	#
	# Заодно выяснилось, почему пакет уходил в direct, а не в блок: Xray
	# подменяет адрес назначения на сниффленный домен ДО маршрутизации, даже
	# когда fakedns промахнулся. Правило блокировки по адресу пула к этому
	# моменту видит уже домен, а не адрес, -- закрыть это правилом было
	# нельзя в принципе, только меткой.
	#
	# Проверено на боевом роутере 2026-09-08, минута под наблюдением:
	# дескрипторов у движка 20 -> 21 (в петлю уходило 4095), счётчик цепочки
	# 1 пакет, и роутер наконец достал до сайта из своего списка
	# (api.github.com ответил 200 вместо Operation not permitted).
	#
	# С 2026-09-10 по умолчанию ВКЛЮЧЕНО. Прежде стояло 0 с оговоркой
	# «проверено на одном роутере и одну минуту», и цена этой осторожности
	# вылезла в тот же день: у владельца молча не работал Zapret-Manager, а
	# следом и обновление списков внутри него. Причина оба раза одна --
	# роутер не достаёт до github, потому что github в списке, резолвер
	# отдаёт подставной адрес, а маршрута туда без этой настройки нет.
	#
	# Сам byway от неё не зависит и не зависел: свои загрузки он делает через
	# прокси-вход (`curl --proxy 127.0.0.1:1603`). Страдают СОСЕДИ по роутеру,
	# которые о прокси не знают, -- и это как раз то, чего человек не ждёт.
	#
	# Выключать осмысленно, если своя цепочка в output уже есть и чужая в ней
	# лишняя. Выключенное состояние doctor называет вслух, молчать не будет.
	option router_via_vpn '1'

	# Метка на СОБСТВЕННЫХ исходящих сокетах движка -- та самая, которой
	# закрыта петля выше. Менять незачем; менять придётся, только если это
	# значение занял сосед по роутеру.
	#
	# ⚠️ Бит обязан отличаться от бита метки обвязки (`mark`): `ip rule`
	# ставится с маской, то есть ловит любую метку с поднятым битом обвязки.
	# Совпади они -- собственные пакеты движка ушли бы в таблицу 100, то есть
	# ровно на ту петлю, от которой метка и защищает.
	option self_mark '0x400000'

	# Заворачивать ли IPv6. ВЫКЛЮЧЕНО по умолчанию -- как у passwall и
	# OpenClash; включённым его держит только nikki, а тот и пишет не в
	# свою таблицу, а в системную.
	#
	# ⚠️ Пока выключено, клиент с поднятым IPv6 получает AAAA и уходит
	# НАПРЯМУЮ мимо туннеля: ни домены, ни подсети его не держат, потому
	# что и то, и другое у byway строго IPv4. Именно так утекает трафик
	# у человека, который добавил подсети сервиса и считает его завёрнутым.
	# doctor про это говорит.
	#
	# Включение добавляет в ту же таблицу nft параллельные наборы и
	# правила, поднимает `ip -6 rule` на ту же таблицу маршрутизации и
	# переводит движок на UseIP со вторым подставным пулом.
	option ipv6 '0'

	# Подставной пул для IPv6. Значение не выдумано: это встроенная
	# константа самого Xray, и то же берёт passwall. ULA в интернете не
	# маршрутизируется -- столкнуться с настоящим адресом нельзя.
	option fakeip6_pool 'fc00::/18'

	# Порт, на который заворачивается собственный трафик роутера.
	option redirect_port '1604'

	# Час, в который автообновление имеет право сработать, по МЕСТНОМУ
	# времени роутера. У прошивки из коробки пояс UTC, и тогда это не тот
	# час, что у вас: пояс называет byway doctor. Значение 0-23.
	option auto_update_hour '04'

	# Метка nft для tproxy. Должна совпадать с той, что ставят правила.
	option mark '0x100000'

	# Язык вывода: ru либо en. Перевод лежит в /etc/byway/lang/<язык>.tsv
	# файлом «ключ<TAB>перевод»; пропущенная строка печатается по-русски.
	option lang 'ru'

	option log_level 'warning'

	# Сбор статистики использования. Выключено по умолчанию:
	# нужно, когда решаешь, что из списка можно убрать, а обычной
	# работе не требуется. Включается на вкладке «Обслуживание».
	option show_usage '0'

	# Сторож целостности. Раз в пять минут проверяет, на месте ли обвязка при
	# работающем движке, и поднимает её обратно, если её снесли снаружи --
	# чужим `nft flush ruleset`, обновлением firewall4, соседней службой.
	# Снятую намеренно (`byway plumb off`) не трогает. 0 -- выключить.
	option guard '1'

	# Что делать, когда движок не поднялся.
	#   open   -- дом с интернетом и без туннеля. Умолчание: byway не должен
	#             оставлять дом без сети. Плата: трафик, который считали
	#             идущим через VPN, уходит напрямую, и узнать об этом неоткуда.
	#   closed -- нет туннеля, нет и доступа к тому, что через него ходило.
	#             ЧТО ИМЕННО закроется, решает list_mode, и разница огромная:
	#               по спискам    -- закрыт список, остальной интернет работает;
	#               всё через VPN -- закрыт ВЕСЬ выход наружу, потому что
	#                                «через него ходило» тут и значит всё.
	#             Вход в роутер (LuCI, ssh) не задет ни в том, ни в другом.
	option on_failure 'open'

	# Как часто перекачивать готовые списки. Пусто или 0 -- не обновлять.
	# Пишется словами: 12h, 2h37m, 1d, 90m. Голое число -- минуты.
	# Меньше получаса не бывает: ниже начинается долбёж чужого сервера.
	# Срабатывает на ближайшей пятиминутке после истечения промежутка --
	# сторож ходит раз в пять минут, отдельной задачи ради этого нет.
	option lists_update ''
	# Спрашивать ли у GitHub про новые версии -- раз в сутки, на том же
	# пробуждении сторожа. Только СПРАШИВАЕТ: ничего не скачивает и не
	# ставит, решение остаётся за человеком. Выключить: option update_check '0'
	option update_check '1'
	# Ставить ли найденное САМО. Выключено намеренно: обновление
	# перезапускает службу, то есть отнимает туннель у всего дома. Включив,
	# вы соглашаетесь, что это произойдёт в 04:00-05:00 ПО ЧАСАМ РОУТЕРА
	# (а не по вашим: у прошивки из коробки часовой пояс UTC, и тогда это
	# утро -- byway doctor скажет, во сколько выйдет у вас), и не раньше
	# чем через трое суток после выхода выпуска (важные -- сразу). Обновление
	# идёт только внутри минорной версии, а если туннель не поднялся за
	# двух с половиной минут -- byway сам возвращает прежнюю версию. Столько,
	# а не минуту: обвязку после перезапуска поднимает фоновый цикл службы, и
	# его собственный бюджет -- не меньше 65 секунд. Дедлайн короче бюджета
	# откатывал исправную версию.
	option auto_update '0'

	# Мультиплексирование: сколько потоков клиентов схлопывать в одно
	# соединение к ноде. 0 — выключено.
	#
	# Замер 2026-09-03 на транспорте ws: установка сессии стала вчетверо
	# быстрее (медиана 588 -> 149 мс), а соединений к ноде вместо 53-58
	# стало ровно 8. Второе — структурное подтверждение, от скорости канала
	# не зависящее.
	#
	# Генератор САМ не включит mux там, где он вредит: с flow=xtls-rprx-vision
	# и с транспортами, которые мультиплексируют себя сами (xhttp с его xmux,
	# grpc с multiMode). Проверено: xhttp с mux загнал весь трафик в одно
	# соединение и стал медленнее, чем без него.
	option mux_concurrency '8'

	# Какой бинарник Xray-core запускать. Пусто — искать в PATH, потом
	# /usr/bin/xray.
	#
	# Смысл опции: держать рядом пакетную версию из фида и поставленную
	# вручную, переключаться между ними одной командой и так же откатываться.
	# Пусто -- брать тот Xray-core, что стоит из пакета.
	#
	# Здесь стоял конкретный путь с номером версии, и это была ошибка: у нового
	# пользователя такого файла нет никогда, а status и doctor показывали бы
	# несуществующий путь и отправляли искать его.
	option xray_bin ''

	# Мягкий предел памяти движка (GOMEMLIMIT рантайма Go). Пусто -- авто:
	# 40 % от MemTotal, не меньше 32 МиБ; '0' -- не задавать. Появилось после
	# 2026-09-07: на роутере с 234 МБ ядро трижды за вечер убивало Xray по
	# OOM при ~100 МБ занятой памяти, а procd поднимал его заново -- снаружи
	# это «туннель моментами отваливается». С пределом Go жмёт сборку мусора
	# у порога, а не ждёт убийцу. Предел мягкий: живые данные не режет.
	# Задаётся примером в комментарии, а не пустой опцией: uci выбрасывает
	# пустые значения при разборе. Текущее значение показывает byway status.
	# option xray_memlimit '96MiB'

	# Кого заворачивать. br-iot намеренно нет: пылесосу нода не нужна,
	# а трафик она бы ела.
	list interface 'br-lan'
