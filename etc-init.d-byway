#!/bin/sh /etc/rc.common
#
# Служба byway. Ставится в /etc/init.d/byway, права 0755.
#
# Порядок при старте важен и выбран так:
#   1. собрать конфиг, если его нет;
#   2. запустить Xray под присмотром procd;
#   3. дождаться, пока он ответит, и только тогда поднять обвязку.
#
# Именно в таком, а не наоборот. Обвязка уводит весь резолв роутера на
# DNS-вход Xray и ставит noresolv — значит поднять её раньше Xray означает
# оставить дом без DNS на всё время его запуска, а при сломанном конфиге
# и навсегда. Ожидание живёт в самом `byway plumb on`, чтобы защита работала
# при любом вызове, а не только из этого файла.
#
# Отсюда полезное следствие: если Xray не поднялся, обвязки просто не будет.
# Дом останется без туннеля, но с интернетом -- ЕСЛИ on_failure=open, а это
# умолчание. При closed доступ закрывается: в режиме списков -- к списку, в
# режиме «всё через VPN» -- весь выход наружу. podkop в этой ситуации уносил
# резолв с собой.
#
# При остановке порядок обратный: plumb off возвращает dnsmasq провайдеру
# ДО того, как procd убьёт Xray. На ПЕРЕЗАПУСКЕ резолвер не трогается вовсе
# -- см. restart ниже: гонять его вниз и обратно значит дважды оставить дом
# без DNS на девять секунд ради состояния, которое никому не достанется.

USE_PROCD=1
# 21 -- сразу за сетью (20), dnsmasq и firewall (19). Прежде было 90, и при
# «не пускать мимо VPN» от подъёма dnsmasq до запрета проходили десятки
# секунд, в которые клиенты получали настоящие адреса и держали их до TTL.
# Движку сеть для старта не нужна: перехват проверяется по своему DNS.
START=21
STOP=10

BYWAY=/usr/local/bin/byway
CONF=/etc/byway/config.json
# Слепок того, что РЕАЛЬНО применено: md5 конфига, с которым запущен движок, и
# md5 желаемого набора правил nft. Живёт в памяти, то есть до перезагрузки --
# после неё службу поднимает start и слепок пишется заново.
#
# Без него reload сравнивал файл сам с собой: панель после сохранения зовёт
# `byway gen` СВОИМ вызовом, и если он успевал раньше procd, то reload видел
# уже пересобранный файл, объявлял «конфиг не изменился» и службу не трогал.
# Настройки лежали в файле, движок работал по старым, панель писала
# «Применено». Слепок ломает эту ничью: сравнивается не файл с файлом, а файл
# с тем, что запущено.
STATE=/var/run/byway.applied

mark_applied() {
	{
		md5sum "$CONF" 2>/dev/null | cut -d' ' -f1
		"$BYWAY" nftsig 2>/dev/null | md5sum | cut -d' ' -f1
	} > "$STATE" 2>/dev/null || true
}
# Путь к бинарнику берётся из UCI тем же способом, что и в самом byway:
# так рядом живут пакетная версия из фида и поставленная вручную, а
# переключение и откат — одна команда uci. Без этого init-скрипт продолжал
# бы поднимать пакетную, сколько byway ни настраивай.
# Путь к движку приходит из UCI, а UCI правит панель -- значит это значение
# ПРИШЛО СНАРУЖИ, и исполнять по нему что попало от root нельзя. Ровно так
# устроены CVE в luci-app-travelmate и luci-app-samba4: бэкенд читает путь из
# конфигурации и запускает его. Валидатор в панели защитой не считается --
# в travelmate обошли именно его.
#
# Проверяем в таком порядке: сначала каталог (писать в системные может только
# root, так что это и есть граница доверия), потом исполняемость, и лишь потом
# спрашиваем версию -- запускать неизвестный файл ради проверки нельзя.
xray_ok() {
    case "$1" in
        /usr/bin/*|/usr/sbin/*|/usr/local/bin/*|/bin/*|/sbin/*) ;;
        *) return 1 ;;
    esac
    case "$1" in *..*) return 1 ;; esac
    [ -f "$1" ] && [ -x "$1" ] || return 1
    # Имя xray* и заголовок ELF -- до запуска: `xray_bin=/sbin/reboot` с
    # панели иначе перезагружал роутер на каждом вызове byway (cron -- раз в
    # пять минут, при загрузке -- по кругу).
    case "${1##*/}" in xray*) ;; *) return 1 ;; esac
    head -c 4 "$1" 2>/dev/null | grep -q ELF || return 1
    "$1" version 2>/dev/null | head -1 | grep -qi "^Xray " || return 1
}

XRAY=$(uci -q get byway.main.xray_bin || true)
if [ -n "$XRAY" ] && ! xray_ok "$XRAY"; then
    logger -t byway "путь к движку отклонён: $XRAY"
    XRAY=""
fi
# Тот же порядок, что у самого byway: сперва PATH, потом /usr/bin/xray.
# Расходясь, служба запускала одно ядро, а byway собирал конфиг под другое.
[ -n "$XRAY" ] || XRAY=$(command -v xray || echo /usr/bin/xray)

# Мягкий предел памяти для движка -- GOMEMLIMIT рантайма Go. Что это и зачем:
# без предела сборщик мусора Go даёт куче вырасти вдвое против живых данных,
# и на роутере с 234 МБ Xray доходил до ~100 МБ -- 2026-09-07 ядро трижды за
# вечер убило его по OOM, procd поднял заново, дом каждый раз оставался без
# туннеля на секунды и терял все соединения. С пределом Go жмёт сборку у
# порога и возвращает память системе, а не ждёт убийцу. Предел МЯГКИЙ: живые
# данные он не режет, при их росте выше порога Go лишь чаще собирает мусор
# (не более половины процессорного времени), так что хуже OOM не будет.
#
# Пусто -- авто, 40 % от MemTotal, но не меньше 32 МиБ; '0' -- не задавать
# вовсе; иное -- как написано, в форме Go ('96MiB', '128MiB').
# Умолчание живёт здесь, а не в поставке: uci выбрасывает пустые опции.
xray_memlimit() {
    _ml=$(uci -q get byway.main.xray_memlimit || true)
    # Go понимает B, KiB, MiB, GiB, TiB или голое число БАЙТ; на чём-то другом
    # движок падает при старте, и procd поднимал бы его по кругу. Привычное
    # MB/M/GB переводим, голое число считаем мегабайтами («96» байт -- вечная
    # сборка мусора), прочее -- в журнал и авто.
    case "$_ml" in
        0|off|no) return 0 ;;
        '') ;;
        *[!0-9]*[!A-Za-z]*|[!0-9]*)
            logger -t byway "предел памяти «$_ml» не разобран -- взят авто" ;;
        *[0-9]B|*[0-9]KiB|*[0-9]MiB|*[0-9]GiB|*[0-9]TiB)
            printf '%s' "$_ml"; return 0 ;;
        *[0-9]MB|*[0-9]M|*[0-9]Mi) printf '%sMiB' "${_ml%%[!0-9]*}"; return 0 ;;
        *[0-9]GB|*[0-9]G|*[0-9]Gi) printf '%sGiB' "${_ml%%[!0-9]*}"; return 0 ;;
        *[!0-9]*) logger -t byway "предел памяти «$_ml» не разобран -- взят авто" ;;
        *) printf '%sMiB' "$_ml"; return 0 ;;
    esac
    _kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || true)
    [ -n "$_kb" ] || return 0
    _mib=$(( _kb * 40 / 100 / 1024 ))
    [ "$_mib" -ge 32 ] || _mib=32
    printf '%sMiB' "$_mib"
}

# Проверки `plumbed` здесь больше НЕТ, и это не потеря. Она заводилась, чтобы
# не снимать то, чего не поднимали, -- но на пути restart отвечала «не
# поднято» ВСЕГДА (stop снимает таблицу первым делом) и тем отменяла возврат
# резолвера на всех ветках отказа. Её работу теперь делает сам dns_down: он
# смотрит, на кого нацелен работающий резолвер, и впустую его не роняет.
#
# Живость движка -- по pid-файлу procd, а не по разбору вывода `ps`: его
# форма у busybox и у полноценного procps-ng разная, и на чужой прошивке
# reload считал исправный движок мёртвым.
byway_running() {
	_xp=$(cat /var/run/byway.pid 2>/dev/null)
	[ -n "$_xp" ] && [ -d "/proc/$_xp" ] && return 0
	ps w 2>/dev/null | grep -q "[r]un -c $CONF"
}

# Pid самого Xray. Не от root движок идёт через ujail: в pid-файле procd --
# обёртка, Xray -- её потомок.
xray_main_pid() {
	_xp=$(cat /var/run/byway.pid 2>/dev/null)
	[ "$(readlink "/proc/$_xp/exe" 2>/dev/null)" = /sbin/ujail ] &&
		_xp=$(pgrep -P "$_xp" 2>/dev/null | head -1)
	printf '%s' "$_xp"
}

# Xray не от root: пользователь byway и два права, через ujail, как ntpd и
# hostapd. CAP_NET_BIND_SERVICE -- DNS-вход на 53-м порту; для tproxy
# (IP_TRANSPARENT) и метки трафика (SO_MARK) с ядра 5.17 хватает узкого
# CAP_NET_RAW, раньше SO_MARK требовал CAP_NET_ADMIN. От root -- без ujail
# (пакет procd-ujail) либо с byway.main.xray_root=1. Код 0 -- от byway.
CAPS=/var/run/byway-caps.json
ACCESS=/var/run/byway/access.log
xray_user_prep() {
	[ "$(uci -q get byway.main.xray_root)" = "1" ] && return 1
	[ -x /sbin/ujail ] || return 1
	if ! user_exists byway; then
		_g=$(group_add_next byway) || return 1
		user_add byway "" "$_g" byway /var/run/byway /bin/false || return 1
	fi
	_kv=$(uname -r | awk -F. '{ print $1 * 1000 + $2 }')
	if [ "${_kv:-0}" -ge 5017 ]; then _net=CAP_NET_RAW; else _net=CAP_NET_ADMIN; fi
	_c="\"$_net\", \"CAP_NET_BIND_SERVICE\""
	printf '{ "bounding": [ %s ], "effective": [ %s ], "ambient": [ %s ], "permitted": [ %s ], "inheritable": [ %s ] }\n' \
		"$_c" "$_c" "$_c" "$_c" "$_c" > "$CAPS" || return 1
	# Конфиг (в нём ключ) -- на чтение группе byway; журнал обращений пишет
	# сам движок.
	chgrp byway "$CONF" 2>/dev/null && chmod 640 "$CONF" 2>/dev/null || return 1
	[ -e "$ACCESS" ] || : > "$ACCESS"
	chown byway:byway "$ACCESS" 2>/dev/null && chmod 600 "$ACCESS" 2>/dev/null || return 1
	return 0
}

# Признак «start_service отказал». Нужен потому, что rc.common зовёт
# service_started независимо от того, чем кончился start_service: фоновый
# цикл из трёх попыток подъёма уходил работать даже тогда, когда причина
# отказа уже известна и напечатана. Каждая попытка ждала движок пятнадцать
# секунд и сама перезапускала dnsmasq -- на единственном шлюзе дома выходило
# четыре провала резолва за минуту на ровном месте.
FAILMARK=/var/run/byway-nostart

# ⚠️ Своя обёртка над restart. procd отвечает «Command failed: Not found»,
# когда останавливают службу, которой нет в его списке -- то есть при
# перезапуске уже остановленной. Это не ошибка, но выглядит ею ровно в тот
# момент, когда человек перезапускает после правки настроек, и он идёт искать
# несуществующую поломку. Поймано приёмкой владельца 2026-09-07.
#
# Глушим ТОЛЬКО стандартный поток ошибок остановки: свои сообщения
# stop_service пишет в stdout, они остаются на месте.
restart() {
	trap '' TERM
	# Резолвер на время перезапуска не трогаем. Вниз к провайдеру и через
	# десять секунд обратно -- это два окна по девять секунд без DNS у всего
	# дома, а состояние «смотрим провайдеру» между ними не нужно никому.
	# Читает флаг stop_service, он же его и передаёт дальше.
	BYWAY_KEEP_DNS=1
	stop "$@" 2>/dev/null
	BYWAY_KEEP_DNS=0
	# Игнор TERM -- только на время stop, как в rc.common. Иначе его
	# наследовал фоновый цикл подъёма из start: следующий stop не мог его
	# убить, и цикл ставил перехват или запрет поверх остановленной службы.
	trap - TERM
	start "$@"
}

# Снять обвязку и УБЕДИТЬСЯ, что сняли.
#
# ⚠️ `plumb off` умеет вернуть 1, НИЧЕГО не сняв: take_lock ждёт занятый замок
# тридцать секунд и сдаётся, а замок в это время держит фоновый цикл подъёма
# (проба движка плюс два перезапуска dnsmasq -- это за тридцать секунд).
# Прежде код возврата здесь выбрасывался: rc.common докладывал об успехе,
# procd убивал движок, и дом оставался с резолвером, у которого единственный
# апстрим больше никто не слушает. Выйти из этого мог только сторож, минут
# через десять и только если задача в cron жива.
#
# Тот же приём -- проверка и повтор -- давно стоит в uninstall.sh; сюда правка
# не доехала, хотя служба зовёт off на порядок чаще.
plumb_off_try() {   # аргументы -- дополнительные флаги для plumb off
	"$BYWAY" plumb off --service "$@" && return 0
	echo "правила перехвата не снялись с первой попытки — следующая через паузу"
	sleep 5
	"$BYWAY" plumb off --service "$@" && return 0
	echo "ОБВЯЗКА НЕ СНЯТА, резолвер не возвращён. Снять руками: byway plumb off"
	return 1
}

# Снятие обвязки на ветке ОТКАЗА -- не то же, что по воле человека.
# При on_failure=closed запрет обязан пережить неудачный старт: в этом и смысл
# закрытой модели. А `plumb off` по умолчанию его снимает, потому что обычная
# остановка службы не должна оставлять запертый дом. Различаем здесь: отказ --
# с --keep-block, выключение через `option enabled 0` -- без него, это решение
# человека, а не поломка.
plumb_off_fail() {
	if [ "$(uci -q get byway.main.on_failure)" != "open" ]; then
		plumb_off_try --keep-block
	else
		plumb_off_try
	fi
}

start_service() {
	rm -f "$FAILMARK" 2>/dev/null || true
	# На обеих ветках отказа сначала снимаем обвязку, и только потом уходим.
	# Молчаливый return оставлял dnsmasq смотреть на порт, который никто не
	# слушает: выключение через `option enabled 0` роняло DNS всему дому.
	[ "$(uci -q get byway.main.enabled)" = "1" ] || {
		echo "byway выключен в /etc/config/byway (option enabled)"
		# --service, а не голый off: эта форма не ставит метку «сняли
		# руками», иначе сторож окажется заперт до перезагрузки.
		#
		# ⚠️ БЕЗ `plumbed &&`, и это не небрежность. На пути restart сюда
		# приходят уже БЕЗ таблицы: stop снял её первым делом, а резолвер
		# оставил на нашем входе намеренно (BYWAY_KEEP_DNS). Проверка
		# «стоит ли обвязка» отвечала «нет» и возврат DNS не звался ни на
		# одной ветке отказа -- дом оставался с единственным апстримом
		# 127.0.0.42, который никто не слушает. Ломалась ровно та кнопка,
		# которой чинят. plumb off идемпотентен: без таблицы он снимает
		# нечего, а dns_down действует только если в резолверах стоит наш
		# адрес.
		plumb_off_try
		: > "$FAILMARK"
		return 0
	}
	# Закрываем ДО движка, а не после его отказа. Разбор -- в ветке `close`
	# у cmd_plumb: запрет от движка не зависит, и ждать его подъёма, чтобы
	# потом закрыться, значит держать дверь открытой всё время ожидания.
	[ "$(uci -q get byway.main.on_failure)" != "open" ] && "$BYWAY" plumb close

	[ -x "$XRAY" ] || {
		echo "нет $XRAY — движок не найден"
		# Совет «поставить xray-core» на роутере, где движок уже лежит
		# рядом под своей версией, вёл ко второй копии ядра на разделе
		# 43.7 МБ, куда две не влезают. Сперва смотрим, нет ли готового.
		# Только запускаемые: висячая ссылка (ядро в /tmp, стёртом
		# перезагрузкой) -- не замена, а с ней пропускалось восстановление.
		_alt=""
		for _x in /usr/local/bin/xray-*; do [ -x "$_x" ] && _alt=$_x; done
		if [ -n "$_alt" ]; then
			echo "  рядом лежит $_alt"
			echo "  указать его: uci set byway.main.xray_bin=$_alt && uci commit byway"
		else
			# Менеджер ВЫЧИСЛЯЕМ, а не зашиваем: apk есть только с
			# OpenWrt 25.12, на 22.03/23.05/24.10 -- opkg, и глагол у него
			# другой. Совет `apk add` отвечал там `not found`, а приходят
			# сюда чаще всего именно после sysupgrade на такой прошивке:
			# keep-список хранит настройки byway, но не движок (35 МБ туда
			# намеренно не кладут). Три остальных файла проекта считают
			# это правильно, один этот -- нет.
			_pkgfix="apk update && apk add"
			if ! command -v apk >/dev/null 2>&1 && command -v opkg >/dev/null 2>&1; then
				_pkgfix="opkg update && opkg install"
			fi
			# Ставим сами, в фоне и раз за загрузку: так бывает после
			# sysupgrade, и дом иначе ждал человека с командой. Номер --
			# из прежнего xray_bin, иначе проверенный. Удачная установка
			# перезапускает службу сама; не вышло -- сторож повторит.
			if [ ! -f /tmp/byway-engine-restore ]; then
				: > /tmp/byway-engine-restore
				echo "  движок ставится в фоне: byway engine restore (журнал: logread -e byway)"
				# 1000>&- -- см. у цикла подъёма ниже.
				( sleep 15; "$BYWAY" engine restore 2>&1 | sed "s/$(printf '\033')\[[0-9;]*m//g" | logger -t byway ) </dev/null >/dev/null 2>&1 1000>&- &
			fi
			echo "  поставить руками: byway engine restore, либо $_pkgfix xray-core"
			echo "  либо указать свой путь: uci set byway.main.xray_bin=/путь/к/xray"
		fi
		# Безусловно, по той же причине, что и веткой выше.
		plumb_off_fail
		: > "$FAILMARK"
		return 1
	}

	# Каталог журнала обращений -- root 755: движок от byway пишет в свой
	# файл, но удалить или подменить его ссылкой не может (см. xray_user_prep).
	# До gen: тот усекает журнал при выключенном сборе.
	mkdir -p /var/run/byway && chown root:root /var/run/byway && chmod 755 /var/run/byway

	# Пересобираем ВСЕГДА, а не только когда конфига нет.
	#
	# Прежнее условие «нет файла либо ядро его отвергло» пропускало главный
	# случай: byway обновили, старый конфиг остался валидным -- и движок
	# поднимался на СТАРОМ, пока правила nft укладывались новые. Две половины
	# расходились молча, увидеть это можно было только сверкой файла глазами.
	# Поймано выкладкой 2026-09-07: вход для трафика роутера был в скрипте,
	# цепочка в ядре стояла, а в конфиге входа не было -- заворот вёл в
	# закрытый порт, и выглядело это как «функция просто не работает».
	#
	# Полезное свойство прежней ветки сохранено: если сборка не удалась, но
	# рабочий конфиг на месте -- поднимаемся на нём и говорим вслух, а не
	# оставляем дом без DNS. Ровно этим ценна проверка ядром.
	if ! "$BYWAY" gen; then
		if [ -f "$CONF" ] && "$XRAY" run -test -c "$CONF" >/dev/null 2>&1; then
			echo "конфиг не пересобрался — поднимаюсь на прежнем рабочем"
		else
			# Безусловно, по той же причине, что и на ветках выше: после
			# restart таблицы уже нет, а резолвер ещё смотрит на нас.
			plumb_off_fail
			: > "$FAILMARK"
			return 1
		fi
	fi

	_xu=0
	xray_user_prep && _xu=1

	procd_open_instance byway
	procd_set_param command "$XRAY" run -c "$CONF"
	if [ "$_xu" = 1 ]; then
		# Без файлового заключения, как у hostapd: ujail только снимает права.
		procd_add_jail byway
		procd_set_param capabilities "$CAPS"
		procd_set_param user byway
		procd_set_param group byway
		procd_set_param no_new_privs 1
	fi
	# Последний ноль — retry, и он означает «перезапускать без предела».
	# Было пять, и это оказалось опасно: procd считает не «пять падений за
	# час», а сбрасывает счётчик только после прогона длиннее часа. Шесть
	# падений, разнесённых хоть по полчаса, останавливали службу навсегда —
	# а вместе с ней дом оставался с резолвером, указывающим в мёртвый порт,
	# потому что stop_service при исчерпании respawn не вызывается.
	# Теперь DNS вернётся сам, как только Xray снова сможет подняться.
	procd_set_param respawn 3600 5 0
	# Xray пишет журнал в stdout, а не в stderr. Только stderr, как было
	# сначала, давал пустой logread при работающей службе — и диагностика
	# сводилась к гаданию.
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/byway.pid
	# Предел памяти -- см. xray_memlimit выше. Пустой ответ = не задавать.
	_ml=$(xray_memlimit)
	[ -n "$_ml" ] && procd_set_param env GOMEMLIMIT="$_ml"
	procd_close_instance
}

service_started() {
	[ "$(uci -q get byway.main.enabled)" = "1" ] || return 0
	# start_service уже отказал и уже сказал человеку, почему. Три попытки
	# подъёма поверх этого ничего не изменят: движка нет, а каждая стоит
	# пятнадцати секунд ожидания и одного перезапуска dnsmasq.
	if [ -f "$FAILMARK" ]; then
		rm -f "$FAILMARK" 2>/dev/null || true
		return 0
	fi

	# plumb on сам ждёт ответа от Xray до пятнадцати секунд и при неудаче
	# не трогает ничего. Кэш резолвера он сбрасывает в любом случае — это
	# обязательно: таблица соответствий fakedns живёт в памяти Xray-core и
	# перезапуска не переживает, поэтому выданные прошлым запуском адреса из
	# пула указывают в никуда. Сбрасывается он сигналом, а не перезапуском:
	# перезапуск делает то же самое ценой девяти секунд без DNS.
	# Попытка не одна, и это не перестраховка. Одиночный вызов проваливался,
	# когда Xray в этот момент ещё поднимался -- тяжёлый конфиг, занятый
	# канал, холодный старт после перезагрузки, -- и туннеля не было до
	# ручного перезапуска. Снаружи это выглядело как «byway иногда просто не
	# работает после перезагрузки»: служба запущена, pid есть, обвязки нет.
	# Цикл уходит в ФОН, и это не украшение. Считая сон между попытками,
	# он держит start до минуты, а start держит restart. Панель ждёт ответа
	# около двадцати секунд и обрывает запрос: кнопка «Перезапустить»
	# отвечала «XHR request timed out» на исправном перезапуске, который в
	# это время спокойно шёл. В фоне start возвращается сразу, а попытки
	# продолжаются -- и остаются в системном журнале.
	(
		read _me _rest < /proc/self/stat 2>/dev/null || _me=""
		for _try in 1 2 3; do
			# Перед повтором -- жив ли ещё этот цикл для службы: stop стирает
			# номер. Перед первой попыткой не сверять -- родитель мог ещё не
			# записать файл.
			if [ "$_try" != 1 ] && [ -n "$_me" ] &&
			   [ "$(cat /var/run/byway-plumb.pid 2>/dev/null)" != "$_me" ]; then
				exit 0
			fi
			if "$BYWAY" plumb on; then
				# ⚠️ Файл убираем ЗДЕСЬ, а не только в stop. Цикл кончается
				# обычно через секунду, а номер лежал в файле до следующей
				# остановки службы -- то есть неделями, и к тому моменту
				# принадлежал уже постороннему процессу.
				#
				# Свой номер берём из /proc/self: $$ в подоболочке -- это
				# номер РОДИТЕЛЯ, не наш. Сверяем перед удалением, иначе
				# затрём чужую запись, если родитель ещё не успел писать.
				if [ -n "$_me" ] &&
				   [ "$(cat /var/run/byway-plumb.pid 2>/dev/null)" = "$_me" ]; then
					rm -f /var/run/byway-plumb.pid 2>/dev/null
				fi
				exit 0
			fi
			[ "$_try" = 3 ] && break
			logger -t byway "правила перехвата не легли с попытки $_try, следующая через паузу"
			sleep 10
		done
		logger -t byway "правила перехвата не легли за три попытки -- туннеля нет, интернет работает напрямую"
	) >/dev/null 2>&1 1000>&- &
	# 1000>&- -- закрыть унаследованный замок procd (procd_lock, flock на
	# дескрипторе 1000). Держа его, цикл не пускал stop и restart дальше
	# procd_lock, пока сам не кончится, -- до 65 с, -- и stop_service
	# находил его уже отработавшим.
	# Номер фоновой подоболочки -- чтобы stop мог её убить. procd о ней не
	# знает: это не его инстанс, а отцепленный процесс, и он живёт до 65
	# секунд. Не убив его, получаем двух хозяев обвязки разом -- цикл
	# поднимает её, пока stop снимает.
	echo $! > /var/run/byway-plumb.pid 2>/dev/null || true

	# Слепок снимаем здесь, а не внутри фона: это запись «с какими настройками
	# служба поднята», а не «удалось ли». Не удалось -- поднимет сторож из
	# `byway watch`, настройки при этом те же самые.
	mark_applied
}

stop_service() {
	# Сперва убить фоновый цикл попыток, потом снимать. Иначе он продолжает
	# поднимать обвязку поверх снятой: замок в cmd_plumb не даст им идти
	# одновременно, но без этого kill порядок вышел бы обратный -- off
	# отработал бы первым, а цикл поднял бы всё назад при уже мёртвом движке.
	_pp=$(cat /var/run/byway-plumb.pid 2>/dev/null || true)
	if [ -n "$_pp" ]; then
		# Сперва сама подоболочка -- чтобы не начала следующую попытку, -- и
		# сразу за ней её дети. ⚠️ В pid-файле лежит номер ПОДОБОЛОЧКИ, а
		# замок держит её внук `byway plumb on`. Убив только её, мы оставляли
		# замок занятым, и следующий за этим `plumb off` уходил ждать
		# тридцать секунд и отказывал, ничего не сняв.
		# ⚠️ И только если номер ВСЁ ЕЩЁ наш. Цикл давно кончился, номер
		# переиспользован ядром, и kill от root уходил в постороннее --
		# на шлюзе это dnsmasq, odhcpd, crond или uhttpd, а следом
		# pgrep -P добивал его детей. Последствие -- от «пропал DNS» до
		# «пропал интернет и панель», причём byway отчитывался об
		# успехе. Вероятность росла с временем непрерывной работы.
		# Найдено четвёртым аудитом, заход 3.
		if tr '\0' ' ' < "/proc/$_pp/cmdline" 2>/dev/null | grep -q byway; then
			# Детей -- ДО kill: умерший родитель отдаёт их init, и pgrep -P
			# после него не находил `byway plumb on`, державший замок.
			_kids=$(pgrep -P "$_pp" 2>/dev/null || true)
			kill "$_pp" 2>/dev/null || true
			for _cp in $_kids; do
				kill "$_cp" 2>/dev/null || true
			done
		fi
		rm -f /var/run/byway-plumb.pid 2>/dev/null || true
	fi
	# --service, а не голый off: эта форма НЕ ставит метку «сняли руками».
	# С меткой выходило так -- служба остановилась, метка легла, у следующего
	# старта все три попытки подъёма провалились, и сторож оказался заперт до
	# перезагрузки ровно тогда, когда он и нужен.
	#
	# --keep-dns добавляется ТОЛЬКО когда следом идёт старт: его ставит
	# restart и ветка reload «конфиг изменился». На настоящей остановке флага
	# нет, и резолвер честно возвращается провайдеру -- иначе дом остался бы
	# смотреть в порт, который никто больше не слушает.
	# При «не пускать мимо VPN» остановка, за которой следует старт (restart,
	# reload с новым конфигом, обновление) или замена ядра (BYWAY_KEEP_BLOCK
	# от byway engine), закрывает дом ДО снятия перехвата и оставляет запрет:
	# прежде на это окно -- секунды, а при замене через память минуту --
	# подсети списка шли напрямую. Снимет запрет удачный plumb on.
	local _kb=""
	if [ "$(uci -q get byway.main.on_failure)" != "open" ] &&
	   { [ "${BYWAY_KEEP_DNS:-0}" = 1 ] || [ "${BYWAY_KEEP_BLOCK:-0}" = 1 ]; }; then
		"$BYWAY" plumb close >/dev/null 2>&1 || true
		_kb=--keep-block
	fi
	if [ "${BYWAY_KEEP_DNS:-0}" = 1 ]; then
		plumb_off_try --keep-dns $_kb
	else
		plumb_off_try $_kb
	fi
}

reload_service() {
	# procd дёргает reload на каждое изменение настроек, о котором ему
	# сообщили (reload_config -- так делает «Сохранить и применить» в панели;
	# голый `uci commit` из консоли службу не трогает, проверено 2026-10-01),
	# -- в том числе когда сменили язык панели или включили сбор статистики. Полный перезапуск на
	# такое рвёт все соединения на пятнадцать секунд, и панель показывает
	# красное на ровном месте: именно так выглядела «смена языка уронила
	# резолвер» 2026-09-04.
	#
	# Поэтому пересобираем конфиг и перезапускаем ТОЛЬКО если он изменился.
	# Сравнение по содержимому, а не по списку «важных» опций: список
	# пришлось бы держать в двух местах сразу и он разъезжался бы с кодом.
	# Живость проверяем через ps с разорванным шаблоном, а НЕ через pgrep -f:
	# pgrep находит сам себя -- его собственная командная строка содержит ту
	# же подстроку, -- и служба всегда выглядела запущенной. Из-за этого
	# включение галочкой не работало вовсе.
	#
	# Сначала выключатель, потом всё остальное. Опция enabled в конфиг Xray не
	# входит, поэтому сверка конфига её не замечала: галочка в панели ничего
	# не включала и не выключала до перезагрузки, а описание рядом обещало
	# обратное.
	if [ "$(uci -q get byway.main.enabled)" = "1" ]; then
		if ! byway_running; then
			logger -t byway "reload: включено -- запуск"
			start
			return 0
		fi
	else
		if byway_running; then
			logger -t byway "reload: выключено -- остановка"
		fi
		# stop -- и при лежащем движке: запрет «Не пускать» и перехват стоят
		# именно тогда, а снять их, кроме stop, некому (pulse и сторож при
		# enabled=0 молчат), и procd в ожидании respawn поднял бы движок.
		# Снимать нечего -- plumb off только сбрасывает кэш dnsmasq.
		stop
		return 0
	fi

	# Ядро сменили опцией xray_bin (руками или из панели): конфиг под новое
	# ядро нередко выходит тем же байт в байт, и по сверке ниже служба
	# оставалась на прежнем процессе. Сверяем запущенный файл с заданным.
	local _xp _xe _xr
	_xp=$(xray_main_pid)
	_xe=$(readlink "/proc/$_xp/exe" 2>/dev/null || true)
	# Предел памяти живёт в окружении процесса, конфиг от него не меняется:
	# без этой сверки reload его не видел, нужен был restart руками.
	local _mlw _mlr
	_mlw=$(xray_memlimit)
	_mlr=$(tr '\0' '\n' < "/proc/$_xp/environ" 2>/dev/null | sed -n 's/^GOMEMLIMIT=//p')
	if [ -n "$_xe" ] && [ "$_mlw" != "$_mlr" ]; then
		logger -t byway "reload: сменился предел памяти, перезапуск"
		_xe=changed
	fi
	# xray_root сменили: от кого движок работает, видно по Uid процесса.
	_xr=$(awk '/^Uid:/ { print ($2 == 0) ? "root" : "user" }' "/proc/$_xp/status" 2>/dev/null)
	if [ -n "$_xe" ] && [ -n "$_xr" ] && { [ "$(uci -q get byway.main.xray_root)" = "1" ] || [ ! -x /sbin/ujail ]; } &&
	   [ "$_xr" = user ]; then
		logger -t byway "reload: движок переводится на root (xray_root), перезапуск"
		_xe=changed
	elif [ -n "$_xe" ] && [ "$_xr" = root ] && [ "$(uci -q get byway.main.xray_root)" != "1" ] && [ -x /sbin/ujail ]; then
		logger -t byway "reload: движок переводится на пользователя byway, перезапуск"
		_xe=changed
	fi
	if [ -n "$_xe" ] && [ "$_xe" != "$(readlink -f "$XRAY" 2>/dev/null)" ]; then
		[ "$_xe" = changed ] || logger -t byway "reload: сменилось ядро, перезапуск"
		BYWAY_KEEP_DNS=1
		stop
		BYWAY_KEEP_DNS=0
		start
		return 0
	fi

	local have_conf have_nft want_conf want_nft
	have_conf=$(sed -n 1p "$STATE" 2>/dev/null)
	have_nft=$(sed -n 2p "$STATE" 2>/dev/null)

	if ! "$BYWAY" gen >/dev/null 2>&1; then
		logger -t byway "reload: конфиг не собрался, работает прежний"
		return 0
	fi
	want_conf=$(md5sum "$CONF" 2>/dev/null | cut -d' ' -f1)
	want_nft=$("$BYWAY" nftsig 2>/dev/null | md5sum | cut -d' ' -f1)

	# Пустой слепок -- значит служба поднята версией до этой правки либо
	# память чистили. Перезапускаем: лишний перезапуск дешевле молчаливого
	# расхождения, и он ровно один -- дальше слепок есть.
	if [ -z "$have_conf" ] || [ "$have_conf" != "$want_conf" ]; then
		logger -t byway "reload: конфиг изменился, перезапуск"
		# Тот же флаг, что и в restart: за stop сразу идёт start, и гонять
		# резолвер туда-обратно незачем. Это самая частая дорога сюда --
		# «Сохранить и применить» в панели.
		BYWAY_KEEP_DNS=1
		stop
		BYWAY_KEEP_DNS=0
		start
		return 0
	fi

	# Часть настроек в конфиг движка не попадает вовсе: список интерфейсов и
	# метка живут только в правилах nft и в ip rule. По одному md5 конфига они
	# всегда выглядели «ничего не изменилось» -- гости добавлены в настройках,
	# в панели галочка стоит, а правило в ядре прежнее, и туннеля у них нет
	# до ручного `byway plumb on`. Перекладываем правила, движок не трогаем:
	# рвать соединения ради смены списка интерфейсов незачем.
	if [ "$have_nft" != "$want_nft" ]; then
		logger -t byway "reload: изменились правила перехвата, перекладка"
		# Слепок -- только после успеха. Стоя безусловно, он записывал
		# ЖЕЛАЕМУЮ обвязку как применённую: следующий reload с теми же
		# настройками уходил на «конфиг не изменился» и правила не
		# перекладывал, хотя в ядре их так и не было.
		if "$BYWAY" plumb on >/dev/null 2>&1; then
			mark_applied
		else
			logger -t byway "reload: правила перехвата не легли -- туннеля нет, интернет работает"
		fi
		return 0
	fi

	logger -t byway "reload: конфиг не изменился, служба не тронута"
}

service_triggers() {
	procd_add_reload_trigger byway
}
